          "source": "async function exploreRepositoryForDecompositionPrompt(params: {}) {\n  const allFiles = await listFiles();\n  \n  // Recherche des termes clés\n  const decompositionMatches = await searchText('decomposition');\n  const promptMatches = await searchText('prompt');\n  const harnessMatches = await searchText('harness');\n  \n  // Fusion des résultats\n  const allMatches = [...decompositionMatches, ...promptMatches, ...harnessMatches];\n  const uniqueFiles = [...new Set(allMatches.map(match => match.file))];\n  \n  // Lire les fichiers uniques pour identifier les définitions\n  const fileContents = await Promise.all(\n    uniqueFiles.slice(0, 10).map(async (file) => {\n      const lines = await readLines(file, 1, 50);\n      return { file, lines };\n    })\n  );\n  \n  return {\n    allFiles: allFiles.slice(0, 20),\n    allMatches: allMatches.slice(0, 50),\n    fileContents\n  };\n}"
