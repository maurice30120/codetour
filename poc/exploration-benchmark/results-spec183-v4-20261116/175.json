          "source": "async function findDecompositionPromptDefinition(params: {}) {\n  // Recherche des fichiers contenant les termes clés\n  const decompositionMatches = await searchText('decomposition');\n  const promptMatches = await searchText('prompt');\n  const harnessMatches = await searchText('harness');\n  \n  // Fusion des résultats\n  const allMatches = [...decompositionMatches, ...promptMatches, ...harnessMatches];\n  \n  // Extraction des fichiers uniques\n  const uniqueFiles = [...new Set(allMatches.map(match => match.file))];\n  \n  // Lecture des lignes autour des occurrences pour identifier les définitions\n  const detailedMatches = await Promise.all(\n    allMatches.slice(0, 20).map(async (match) => {\n      const lines = await readAround(match.file, match.line);\n      return { ...match, context: lines };\n    })\n  );\n  \n  return {\n    uniqueFiles,\n    detailedMatches\n  };\n}"
        },
