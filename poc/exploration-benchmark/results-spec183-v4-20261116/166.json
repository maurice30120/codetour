          "source": "function exploreMemoryRules(params: { questionId: string }) {\n  // Objectif : Explorer les règles de persistance, refus et collision du catalogue mémoire.\n  // Utiliser les primitives pour lister les fichiers et rechercher des termes clés.\n  \n  const files = listFiles();\n  \n  // Rechercher des termes liés aux règles de persistance, refus et collision\n  const persistenceKeywords = [\"persistence\", \"persist\", \"memory\", \"catalogue\", \"store\", \"save\", \"retain\"];\n  const refusalKeywords = [\"refus\", \"reject\", \"deny\", \"block\", \"unusable\", \"invalid\"];\n  const collisionKeywords = [\"collision\", \"conflict\", \"duplicate\", \"overwrite\", \"merge\", \"clash\"];\n  \n  const allKeywords = [...persistenceKeywords, ...refusalKeywords, ...collisionKeywords];\n  \n  // Rechercher les occurrences de ces mots-clés dans les fichiers\n  const keywordMatches: { file: string; line: number; text: string; keyword: string }[] = [];\n  \n  for (const keyword of allKeywords) {\n    const matches = searchText(keyword);\n    keywordMatches.push(...matches.map(match => ({ ...match, keyword })));\n  }\n  \n  // Lister les fichiers pertinents pour une analyse plus approfondie\n  const relevantFiles = [...new Set(keywordMatches.map(match => match.file))];\n  \n  // Lire les lignes autour des correspondances pour comprendre le contexte\n  const contextResults: { file: string; line: number; keyword: string; context: string }[] = [];\n  \n  for (const match of keywordMatches) {\n    const context = readAround(match.file, match.line, 2);\n    contextResults.push({\n      file: match.file,\n      line: match.line,\n      keyword: match.keyword,\n      context: context.lines.join(\"\\n\")\n    });\n  }\n  \n  return {\n    relevantFiles,\n    keywordMatches,\n    contextResults\n  };\n}"
        },
