          "source": "function getMemoryRulesEvidence(params: {}) {\n  const files = listFiles();\n  \n  // Filtrer les fichiers pertinents pour les règles de mémoire\n  const memoryRelatedFiles = files.filter(file => \n    file.includes(\"memory\") || \n    file.includes(\"catalogue\") || \n    file.includes(\"persistence\") || \n    file.includes(\"rule\") || \n    file.includes(\"collision\") || \n    file.includes(\"refusal\")\n  );\n  \n  // Rechercher des termes clés dans tous les fichiers\n  const persistenceMatches = searchText(\"persistence\");\n  const refusalMatches = searchText(\"refus\");\n  const collisionMatches = searchText(\"collision\");\n  \n  return {\n    files: files,\n    memoryRelatedFiles: memoryRelatedFiles,\n    persistenceMatches: persistenceMatches,\n    refusalMatches: refusalMatches,\n    collisionMatches: collisionMatches\n  };\n}"
        },
