{
  "name": "benchmark-runner",
  "version": "1.0.0",
  "description": "Runner for PostgreSQL benchmark - Spec #174 T05",
  "main": "dist/index.js",
  "scripts": {
    "build": "tsc",
    "test": "ts-node ./node_modules/.bin/jest",
    "test:watch": "ts-node ./node_modules/.bin/jest --watch",
    "start": "ts-node src/index.ts",
    "lint": "eslint src/**/*.ts test/**/*.ts",
    "typecheck": "tsc --noEmit"
  },
  "keywords": [
    "benchmark",
    "codetour",
    "vibe",
    "postgresql",
    "spec-174"
  ],
  "author": "spec-174-implementation",
  "license": "MIT",
  "dependencies": {
    "ajv": "^8.12.0",
    "uuid": "^9.0.0"
  },
  "devDependencies": {
    "@types/jest": "^29.5.11",
    "@types/node": "^20.10.5",
    "@types/uuid": "^9.0.7",
    "jest": "^29.7.0",
    "ts-jest": "^29.1.1",
    "typescript": "^5.3.3",
    "ts-node": "^10.9.2",
    "eslint": "^8.55.0",
    "@typescript-eslint/eslint-plugin": "^6.13.2",
    "@typescript-eslint/parser": "^6.13.2"
  }
}
