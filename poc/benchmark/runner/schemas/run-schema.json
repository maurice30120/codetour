{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Benchmark Run Schema",
  "description": "Schema for PostgreSQL benchmark run traces - Spec #174 T05",
  "type": "object",
  "properties": {
    "run_id": {
      "type": "string",
      "format": "uuid",
      "description": "Unique identifier for this run"
    },
    "timestamp": {
      "type": "string",
      "format": "date-time",
      "description": "ISO 8601 timestamp when run started"
    },
    "agent": {
      "type": "string",
      "enum": ["codetour", "vibe-native"],
      "description": "Agent type used for this run"
    },
    "agent_version": {
      "type": "string",
      "description": "Version of the agent"
    },
    "model": {
      "type": "string",
      "description": "LLM model used"
    },
    "model_params": {
      "type": "object",
      "properties": {
        "temperature": {
          "type": "number",
          "minimum": 0,
          "maximum": 2
        },
        "max_tokens": {
          "type": "integer",
          "minimum": 1
        },
        "top_p": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        }
      },
      "required": ["temperature", "max_tokens"]
    },
    "question_id": {
      "type": "string",
      "description": "ID of the question being executed"
    },
    "series": {
      "type": "string",
      "enum": ["R", "T"],
      "description": "Series: R for repetition, T for transfer"
    },
    "phase": {
      "type": "string",
      "enum": ["repetition", "transfer", "priming"],
      "description": "Phase of the benchmark"
    },
    "repeat_index": {
      "type": "integer",
      "minimum": 0,
      "description": "Index of repetition within series"
    },
    "postgres_sha": {
      "type": "string",
      "pattern": "^[a-f0-9]{40}$",
      "description": "SHA of PostgreSQL repository"
    },
    "manifest_hash": {
      "type": "string",
      "description": "Hash of the manifest file"
    },
    "prompt_hash": {
      "type": "string",
      "description": "Hash of the prompt sent"
    },
    "calls": {
      "type": "array",
      "description": "Array of all LLM calls made during execution",
      "items": {
        "type": "object",
        "properties": {
          "call_id": {
            "type": "string",
            "description": "Unique identifier for this call"
          },
          "call_type": {
            "type": "string",
            "enum": [
              "prompt",
              "search",
              "tool",
              "memory_list",
              "memory_run",
              "function_try",
              "consolidation",
              "retry",
              "correction"
            ],
            "description": "Type of call"
          },
          "input_tokens": {
            "type": "integer",
            "minimum": 0,
            "description": "Input tokens for this call"
          },
          "output_tokens": {
            "type": "integer",
            "minimum": 0,
            "description": "Output tokens for this call"
          },
          "duration_ms": {
            "type": "integer",
            "minimum": 0,
            "description": "Duration of call in milliseconds"
          },
          "tool_name": {
            "type": "string",
            "description": "Name of tool called (if applicable)"
          },
          "parameters": {
            "type": "object",
            "description": "Parameters passed to the call",
            "additionalProperties": true
          },
          "result": {
            "type": ["string", "object", "null"],
            "description": "Result of the call"
          },
          "error": {
            "type": ["string", "null"],
            "description": "Error message if call failed"
          },
          "usage_missing": {
            "type": "boolean",
            "description": "True if usage counter is missing"
          }
        },
        "required": ["call_id", "call_type", "input_tokens", "output_tokens"]
      }
    },
    "functions_created": {
      "type": "array",
      "description": "Functions created during the run",
      "items": {
        "type": "object",
        "properties": {
          "function_id": {
            "type": "string",
            "description": "Unique identifier for this function"
          },
          "source": {
            "type": "string",
            "description": "Source code of the function"
          },
          "parameters_schema": {
            "type": "object",
            "description": "Schema of function parameters",
            "additionalProperties": true
          },
          "created_at": {
            "type": "string",
            "format": "date-time",
            "description": "When the function was created"
          },
          "reuse_count": {
            "type": "integer",
            "minimum": 0,
            "description": "How many times this function was reused"
          }
        },
        "required": ["function_id", "source", "created_at"]
      }
    },
    "functions_reused": {
      "type": "array",
      "description": "List of function IDs that were reused",
      "items": {
        "type": "string"
      }
    },
    "total_tokens": {
      "type": "object",
      "description": "Total token usage",
      "properties": {
        "input": {
          "type": "integer",
          "minimum": 0,
          "description": "Total input tokens"
        },
        "output": {
          "type": "integer",
          "minimum": 0,
          "description": "Total output tokens"
        },
        "total": {
          "type": "integer",
          "minimum": 0,
          "description": "Total tokens (input + output)"
        },
        "verified": {
          "type": "boolean",
          "description": "True if token counts are verified"
        }
      },
      "required": ["input", "output", "total", "verified"]
    },
    "result": {
      "type": "object",
      "description": "Result of the run",
      "properties": {
        "tour_title": {
          "type": "string",
          "description": "Title of the generated tour"
        },
        "steps": {
          "type": "array",
          "description": "Steps in the tour",
          "items": {
            "type": "object",
            "properties": {
              "step_id": {
                "type": "string",
                "description": "Unique identifier for this step"
              },
              "description": {
                "type": "string",
                "description": "Description of the step"
              },
              "file": {
                "type": "string",
                "description": "File referenced in this step"
              },
              "line": {
                "type": "integer",
                "description": "Line number in the file"
              },
              "citations": {
                "type": "array",
                "description": "Citations for this step",
                "items": {
                  "type": "string"
                }
              }
            },
            "required": ["step_id", "description"]
          }
        },
        "raw_response": {
          "type": "string",
          "description": "Raw response from the agent"
        },
        "citations": {
          "type": "array",
          "description": "All citations from the response",
          "items": {
            "type": "string"
          }
        }
      }
    },
    "error": {
      "type": ["string", "null"],
      "description": "Error message if run failed"
    },
    "status": {
      "type": "string",
      "enum": ["success", "error", "timeout"],
      "description": "Status of the run"
    }
  },
  "required": [
    "run_id",
    "timestamp",
    "agent",
    "question_id",
    "series",
    "postgres_sha",
    "calls",
    "total_tokens"
  ],
  "additionalProperties": false
}
