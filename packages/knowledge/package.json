{
  "name": "codetour-knowledge",
  "version": "0.1.0",
  "description": "Deterministic Knowledge contract: Markdown entries with SHA-256 evidence proofs, discovery and verified reads",
  "license": "MIT",
  "author": {
    "name": "Microsoft Corporation"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/microsoft/codetour",
    "directory": "packages/knowledge"
  },
  "main": "dist/src/index.js",
  "types": "dist/src/index.d.ts",
  "files": [
    "dist/src",
    "README.md",
    "LICENSE.txt",
    "dist/vendor"
  ],
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json && node scripts/copy-vendor.js",
