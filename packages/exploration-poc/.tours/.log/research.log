 ?? '';\",\"      if (abandonedAttempts.has(attempt)) {\",\"        unreconciled.push({ name: candidateName, proposed: false, replayed: false, accepted: false, reason: 'Marked unusable by memory_unusable during the Tour' });\",\"        continue;\",\"      }\",\"      // Issue #187: a legacy candidate — the pre-#185 `code` protocol, reachable\",\"      // only through a directly injected tool call since the provider offers\",\"      // strict function_try instead of `code` whenever memory is on — can never\",\"      // be consolidated silently: its citations were never validated at trial\",\"      // time and cannot be re-validated deterministically on replay. Only\",\"      // strict function_try candidates may persist; the refusal carries an\",\"      // explicit reason in the reconciliation log.\",\"      if (attempt.candidate.executionMode !== 'strict') {\",\"        unreconciled.push({ name: candidateName, proposed: false, replayed: false, accepted: false, reason: 'Legacy candidate refused: its citations were never validated at trial time and cannot be re-validated deterministically on replay; only strict function_try trials may be consolidated' });\",\"        continue;\",\"      }\",\"      if (!selected.has(candidateName)) {\",\"        unreconciled.push({ name: candidateName, proposed: false, replayed: false, accepted: false, reason: 'Not selected by the model for consolidation' });\",\"        continue;\",\"      }\",\"      // Issue #187 (D04): deterministic reconciliation replay — the exact same\",\"      // code and the exact same params are re-executed, and every citation is\",\"      // re-checked on the replayed output. No second LLM judge decides anything.\",\"      const remaining = limits.durationMs - (Date.now() - startedMs);\",\"      if (remaining <= 0) {\",\"        unreconciled.push({ name: candidateName, proposed: true, replayed: false, accepted: false, reason: 'Budget exhausted before the reconciliation replay' });\",\"        continue;\",\"      }\",\"      const verificationStarted = new Date();\",\"      let replay: ConsolidationCandidate['replay'];\",\"      try {\",\"        const { runScript } = await import('codetour-exploration-sandbox');\",\"        const rerun = await runScript({ workspace: root, code: attempt.candidate.code, params: attempt.params, strict: true, includeTrace: true, timeoutMs: Math.min(5000, remaining) });\",\"        // Every citation is re-checked exactly as it was checked at trial time:\",\"        // every candidate reaching this replay is a strict function_try trial\",\"        // whose output carries mandatory references validated by the #185\",\"        // validator, and the replay re-runs that same exhaustive check. Legacy\",\"        // candidates are refused above, before any replay.\",\"        const citations = await validateCitations(rerun.value, { access: citationAccess(tools), revision: await resolveRevision() });\",\"        recordCall({ type: 'function_try', name: 'consolidation-validation', inputTokens: null, outputTokens: null, usageMissing: false, execution: rerun.trace, result: citations?.status === 'validation_failed' ? citationRepairFeedback(citations).validation : citations, outcome: `reexecuted${citationOutcome(citations)}` }, verificationStarted, new Date());\",\"        if (JSON.stringify(rerun.value) !== JSON.stringify(attempt.output)) {\",\"          replay = { ok: false, reason: 'the re-execution did not reproduce the exact original output with the same code and params', citations: citations?.status };\",\"        } else if (citations?.status === 'validation_failed') {\",\"          replay = { ok: false, reason: `citation re-validation failed on the replayed output: ${citations.invalidReferences.length} of ${citations.references} references invalid`, citations: citations.status };\",\"        } else {\",\"          replay = { ok: true, citations: citations?.status };\",\"        }\",\"      } catch (error) {\",\"        recordCall({ type: 'function_try', name: 'consolidation-validation', inputTokens: null, outputTokens: null, usageMissing: false, error: String(error) }, verificationStarted, new Date());\",\"        replay = { ok: false, reason: `the re-execution failed: ${String((error as Error)?.message ?? error).slice(0, 200)}` };\",\"      }\",\"\",\"      // Consolidation trigger (correction 3): a concrete operational signal —\",\"      // execution status success + structural proof availability + contract\",\"      // respected. NEVER a blind benchmark judge. Partial/failed Tours never\",\"      // reach this point (consolidation only runs for a complete structured\",\"      // result), and traces recorded mid-run never mutate the catalogue.\",\"      const structuralProof = looksLikeEvidence(attempt.output) || matches(attempt.output);\",\"      const contractRespected = attempt.proofValid !== false;\",\"      candidates.push({\",\"        objective: attempt.candidate.objective,\",\"        description: attempt.candidate.description,\",\"        name: attempt.candidate.name ?? '',\",\"        returns: attempt.candidate.returns,\",\"        code: attempt.candidate.code,\",\"        parameters: attempt.candidate.parameters,\",\"        paramsSchema: attempt.candidate.paramsSchema,\",\"        executionMode: attempt.candidate.executionMode,\",\"        // Only retain candidates whose output contributed to the final evidence.\",\"        verified: matches(attempt.output),\",\"        consolidationSignal: { executedSuccessfully: true, proofAvailable: structuralProof, contractRespected },\",\"        replay,\",\"        revision: attempt.candidate.revision\",\"      });\",\"    }\",\"    const report = await library.finish(successful.flatMap(a => a.id ? [a.id] : []), candidates);\",\"    // The reconciliation log distinguishes proposed, replayed, accepted and\",\"    // rejected with a reason — including candidates the model never selected\",\"    // or that could not be replayed (issues #187 and #194).\",\"    report.reconciliation.push(...unreconciled);\",\"    consolidationReport = report;\",\"  } else if (library) {\",\"    // Persist observed failures even when the exploration is partial; never\",\"    // consolidate new candidates from a result without evidence.\",\"    const partialReport = await library.finish([], []);\",\"    // Issue #188 (D05): proposals that never executed stay visible in the\",\"    // reconciliation log even when the Tour itself is not validated.\",\"    partialReport.reconciliation.push(...unreconciled);\",\"    consolidationReport = partialReport;\",\"  }\",\"  metrics.durationMs = Date.now() - startedMs;\",\"  const stopReason = state.stopReason ?? (plan.status !== 'recorded' ? 'planning_failed' : null);\",\"  const status = state.result === undefined || stopReason ? 'partial' as const : 'complete' as const;\",\"  recordRunEnd(status, stopReason);\"]},\"returned\":1,\"observed\":null,\"truncated\":false,\"bounds\":{\"maxItems\":50,\"maxBytes\":8000},\"bytes\":7170,\"revision\":\"3e8f2aa7da11dd6d26bbb6e3dffde679471c9780\",\"provenance\":\"unverified\",\"uncertainty\":[\"No primitive-derived evidence is verified for this output; relations remain unverified.\"]}},{\"name\":\"readCliTsFull\",\"question\":\"Read src/cli.ts to understand how runs are initiated and how runId is passed to the logger\",\"description\":\"Reads all 78 lines of src/cli.ts to extract how the CLI initiates an exploration, generates or receives a runId, and passes it to the logger via explore() and researchLog().\",\"paramsSchema\":[],\"returns\":\"{ file: string; start: number; lines: string[]; }\",\"code\":\"function readFileSection(file: string, start: number, end: number): {file: string, start: number, lines: string[]} { return readLines(file, start, end); } readFileSection('src/cli.ts', 1, 78)\",\"output\":{\"result\":{\"file\":\"src/cli.ts\",\"start\":1,\"lines\":[\"#!/usr/bin/env node\",\"import { join, resolve } from 'node:path';\",\"import { access, realpath, stat, writeFile } from 'node:fs/promises';\",\"import { constants } from 'node:fs';\",\"import { explore } from './explore.ts';\",\"import { mistral } from './mistral.ts';\",\"import { PROMPT_SHA256 } from './decomposition-prompt.ts';\",\"import type { Budget, Model } from './explore.ts';\",\"\",\"let model: Model | undefined;\",\"let outputFile: string | undefined;\",\"const emit = async (value: unknown) => {\",\"  const json = `${JSON.stringify(value, null, 2)}\\\\n`;\",\"  if (outputFile) await writeFile(outputFile, json);\",\"  else process.stdout.write(json);\",\"};\",\"try {\",\"const args = process.argv.slice(2);\",\"let codeMode = false;\",\"let memoryEnabled = false;\",\"let legacyMemory: string | undefined;\",\"let workspacePath: string | undefined;\",\"const budget: Budget = {};\",\"const positive = (value: string | undefined): number => {\",\"  const number = Number(value);\",\"  if (!Number.isFinite(number) || number <= 0) throw new Error('Budgets must be positive numbers');\",\"  return number;\",\"};\",\"if (process.env.CODETOUR_TOKEN_BUDGET) budget.tokens = positive(process.env.CODETOUR_TOKEN_BUDGET);\",\"if (process.env.CODETOUR_TIME_BUDGET_MS) budget.durationMs = positive(process.env.CODETOUR_TIME_BUDGET_MS);\",\"let temperature = process.env.MISTRAL_TEMPERATURE === undefined ? 0 : Number(process.env.MISTRAL_TEMPERATURE);\",\"while (args[0]?.startsWith('--')) {\",\"  const option = args.shift();\",\"  if (option === '--code') codeMode = true;\",\"  else if (option === '--memory') {\",\"    memoryEnabled = true;\",\"    // Retain the previous directory argument when it is visibly a path.\",\"    if (args[0] && (args[0].startsWith('/') || args[0].startsWith('./') || args[0].startsWith('../'))) legacyMemory = args.shift();\",\"  }\",\"  else if ((option === '--workspace' || option === '--root') && args[0]) workspacePath = args.shift();\",\"  else if (option === '--output-file' && args[0] && !args[0].startsWith('--')) outputFile = args.shift();\",\"  else if (option === '--tokens' || option === '--token-budget') budget.tokens = positive(args.shift());\",\"  else if (option === '--duration-ms' || option === '--time-budget-ms') budget.durationMs = positive(args.shift());\",\"  else if (option === '--iterations') budget.iterations = positive(args.shift());\",\"  else if (option === '--calls') budget.calls = positive(args.shift());\",\"  else if (option === '--temperature' && args[0] !== undefined) temperature = Number(args.shift());\",\"  else throw new Error('Unknown or incomplete option');\",\"}\",\"if (!args.length) throw new Error('Usage: codetour-research [--workspace <directory>] [--code] [--memory] [--output-file <path>] [--tokens <n>] [--duration-ms <n>] <question>');\",\"// Preserve the old positional workspace form when the first argument is an existing directory.\",\"if (!workspacePath && args.length > 1) {\",\"  try { if ((await stat(resolve(args[0]))).isDirectory()) workspacePath = args.shift(); } catch { /* question, not a directory */ }\",\"}\",\"const requestedRoot = resolve(workspacePath ?? process.cwd());\",\"const root = await realpath(requestedRoot);\",\"if (!(await stat(root)).isDirectory()) throw new Error('Workspace must be a single project directory; select a root explicitly for multi-root workspaces');\",\"await access(root, constants.R_OK | constants.W_OK | constants.X_OK);\",\"const objective = args.join(' ').trim();\",\"if (!objective) throw new Error('A research question is required');\",\"const canonicalMemory = join(root, '.tours', '.memory');\",\"if (legacyMemory && resolve(legacyMemory) !== canonicalMemory) throw new Error(`Memory must be stored at ${canonicalMemory}`);\",\"const memory = memoryEnabled ? { directory: canonicalMemory } : undefined;\",\"if (!Number.isFinite(temperature) || temperature < 0 || temperature > 1) throw new Error('Temperature must be between 0 and 1');\",\"model = mistral(process.env.MISTRAL_API_KEY ?? '', process.env.MISTRAL_MODEL, { temperature });\",\"if (codeMode) {\",\"  // Exercise the real sandbox before starting a model run, including QuickJS and TypeScript.\",\"  const { runScript } = await import('codetour-exploration-sandbox');\",\"  try { await runScript({ workspace: root, code: '() => 1', params: {}, strict: true, timeoutMs: 5000 }); }\",\"  catch (error) { throw new Error(`Sandbox preflight failed: ${(error as Error).message}`); }\",\"}\",\"const result = await explore({ root, objective, codeMode, memory, budget, model });\",\"await emit(result);\",\"} catch (error) {\",\"  const failure = ((error as any).exploration) ?? { status: 'failed', error: String((error as Error).message ?? error).slice(0, 500), promptSha256: PROMPT_SHA256, modelConfig: model?.snapshot?.(), metrics: { modelCalls: 0, toolCalls: 0, inputTokens: 0, outputTokens: 0, usageAvailable: false }, callTrace: [] };\",\"  try { await emit(failure); }\",\"  catch (writeError) { process.stderr.write(`Unable to write output file: ${(writeError as Error).message}\\\\n`); }\",\"  process.exitCode = 1;\",\"}\"]},\"returned\":1,\"observed\":null,\"truncated\":false,\"bounds\":{\"maxItems\":50,\"maxBytes\":8000},\"bytes\":5024,\"revision\":\"3e8f2aa7da11dd6d26bbb6e3dffde679471c9780\",\"provenance\":\"unverified\",\"uncertainty\":[\"No primitive-derived evidence is verified for this output; relations remain unverified.\"]}}]}"}],"options":{"maxOutputTokens":16384,"codeMode":false,"memory":false,"toolsEnabled":false}}
