ms', citations: citations?.status };\",\"        } else if (citations?.status === 'validation_failed') {\",\"          replay = { ok: false, reason: `citation re-validation failed on the replayed output: ${citations.invalidReferences.length} of ${citations.references} references invalid`, citations: citations.status };\",\"        } else {\",\"          replay = { ok: true, citations: citations?.status };\",\"        }\",\"      } catch (error) {\",\"        recordCall({ type: 'function_try', name: 'consolidation-validation', inputTokens: null, outputTokens: null, usageMissing: false, error: String(error) }, verificationStarted, new Date());\",\"        replay = { ok: false, reason: `the re-execution failed: ${String((error as Error)?.message ?? error).slice(0, 200)}` };\",\"      }\",\"\",\"      // Consolidation trigger (correction 3): a concrete operational signal —\",\"      // execution status success + structural proof availability + contract\",\"      // respected. NEVER a blind benchmark judge. Partial/failed Tours never\",\"      // reach this point (consolidation only runs for a complete structured\",\"      // result), and traces recorded mid-run never mutate the catalogue.\",\"      const structuralProof = looksLikeEvidence(attempt.output) || matches(attempt.output);\",\"      const contractRespected = attempt.proofValid !== false;\",\"      candidates.push({\",\"        objective: attempt.candidate.objective,\",\"        description: attempt.candidate.description,\",\"        name: attempt.candidate.name ?? '',\",\"        returns: attempt.candidate.returns,\",\"        code: attempt.candidate.code,\",\"        parameters: attempt.candidate.parameters,\",\"        paramsSchema: attempt.candidate.paramsSchema,\",\"        executionMode: attempt.candidate.executionMode,\",\"        // Only retain candidates whose output contributed to the final evidence.\",\"        verified: matches(attempt.output),\",\"        consolidationSignal: { executedSuccessfully