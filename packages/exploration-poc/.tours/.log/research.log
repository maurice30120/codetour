didate is kept\",\" * only with a non-empty, length-bounded English description stating what the\",\" * procedure does, its scope, its result shape and its key limits. No LLM judges\",\" * the text: empty and oversized\",\" * descriptions are refused outright, while the English rule is a practable\",\" * heuristic screen (see ENGLISH_FUNCTION_WORDS) — a description passing it\",\" * is screened, not proven English.\",\" */\",\"export function validateDescription(description: string): { ok: boolean; reason?: string } {\",\"  const trimmed = typeof description === 'string' ? description.trim() : '';\",\"  if (!trimmed) return { ok: false, reason: 'Description is mandatory: state what the procedure does, its scope, the shape of its result and its key limits.' };\",\"  if (trimmed.includes('*/')) return { ok: false, reason: 'Description cannot contain a JSDoc comment terminator.' };\",\"  if (trimmed.length > MAX_DESCRIPTION_LENGTH) return { ok: false, reason: `Description is too long: ${trimmed.length} characters; at most ${MAX_DESCRIPTION_LENGTH} are allowed.` };\",\"  if (/[^\\\\x20-\\\\x7E]/.test(trimmed)) return { ok: false, reason: 'Description must be written in English: non-ASCII (e.g. accented) characters are not accepted.' };\",\"  const words = trimmed.toLowerCase().match(/[a-z']+/g) ?? [];\",\"  if (!words.some(word => ENGLISH_FUNCTION_WORDS.has(word))) return { ok: false, reason: 'Description must be written in English: no common English word was found in the text.' };\",\"  return { ok: true };\",\"}\",\"\",\"const digest = (s: string) => createHash('sha256').update(s).digest('hex');\",\"\",\"/** Accept any usable TypeScript identifier; its meaning belongs in the documentation. */\",\"export function validateCanonicalName(name: string): { ok: boolean; reason?: string } {\",\"  if (!/^[$_\\\\p{ID_Start}][$_\\\\u200c\\\\u200d\\\\p{ID_Continue}]*$/u.test(name) || new Set(['break','case','catch','class','const','continue','debugger','default','delete','do','else','export','extends','finally','for','function','if','import','in','instanceof','let','new','return','super','switch','this','throw','try','typeof','var','void','while','with','yield','enum','await','implements','interface','package','private','protected','public','static']).has(name)) return { ok: false, reason: 'Name must be a valid TypeScript identifier' };\",\"  return { ok: true };\",\"}\",\"\",\"/**\",\" * Dedup on question + scope + contract — never on the name alone.\",\" * No embeddings, no classifier: only normalized exact comparisons. When the\",\" * comparison cannot be decided, the outcome is 'indeterminate' and BOTH\",\" * entries are kept (never an invented equivalence).\",\" */\",\"export function compareCandidates(candidate: { objective: string; description: string; returns?: string }, entry: { objective: string; description: string; outputContract?: { returns: string } }): ComparisonOutcome {\",\"  const norm = (s: string) => s.toLowerCase().replace(/\\\\s+/g, ' ').trim();\",\"  const sameQuestion = norm(candidate.objective) === norm(entry.objective);\",\"  const sameScope = norm(candidate.description) === norm(entry.description);\",\"  if (!sameQuestion || !sameScope) return 'distinct';\",\"  // Same question + same scope: the contract decides.\",\"  const candidateContract = candidate.returns ? norm(candidate.returns) : undefined;\",\"  const entryContract = entry.outputContract?.returns ? norm(entry.outputContract.returns) : undefined;\",\"  if (candidateContract && entryContract) return candidateContract === entryContract ? 'duplicate' : 'distinct';\",\"  // Missing contract information on either side: comparison is indeterminate.\",\"  return 'indeterminate';\",\"}\",\"\",\"/** Local experimental store. The file name derives from the real repository path. */\",\"export async function scriptMemory(root: string, directory: string) {\",\"  const repo = await realpath(root);\",\"  const targetDirectory = resolve(directory);\",\"  const relativeDirectory = relative(repo, targetDirectory);\",\"  const insideWorkspace = relativeDirectory !== '..' && !relativeDirectory.startsWith(`..${sep}`) && !isAbsolute(relativeDirectory);\",\"  const ensureDirectory = async (path: string) => {\",\"    try {\",\"      const info = await lstat(path);\",\"      if (info.isSymbolicLink() || !info.isDirectory()) throw new Error(`Unsafe memory directory: ${path}`);\",\"    } catch (error: any) {\",\"      if (error?.code !== 'ENOENT') throw error;\",\"      await mkdir(path);\",\"    }\",\"  };\",\"  if (insideWorkspace) {\",\"    let current = repo;\",\"    for (const part of relativeDirectory.split(sep).filter(Boolean)) {\",\"      current = join(current, part);\",\"      await ensureDirectory(current);\",\"    }\",\"  } else {\",\"    await mkdir(targetDirectory, { recursive: true });\",\"    await ensureDirectory(targetDirectory);\",\"  }\",\"  const rejectSymlink = async (path: string) => {\",\"    try { if ((await lstat(path)).isSymbolicLink()) throw new Error(`Unsafe memory file: ${path}`); }\",\"    catch (error: any) { if (error?.code !== 'ENOENT') throw error; }\",\"  };\",\"  const file = join(directory, `${digest(repo)}.json`);\",\"  await rejectSymlink(file);\",\"  let entries: Entry[];\",\"  try { entries = z.array(entrySchema).parse(JSON.parse(await readFile(file, 'utf8'))); }\"]},\"returned\":1,\"observed\":null,\"truncated\":false,\"bounds\":{\"maxItems\":50,\"maxBytes\":8000},\"bytes\":6657,\"revision\":\"3e8f2aa7da11dd6d26bbb6e3dffde679471c9780\",\"provenance\":\"primitive-derived\",\"uncertainty\":[\"Primitive matches provide syntactic evidence, not semantic certainty or proof of absence.\"]}"},{"role":"assistant","tool_calls":[{"id":"YQGR0Vnmp","type":"function","function":{"name":"function_try","arguments":"{\"source\":\"readLines(\\\"src/citation-validator.ts\\\", 201, 300)\",\"params\":{},\"name\":\"read_citation_validator_rest\",\"question\":\"What are the remaining parts of src/citation-validator.ts, in