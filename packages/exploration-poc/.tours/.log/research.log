n}\",\"output\":{\"result\":[\"src/memory-output.ts\",\"src/memory.ts\"],\"returned\":2,\"observed\":2,\"truncated\":false,\"bounds\":{\"maxItems\":50,\"maxBytes\":8000},\"bytes\":40,\"revision\":\"3e8f2aa7da11dd6d26bbb6e3dffde679471c9780\",\"provenance\":\"unverified\",\"uncertainty\":[\"No primitive-derived evidence is verified for this output; relations remain unverified.\"]}},{\"name\":\"find_memory_run_references\",\"question\":\"Find all references to memory_run in the codebase to understand its usage and parameters\",\"description\":\"Searches the entire codebase for any occurrence of 'memory_run' to identify how it is called and what parameters it expects\",\"paramsSchema\":[],\"returns\":\"{ file: string; line: number; context: string; }[]\",\"code\":\"function findMemoryRunReferences(): { file: string; line: number; context: string }[] {\\n  // Search for memory_run function calls or definitions\\n  const matches = searchText('memory_run');\\n  return matches.map(m => ({ file: m.file, line: m.line, context: m.text.trim() }));\\n}\",\"output\":{\"result\":[{\"file\":\"dist/decomposition-prompt.js\",\"line\":3,\"context\":\"export const DECOMPOSITION_PROMPT = 'Investigate the supplied technical question. Treat the initial research plan as a flexible guide: follow new evidence freely without revising or tracking the plan. When memory is enabled, consult memory_list for useful capabilities and run matching procedures with memory_run, verify their evidence, and investigate only what is missing. In Code Mode with memory, use function_try to explore via the provided primitives and propose useful parameterized procedures. Do not recreate equivalent procedures or nest memorized procedures. Do not write a Tour. Return sourced findings and explicit uncertainties.';\"},{\"file\":\"dist/explore.js\",\"line\":277,\"context\":\"else if (codeMode && ((call.name === 'code' && typeof call.arguments.code === 'string') || (call.name === 'function_try' && typeof call.arguments.source === 'string') || (library && call.name === 'memory_run' && typeof call.arguments.id === 'string'))) {\"},{\"file\":\"dist/explore.js\",\"line\":278,\"context\":\"const stored = call.name === 'memory_run' ? library?.get(String(call.arguments.id)) : undefined;\"},{\"file\":\"dist/explore.js\",\"line\":279,\"context\":\"if (call.name === 'memory_run' && !stored)\"},{\"file\":\"dist/explore.js\",\"line\":291,\"context\":\"scriptCall = { type: stored ? 'memory_run' : 'function_try', name: stored ? stored.id : 'function_try' };\"},{\"file\":\"dist/explore.js\",\"line\":292,\"context\":\"// Ticket #191: any memory_run/function_try call — accepted or failed —\"},{\"file\":\"dist/explore.js\",\"line\":312,\"context\":\"// Compact, structured, bounded, sourced output for memory_run AND function_try.\"},{\"file\":\"dist/explore.js\",\"line\":364,\"context\":\"recordCall({ type: scriptCall?.type ?? 'function_try', name: call.name === 'memory_run' ? String(call.arguments.id ?? call.name) : 'function_try', callId: call.id, questionId, parameters: stored ? { id: stored.id, params } : undefined, inputTokens: null, outputTokens: null, usageMissing: false, error: String(error) }, runStarted, new Date());\"},{\"file\":\"dist/explore.js\",\"line\":388,\"context\":\": call.name === 'memory_run' ? { id: call.arguments.id, params: call.arguments.params }\"},{\"file\":\"dist/explore.js\",\"line\":423,\"context\":\"const memoryInstructions = library ? ` Script memory is enabled. memory_list(query) returns the catalogue WITHOUT function source code: id (TypeScript identifier), objective (canonical question), description (scope), typed params, output contract, limits and uncertainty cases. Available entries: ${JSON.stringify(library.catalog())}. If a listed function can help, call memory_run with its id and suitable params, verify its proofs, and complete only what is missing. Wrapping obligation: the ten permanent primitives (listFiles, searchText, searchIdentifiers, readLines, readA