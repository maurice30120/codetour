didate is kept\",\" * only with a non-empty, length-bounded English description stating what the\",\" * procedure does, its scope, its result shape and its key limits. No LLM judges\",\" * the text: empty and oversized\",\" * descriptions are refused outright, while the English rule is a practable\",\" * heuristic screen (see ENGLISH_FUNCTION_WORDS) — a description passing it\",\" * is screened, not proven English.\",\" */\",\"export function validateDescription(description: string): { ok: boolean; reason?: string } {\",\"  const trimmed = typeof description === 'string' ? description.trim() : '';\",\"  if (!trimmed) return { ok: false, reason: 'Description is mandatory: state what the procedure does, its scope, the shape of its result and its key limits.' };\",\"  if (trimmed.includes('*/')) return { ok: false, reason: 'Description cannot contain a JSDoc comment terminator.' };\",\"  if (trimmed.length > MAX_DESCRIPTION_LENGTH) return { ok: false, reason: `Description is too long: ${trimmed.length} characters; at most ${MAX_DESCRIPTION_LENGTH} are allowed.` };\",\"  if (/[^\\\\x20-\\\\x7E]/.test(trimmed)) return { ok: false, reason: 'Description must be written in English: non-ASCII (e.g. accented) characters are not accepted.' };\",\"  const words = trimmed.toLowerCase().match(/[a-z']+/g) ?? [];\",\"  if (!words.some(word => ENGLISH_FUNCTION_WORDS.has(word))) return { ok: false, reason: 'Description must be written in English: no common English word was found in the text.' };\",\"  return { ok: true };\",\"}\",\"\",\"const digest = (s: string) => createHash('sha256').update(s).digest('hex');\",\"\",\"/** Accept any usable TypeScript identifier; its meaning belongs in the documentation. */\",\"export function validateCanonicalName(name: string): { ok: boolean; reason?: string } {\",\"  if (!/^[$_\\\\p{ID_Start}][$_\\\\u200c\\\\u200d\\\\p{ID_Continue}]*$/u.test(name) || new Set(['break','case','catch','class','const','continue','debugger','default','delete','do','el