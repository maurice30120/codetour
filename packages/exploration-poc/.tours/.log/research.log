e() }),","});","","const uncertaintyCaseShape = z.object({","  // Concrete case in which the output must not be trusted blindly.","  case: z.string().min(1).max(200),","  // Explicit signal the caller receives in that case.","  signal: z.string().min(1).max(200),","});","","const entrySchema = z.object({","  id: z.string().min(1),","  objective: z.string().max(500),","  description: z.string().max(300),","  code: z.string().max(32768),","  parameters: z.array(z.string()).max(30),","  paramsSchema: z.array(paramSchemaShape).max(30).default([]),","  outputContract: outputContractShape.optional(),","  limits: z.object({ maxItems: z.number().int().positive().default(50), maxBytes: z.number().int().positive().default(8000) }).optional(),","  uncertaintyCases: z.array(uncertaintyCaseShape).max(10).default([]),","  revision: z.string().max(64).optional(),","  successes: z.number().int().nonnegative().optional(),","  failures: z.number().int().nonnegative().optional(),","  // G0 requirement: NO inactivity tracking or purge","  fingerprint: z.string().optional(),","  version: z.number().int().nonnegative().optional(),","  replacedBy: z.string().optional(),","  variantOf: z.string().optional(),","  validated: z.boolean().optional(),","  executionMode: z.enum(['strict', 'legacy']).optional(),","  referenceCases: z.array(z.object({ params: z.record(z.string(), z.unknown()), ok: z.boolean(), at: z.string() })).max(5).optional()","}).passthrough();","type Entry = z.infer<typeof entrySchema>;","","/** Outcome of a catalogue comparison. 'indeterminate' is reported honestly instead of inventing equivalence. */","export type ComparisonOutcome = 'duplicate' | 'distinct' | 'indeterminate';","","export interface ReferenceCase { params: Record<string, unknown>; ok: boolean; at: string }","","/** Deterministic replay evidence (issue #187): the exact same code and params were re-executed and every citation re-checked. */","export interface ReplayEvidence {","  ok: boolean;","  reason?: string;","  citations?: 'valid' | 'no_references' | 'validation_failed';","}","","/** Issue #187: per-candidate reconciliation log — proposed / replayed / accepted / rejected with reason. */","export interface ReconciliationOutcome {","  name: string;","  /** True when the model proposed (selected) the candidate for consolidation. */","  proposed: boolean;","  /** True when the deterministic reconciliation re-executed the exact code and params with all citations re-checked. */","  replayed: boolean;","  accepted: boolean;","  reason?: string;","}","","export interface ConsolidationCandidate {","  objective: string;","  description: string;","  code: string;","  parameters: string[];","  paramsSchema?: Array<{ name: string; type: string }>;","  executionMode?: 'strict' | 'legacy';","  /** TypeScript identifier used as the catalogue key. */","  name: string;","  /** Output contract declared with the candidate. */","  returns?: string;","  uncertaintyCases?: Array<{ case: string; signal: string }>;","  verified: boolean;","  /** Concrete operational consolidation signal (correction 3): never a blind benchmark judge. */","  consolidationSignal?: { executedSuccessfully: boolean; proofAvailable: boolean; contractRespected: boolean };","  /** Deterministic replay evidence (issue #187): required — no replay, no persistence. */","  replay?: ReplayEvidence;","  version?: number;","  variantOf?: string;","  revision?: string;","}",""]},"errors":[],"proofs":[],"revision":"","durationMs":88,"validation":{"typeChecking":{"valid":true,"errors":[]},"primitiveWhitelist":{"valid":true,"violations":[]},"reExecutionVerified":false,"documentation":{"status":"passed","timestamp":"2026-11-17T10:27:45.996Z","checks":{"typeChecking":true,"primitiveWhitelist":true,"callTracing":true,"reExecution":false},"notes":["Local technical validation only","No claims of semantic validation","No claims of exhaustiveness"]}},"contract":{"paramsSchema":[],"returns":"ReadResult"},"source":"readLines(\"src/mem