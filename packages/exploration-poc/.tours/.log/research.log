confined file path plus an exact line range. */\",\"export interface Reference {\",\"  file: string;\",\"  startLine: number;\",\"  endLine: number;\",\"}\",\"\",\"export interface InvalidCitation extends Partial<Reference> {\",\"  /** Short, structured, actionable error strings (type + path/line detail). */\",\"  errors: string[];\",\"}\",\"\",\"export interface CitationValidation {\",\"  /** 'valid' only when every emitted reference was verified; a failed trial is never treated as validated. */\",\"  status: 'valid' | 'validation_failed' | 'no_references';\",\"  /** Total mandatory references found in the output. */\",\"  references: number;\",\"  /** References actually verified (bounded by the safety ceiling). */\",\"  validated: number;\",\"  validCount: number;\",\"  /** Bounded list of the valid references (diagnostic visibility). */\",\"  validReferences: Reference[];\",\"  /** Bounded list of only the faulty references, for repair. */\",\"  invalidReferences: InvalidCitation[];\",\"  /** False when the ceiling stopped validation: the output is then NOT proven exhaustive. */\",\"  exhaustive: boolean;\",\"}\",\"\",\"/** Safety ceiling: at most this many references are verified per trial (configurable). */\",\"const MAX_REFERENCES = 300;\",\"/** Citation spans must fit a single confined read (workspace MAX_READ_LINES). */\",\"const MAX_SPAN_LINES = 100;\",\"/** Bounded diagnostic lists. */\",\"const MAX_LISTED = 10;\",\"/** Per-line excerpt truncation bounds of the permanent primitives (searchText/readLines: 2000, searchIdentifiers/findDefinitions: 500). */\",\"const EXCERPT_PREFIX_BOUNDS = [500, 2000];\",\"/** Fields that carry the reference's own excerpt — never recursed into as nested references. */\",\"const EXCERPT_KEYS = ['text', 'excerpt', 'lineText', 'lines'];\",\"\",\"/** Recursively collect every file-bearing object: those are the mandatory references. */\",\"function collectReferences(value: unknown, out: Record<string, unknown>[]): Record<string, 