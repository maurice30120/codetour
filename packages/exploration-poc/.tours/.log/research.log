olute, join, relative, resolve, sep } from 'node:path';","import { z } from 'zod';","","// ============================================================================","// Catalogue entry model (issue #174 complement)","// ============================================================================","","const paramSchemaShape = z.object({","  name: z.string().min(1),","  type: z.string().min(1).max(200).default('unknown'),","  description: z.string().max(200).optional(),","});","","const outputContractShape = z.object({","  // Human-readable description of the returned shape, e.g. \"SearchMatch[] {file, line, text}\".","  returns: z.string().min(1).max(300),","  // Structural fields expected on each item (proof contract).","  itemFields: z.array(z.string()).max(20).default([]),","  // Bounds the output honours.","  bounds: z.object({ maxItems: z.number().int().positive(), maxBytes: z.number().int().positive() }),","});","","const uncertaintyCaseShape = z.object({","  // Concrete case in which the output must not be trusted blindly.","  case: z.string().min(1).max(200),","  // Explicit signal the caller receives in that case.","  signal: z.string().min(1).max(200),","});","","const entrySchema = z.object({","  id: z.string().min(1),","  objective: z.string().max(500),","  description: z.string().max(300),","  code: z.string().max(32768),","  parameters: z.array(z.string()).max(30),","  paramsSchema: z.array(paramSchemaShape).max(30).default([]),","  outputContract: outputContractShape.optional(),","  limits: z.object({ maxItems: z.number().int().positive().default(50), maxBytes: z.number().int().positive().default(8000) }).optional(),","  uncertaintyCases: z.array(uncertaintyCaseShape).max(10).default([]),","  revision: z.string().max(64).optional(),","  successes: z.number().int().nonnegative().optional(),","  failures: z.number().int().nonnegative().optional(),","  // G0 requirement: NO inactivity tracking or purge","  fingerprint: z.string().optional(),","  version: z.number().int().nonnegative().optional(),","  replacedBy: z.string().optional(),","  variantOf: z.string().optional(),","  validated: z.boolean().optional(),","  executionMode: z.enum(['strict', 'legacy']).optional(),","  referenceCases: z.array(z.object({ params: z.record(z.string(), z.unknown()), ok: z.boolean(), at: z.string() })).max(5).optional()","}).passthrough();","type Entry = z.infer<typeof entrySchema>;","","/** Outcome of a catalogue comparison. 'indeterminate' is reported honestly instead of inventing equivalence. */","export type ComparisonOutcome = 'duplicate' | 'distinct' | 'indeterminate';","","export interface ReferenceCase { params: Record<string, unknown>; ok: boolean; at: string }","","/** Deterministic replay evidence (issue #187): the exact same code and params were re-executed and every citation re-checked. */","export interface ReplayEvidence {","  ok: boolean;","  reason?: string;","  citations?: 'valid' | 'no_references' | 'validation_failed';","}","","/** Issue #187: per-candidate reconciliation log — proposed / replayed / accepted / rejected with reason. */","export interface ReconciliationOutcome {","  name: string;","  /** True when the model proposed (selected) the candidate for consolidation. */","  proposed: boolean;","  /** True when the deterministic reconciliation re-executed the exact code and params with all citations re-checked. */","  replayed: boolean;","  accepted: boolean;","  reason?: string;","}","","export interface ConsolidationCandidate {","  objective: string;","  description: string;","  code: string;","  parameters: string[];","  paramsSchema?: Array<{ name: string; type: string }>;","  executionMode?: 'strict' | 'legacy';","  /** TypeScript identifier used as the catalogue key. */","  name: string;","  /** Output contract declared with the candidate. */","  returns?: string;","  uncertaintyCases?: Array<{ case: string; signal: string }>;","  verified: boolean;","  /** Concrete operational consolidation signal (correction 3): never a blind benchmark judge. */","  consolidationSignal?: { executedSuccessfully: boolean; proofAvailable: boolean; contractRespected: boolean };","  /** Deterministic replay evidence (issue #187): required — no replay, no persistence. */","  replay?: ReplayEvidence;","  version?: number;","  variantOf?: string;","  revision?: string;","}",""]},"errors":[],"proofs":[],"revision":"","durationMs":86,"validation":{"typeChecking":{"valid":true,"errors":[]},"primitiveWhitelist":{"valid":true,"violations":[]},"reExecutionVerified":false,"documentation":{"status":"passed","timestamp":"2026-11-17T10:28:43.105Z","checks":{"typeChecking":true,"primitiveWhitelist":true,"callTracing":true,"reExecution":false},"notes":["Local technical validation only","No claims of semantic validation","No claims of exhaustiveness"]}},"contract":{"paramsSchema":[],"returns":"ReadResult"},"source":"readLines(\"src/memory.ts\", 1, 100)"},"result":{"status":"valid","references":1,"validated":1,"validCount":1,"validReferences":[{"file":"src/memory.ts","startLine":1,"endLine":100}],"invalidReferences":[],"exhaustive":true},"outcome":"reexecuted; citations=1 valid","runId":"959373e8-0a35-4020-971d-f721574890fe","seq":92,"startedAt":"2026-11-17T10:28:42.897Z","endedAt":"2026-11-17T10:28:43.138Z","durationMs":241},{"type":"function_try","name":"consolidation-validation","inputTokens":null,"outputTokens":null,"usageMissing":false,"execution":{"version":"2.0","identifier":"cfdafe3b0b4a62a02c50e90bec1e488c2e464cd489382df7d82c3082d80eba4e","fingerprint":"cfdafe3b0b4a62a02c50e90bec1e488c2e464cd489382df7d82c3082d80eba4e","parameters":{},"executedCalls":[{"name":"readLines","params":["src/memory.ts",101,200]}],"results":{"file":"src/memory.ts","start":101,"lines":["export interface ConsolidationReport {","  accepted: string[];","  rejected: Array<{ name: string; reason: string }>;","  duplicates: string[];","  indeterminate: string[];","  /** Issue #187: one entry per candidate that reached the deterministic validator. */","  reconciliation: ReconciliationOutcome[];","}","","/** Maximum stored description length (matches the entry schema bound). */","const MAX_DESCRIPTION_LENGTH = 300;","","/**"," * Practable English screen — not proof of English: non-ASCII is refused"," * outright, and an accepted description must contain at least one common"," * English function word. A passing text is screened, never proven English"," * (spec #183: a heuristic language detector is never sold as infallible)."," */","const ENGLISH_FUNCTION_WORDS = new Set(['the', 'a', 'an', 'and', 'or', 'of', 'for', 'with', 'from', 'to', 'in', 'on', 'by', 'is', 'are', 'be', 'been', 'was', 'were', 'has', 'have', 'had', 'does', 'do', 'did', 'returns', 'return', 'returning', 'given', 'when', 'each', 'its', 'this', 'that', 'which', 'not', 'into', 'over', 'under', 'out', 'as', 'at', 'than', 'then', 'can', 'will', 'would', 'should', 'may', 'must', 'never', 'always', 'per', 'via', 'using', 'use', 'uses', 'used', 'searches', 'search', 'finds', 'find', 'reads', 'read', 'lists', 'list', 'counts', 'count', 'reports', 'report']);","","/**"," * Deterministic description validation (issue #187, D04): a candidate is kept"," * only with a non-empty, length-bounded English description stating what the"," * procedure does, its scope, its result shape and its key limits. No LLM judges"," * the text: empty and oversized"," * descriptions are refused outright, while the English rule is a practable"," * heuristic screen (see ENGLISH_FUNCTION_WORDS) — a description passing it"," * is screened, not proven English."," */","export function validateDescription(description: string): { ok: boolean; reason?: string } {","  const trimmed = typeof description === 'string' ? description.trim() : '';","  if (!trimmed) return { ok: false, reason: 'Description is mandatory: state what the procedure does, its scope, the shape of its result and its key limits.' };","  if (trimmed.includes('*/')) return { ok: false, reason: 'Description cannot contain a JSDoc comment terminator.' };","  if (trimmed.length > MAX_DESCRIPTION_LENGTH) return { ok: false, reason: `Description is too long: ${trimmed.length} characters; at most ${MAX_DESCRIPTION_LENGTH} are allowed.` };","  if (/[^\\x20-\\x7E]/.test(trimmed)) return { ok: false, reason: 'Description must be written in English: non-ASCII (e.g. accented) characters are not accepted.' };","  const words = trimmed.toLowerCase().match(/[a-z']+/g) ?? [];","  if (!words.some(word => ENGLISH_FUNCTION_WORDS.has(word))) return { ok: false, reason: 'Description must be written in English: no common English word was found in the text.' };","  return { ok: true };","}","","const digest = (s: string) => createHash('sha256').update(s).digest('hex');","","/** Accept any usable TypeScript identifier; its meaning belongs in the documentation. */","export function validateCanonicalName(name: string): { ok: boolean; reason?: string } {","  if (!/^[$_\\p{ID_Start}][$_\\u200c\\u200d\\p{ID_Continue}]*$/u.test(name) || new Set(['break','case','catch','class','const','continue','debugger','default','delete','do','else','export','extends','finally','for','function','if','import','in','instanceof','let','new','return','super','switch','this','throw','try','typeof','var','void','while','with','yield','enum','await','implements','interface','package','private','protected','public','static']).has(name)) return { ok: false, reason: 'Name must be a valid TypeScript identifier' };","  return { ok: true };","}","","/**"," * Dedup on question + scope + contract — never on the name alone."," * No embeddings, no classifier: only normalized exact comparisons. When the"," * comparison cannot be decided, the outcome is 'indeterminate' and BOTH"," * entries are kept (never an invented equivalence)."," */","export function compareCandidates(candidate: { objective: string; description: string; returns?: string }, entry: { objective: string; description: string; outputContract?: { returns: string } }): ComparisonOutcome {","  const norm = (s: string) => s.toLowerCase().replace(/\\s+/g, ' ').trim();","  const sameQuestion = norm(candidate.objective) === norm(entry.objective);","  const sameScope = norm(candidate.description) === norm(entry.description);","  if (!sameQuestion || !sameScope) return 'distinct';","  // Same question + same scope: the contract decides.","  const candidateContract = candidate.returns ? norm(candidate.returns) : undefined;","  const entryContract = entry.outputContract?.returns ? norm(entry.outputContract.returns) : undefined;","  if (candidateContract && entryContract) return candidateContract === entryContract ? 'duplicate' : 'distinct';","  // Missing contract information on either side: comparison is indeterminate.","  return 'indeterminate';","}","","/** Local experimental store. The file name derives from the real repository path. */","export async function scriptMemory(root: string, directory: string) {","  const repo = await realpath(root);","  const targetDirectory = resolve(directory);","  const relativeDirectory = relative(repo, targetDirectory);","  const insideWorkspace = relativeDirectory !== '..' && !relativeDirectory.startsWith(`..${sep}`) && !isAbsolute(relativeDirectory);","  const ensureDirectory = async (path: string) => {","    try {","      const info = await lstat(path);","      if (info.isSymbolicLink() || !info.isDirectory()) throw new Error(`Unsafe memory directory: ${path}`);","    } catch (error: any) {","      if (error?.code !== 'ENOENT') throw error;","      await mkdir(path);","    }","  };","  if (insideWorkspace) {","    let current = repo;","    for (const part of relativeDirectory.split(sep).filter(Boolean)) {","      current = join(current, part);","      await ensureDirectory(current);","    }","  } else {","    await mkdir(targetDirectory, { recursive: true });","    await ensureDirectory(targetDirectory);","  }","  const rejectSymlink = async (path: string) => {","    try { if ((await lstat(path)).isSymbolicLink()) throw new Error(`Unsafe memory file: ${path}`); }","    catch (error: any) { if (error?.code !== 'ENOENT') throw error; }","  };","  const file = join(directory, `${digest(repo)}.json`);","  await rejectSymlink(file);","  let entries: Entry[];","  try { entries = z.array(entrySchema).parse(JSON.parse(await readFile(file, 'utf8'))); }"]},"errors":[],"proofs":[],"revision":"","durationMs":91,"validation":{"typeChecking":{"valid":true,"errors":[]},"primitiveWhitelist":{"valid":true,"violations":[]},"reExecutionVerified":false,"documentation":{"status":"passed","timestamp":"2026-11-17T10:28:43.349Z","checks":{"typeChecking":true,"primitiveWhitelist":true,"callTracing":true,"reExecution":false},"notes":["Local technical validation only","No claims of semantic validation","No claims of exhaustiveness"]}},"contract":{"paramsSchema":[],"returns":"ReadResult"},"source":"readLines(\"src/memory.ts\", 101, 200)"},"result":{"status":"valid","references":1,"validated":1,"validCount":1,"validReferences":[{"file":"src/memory.ts","startLine":101,"endLine":200}],"invalidReferences":[],"exhaustive":true},"outcome":"reexecuted; citations=1 valid","runId":"959373e8-0a35-4020-971d-f721574890fe","seq":93,"startedAt":"2026-11-17T10:28:43.138Z","endedAt":"2026-11-17T10:28:43.381Z","durationMs":243},{"type":"function_try","name":"consolidation-validation","inputTokens":null,"outputTokens":null,"usageMissing":false,"execution":{"version":"2.0","identifier":"3d8478a87fa169b45e3452f3ad033a1828ff3f2cce6fffe74b82609d340576e7","fingerprint":"3d8478a87fa169b45e3452f3ad033a1828ff3f2cce6fffe74b82609d340576e7","parameters":{},"executedCalls":[{"name":"searchText","params":["export function runScript"]}],"results":[{"file":"src/sandbox.d.ts","line":2,"text":"  export function runScript(options: { workspace: string; code: string; params?: object; timeoutMs?: number; signal?: AbortSignal; scripts?: Record<string, string>; strict?: boolean; includeTrace?: boolean }): 