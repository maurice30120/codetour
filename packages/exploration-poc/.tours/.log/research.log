d: InvalidCitation };\",\"\",\"/** Check one emitted reference against the actual workspace and return it verified or faulty. */\",\"async function checkReference(reference: Record<string, unknown>, options: { access: CitationAccess; revision?: string }): Promise<ReferenceCheck> {\",\"  const file = reference.file as string;\",\"  const errors: string[] = [];\",\"  const fault: InvalidCitation = { file, errors };\",\"  if (!file) errors.push('file is empty');\",\"  const start = reference.line ?? reference.startLine ?? reference.start;\",\"  if (start === undefined) {\",\"    errors.push('no line number: expected line, startLine or start to be a positive integer');\",\"    return { invalid: fault };\",\"  }\",\"  if (typeof start !== 'number' || !Number.isInteger(start) || start < 1) {\",\"    errors.push(`line must be a positive integer, got ${String(start)}`);\",\"    if (typeof start === 'number') fault.startLine = start;\",\"    return { invalid: fault };\",\"  }\",\"  fault.startLine = start;\",\"  const linesExcerpt = Array.isArray(reference.lines) && reference.lines.every(line => typeof line === 'string') ? (reference.lines as string[]) : undefined;\",\"  const end = reference.endLine ?? (linesExcerpt ? start + linesExcerpt.length - 1 : start);\",\"  if (typeof end !== 'number' || !Number.isInteger(end)) {\",\"    errors.push(`endLine must be an integer, got ${String(end)}`);\",\"    return { invalid: fault };\",\"  }\",\"  fault.endLine = end;\",\"  if (end < start) {\",\"    errors.push(`inverted range: startLine ${start} is greater than endLine ${end}`);\",\"    return { invalid: fault };\",\"  }\",\"  if (end - start + 1 > MAX_SPAN_LINES) {\",\"    errors.push(`range spans ${end - start + 1} lines; citations are limited to ${MAX_SPAN_LINES} lines`);\",\"    return { invalid: fault };\",\"  }\",\"  const claimed = reference.revision;\",\"  if (typeof claimed === 'string' && claimed && options.revision && options.revision !== 'unknown-revision' && !options.revision.startsWith(claimed.slice(0, 12))) {\",\"    errors.push(`reference revision ${claimed.slice(0, 12)} does not match the workspace revision ${options.revision.slice(0, 12)}`);\",\"  }\",\"  let read: { lines: string[]; totalLines: number };\",\"  try {\",\"    read = await options.access.readRange(file, start, end);\",\"  } catch (error) {\",\"    errors.push(String((error as Error)?.message ?? error).slice(0, 200));\",\"    return { invalid: fault };\",\"  }\",\"  if (end > read.totalLines) {\",\"    errors.push(`endLine ${end} is beyond the end of the file (${read.totalLines} lines)`);\",\"    return { invalid: fault };\",\"  }\",\"  if (linesExcerpt) {\",\"    if (linesExcerpt.length !== end - start + 1) errors.push(`excerpt covers ${linesExcerpt.length} lines but the range spans ${end - start + 1}`);\",\"    else linesExcerpt.forEach((excerpt, index) => {\",\"      if (!excerptMatches(read.lines[index], excerpt)) errors.push(`excerpt at line ${start + index} does not match the file content`);\",\"    });\",\"  }\",\"  const textExcerpt = typeof reference.text === 'string' ? reference.text : typeof reference.excerpt === 'string' ? reference.excerpt : typeof reference.lineText === 'string' ? reference.lineText : undefined;\",\"  if (textExcerpt !== undefined && !excerptMatches(read.lines.join('\\\\n'), textExcerpt)) {\",\"    errors.push(`excerpt does not match the file content at lines ${start}-${end}`);\",\"  }\",\"  return errors.length > 0 ? { invalid: fault } : { valid: { file, startLine: start, endLine: end } };\",\"}\",\"\",\"/** Exact equality, or a prefix at one of the primitives' documented per-line truncation bounds. */\",\"function excerptMatches(actual: string, excerpt: string): boolean {\",\"  return actual === excerpt || (EXCERPT_PREFIX_BOUNDS.includes(excerpt.length) && actual.startsWith(excerpt));\",\"}\",\"\",\"/**\",\" * Short, structured, actionable repair feedback for the model: an error line\",\" * plus the valid references (visibility