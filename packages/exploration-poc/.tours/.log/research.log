tartLine: number, endLine: number): Promise<{ lines: string[]; totalLines: number }>;","}","","/** A single source reference: confined file path plus an exact line range. */","export interface Reference {","  file: string;","  startLine: number;","  endLine: number;","}","","export interface InvalidCitation extends Partial<Reference> {","  /** Short, structured, actionable error strings (type + path/line detail). */","  errors: string[];","}","","export interface CitationValidation {","  /** 'valid' only when every emitted reference was verified; a failed trial is never treated as validated. */","  status: 'valid' | 'validation_failed' | 'no_references';","  /** Total mandatory references found in the output. */","  references: number;","  /** References actually verified (bounded by the safety ceiling). */","  validated: number;","  validCount: number;","  /** Bounded list of the valid references (diagnostic visibility). */","  validReferences: Reference[];","  /** Bounded list of only the faulty references, for repair. */","  invalidReferences: InvalidCitation[];","  /** False when the ceiling stopped validation: the output is then NOT proven exhaustive. */","  exhaustive: boolean;","}","","/** Safety ceiling: at most this many references are verified per trial (configurable). */","const MAX_REFERENCES = 300;","/** Citation spans must fit a single confined read (workspace MAX_READ_LINES). */","const MAX_SPAN_LINES = 100;","/** Bounded diagnostic lists. */","const MAX_LISTED = 10;","/** Per-line excerpt truncation bounds of the permanent primitives (searchText/readLines: 2000, searchIdentifiers/findDefinitions: 500). */","const EXCERPT_PREFIX_BOUNDS = [500, 2000];","/** Fields that carry the reference's own excerpt — never recursed into as nested references. */","const EXCERPT_KEYS = ['text', 'excerpt', 'lineText', 'lines'];","","/** Recursively collect every file-bearing object: those are the mandatory references. */","function collectReferences(value: unknown, out: Record<string, unknown>[]): Record<string, unknown>[] {","  if (!value || typeof value !== 'object') return out;","  if (Array.isArray(value)) {","    for (const child of value) collectReferences(child, out);","    return out;","  }","  const record = value as Record<string, unknown>;","  if (typeof record.file === 'string') out.push(record);","  for (const [key, child] of Object.entries(record)) {","    if (!EXCERPT_KEYS.includes(key)) collectReferences(child, out);","  }","  return out;","}","","export async function validateCitations(value: unknown, options: { access: CitationAccess; revision?: string; maxReferences?: number }): Promise<CitationValidation> {","  const references = collectReferences(value, []);","  if (references.length === 0) {","    return { status: 'no_references', references: 0, validated: 0, validCount: 0, validReferences: [], invalidReferences: [], exhaustive: true };","  }","  const ceiling = options.maxReferences ?? MAX_REFERENCES;","  const invalid: InvalidCitation[] = [];","  const valid: Reference[] = [];","  let validated = 0;","  for (const reference of references) {","    if (validated >= ceiling) break;","    validated++;","    const check = await checkReference(reference, options);","    if (check.invalid) invalid.push(check.invalid);","    else valid.push(check.valid);","  }","  const exhaustive = validated === references.length;","  if (!exhaustive) {","    invalid.push({ errors: [`${references.length} references emitted; only ${validated} validated — the output is NOT proven exhaustive. Narrow the function output to at most ${ceiling} references and retry.`] });","  }","  return {","    status: invalid.length > 0 ? 'validation_failed' : 'valid',","    references: references.length,","    validated,","    validCount: valid.length,"]},"errors":[],"proofs":[],"revision":"","durationMs":76,"validation":{"typeChecking":{"valid":true,"errors":[]},"primitiveWhitelist":{"valid":true,"violations":[]},"reExecutionVerified":false,"documentation":{"status":"passed","timestamp":"2026-11-17T10:26:55.783Z","checks":{"typeChecking":true,"primitiveWhitelist":true,"callTracing":true,"reExecution":false},"notes":["Local technical validation only","No claims of semantic validation","No claims of exhaustiveness"]}},"contract":{"paramsSchema":[],"returns":"ReadResult"},"source":"readLines(\"src/citation-validator.ts\", 1, 100)"},"outcome":"returned=1; citations=1 valid","runId":"959373e8-0a35-4020-971d-f721574890fe","seq":6,"startedAt":"2026-11-17T10:26:55.584Z","endedAt":"2026-11-17T10:26:55.813Z","durationMs":229}}
