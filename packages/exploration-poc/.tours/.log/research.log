s\":{\"maxItems\":50,\"maxBytes\":8000},\"bytes\":425,\"revision\":\"3e8f2aa7da11dd6d26bbb6e3dffde679471c9780\",\"provenance\":\"unverified\",\"uncertainty\":[\"No primitive-derived evidence is verified for this output; relations remain unverified.\"]}},{\"name\":\"read_tool_contract_short\",\"question\":\"What does src/tool-contract.ts define as the contract for tools, including runScript, strict function, and timeout constraints?\",\"description\":\"Reads the first 17 lines of src/tool-contract.ts to extract interfaces, constraints, and validation mechanisms imposed on tools\",\"paramsSchema\":[],\"returns\":\"ReadResult\",\"code\":\"readLines(\\\"src/tool-contract.ts\\\", 1, 17)\",\"output\":{\"result\":{\"file\":\"src/tool-contract.ts\",\"start\":1,\"lines\":[\"const string = { type: 'string' };\",\"const integer = { type: 'integer' };\",\"\",\"export const primitiveTools = [\",\"  { name: 'listFiles', description: 'List repository paths', properties: { maxFiles: integer } },\",\"  { name: 'searchText', description: 'Find literal text; syntax does not prove a semantic relationship', properties: { query: string }, required: ['query'] },\",\"  { name: 'searchIdentifiers', description: 'Find exact identifier occurrences', properties: { identifier: string }, required: ['identifier'] },\",\"  { name: 'readLines', description: 'Read at most 100 numbered source lines', properties: { file: string, startLine: integer, endLine: integer }, required: ['file', 'startLine', 'endLine'] },\",\"  { name: 'readAround', description: 'Read context around a source line', properties: { file: string, line: integer, contextLines: integer }, required: ['file', 'line'] },\",\"  { name: 'listSymbols', description: 'List syntactic symbol candidates', properties: {} },\",\"  { name: 'findDefinitions', description: 'Find candidate definitions; no semantic resolution guarantee', properties: { symbol: string }, required: ['symbol'] },\",\"  { name: 'findReferences', description: 'Find candidate references; no semantic resolution guarantee', properties: { symbol: string }, required: ['symbol'] },\",\"  { name: 'getImports', description: 'Find declared import candidates', properties: { file: string }, required: ['file'] },\",\"  { name: 'getGitDiff', description: 'Read a bounded diff between validated revisions', properties: { revision1: string, revision2: string }, required: ['revision1'] }\",\"].map(tool => ({ type: 'function', function: { name: tool.name, description: tool.description, parameters: { type: 'object', properties: tool.properties, required: tool.required ?? [] } } }));\",\"\",\"export const primitiveNames = new Set(primitiveTools.map(tool => tool.function.name));\"]},\"returned\":1,\"observed\":null,\"truncated\":false,\"bounds\":{\"maxItems\":50,\"maxBytes\":8000},\"bytes\":1943,\"revision\":\"3e8f2aa7da11dd6d26bbb6e3dffde679471c9780\",\"provenance\":\"unverified\",\"uncertainty\":[\"No primitive-derived evidence is verified for this output; relations remain unverified.\"]}},{\"name\":\"search_runscript\",\"question\":\"Find all occurrences of runScript in the workspace to understand the tool contract and its constraints\",\"description\":\"Searches for the term runScript across all files to identify its definition, usage, and constraints\",\"paramsSchema\":[],\"returns\":\"SourceMatch[]\",\"code\":\"searchText(\\\"runScript\\\")\",\"output\":{\"result\":[{\"file\":\".tours/memoire-procedurale-mcp.tour\",\"line\":46,\"text\":\"      \\\"description\\\": \\\"C'est le point de capture. En mode mémoire, les dix primitives permanentes (`listFiles`, `searchText`, `readLines`, …) ne sont **pas** exposées comme outils directs : le modèle doit les emballer dans une fonction TypeScript unique et l'essayer avec `function_try(source, params)`. Cette contrainte d'emballage, énoncée dans les instructions système (`memoryInstructions`), fait qu'une candidate est d'emblée une procédure paramétrable et réutilisable, pas un appel brut.\\\\n\\\\nL'essai est exécuté par la vraie sandbox (`runScript`, mode `strict`, timeout borné), et tracé via `scriptCall = { type: 'memory_run' | 'function_try' }`. Toute fonction_try **réussie** devient automatiquement candidate à la consolidation — plus aucun flag `remember` à positionner (ticket #194). Un essai qui échoue (sandbox ou citations) est tracé, jamais proposé ; un nom absent est dérivé de la question par `derivedCandidateName` (src/exploration-helpers.ts).\\\",\"},{\"file\":\".tours/memoire-procedurale-mcp.tour\",\"line\":92,\"text\":\"      \\\"pattern\\\": \\\"const rerun = await runScript\\\"\"},{\"file\":\"benchmarks/query-probe.mjs\",\"line\":5,\"text\":\"import { runScript } from 'codetour-exploration-sandbox';\"},{\"file\":\"benchmarks/query-probe.mjs\",\"line\":21,\"text\":\"      try { samples.push(await runScript({ workspace: root, code, params: { query }, timeoutMs: Math.min(3000, remaining) })); }\"},{\"file\":\"dist/cli.js\",\"line\":89,\"text\":\"        const { runScript } = await import('codetour-exploration-sandbox');\"},{\"file\":\"dist/cli.js\",\"line\":91,\"text\":\"            await runScript({ workspace: root, code: '() => 1', params: {}, strict: true, timeoutMs: 5000 });\"},{\"file\":\"dist/explore.js\",\"line\":221,\"text\":\"                        const { runScript } = await import('codetour-exploration-sandbox');\"},{\"file\":\"dist/explore.js\",\"line\":231,\"text\":\"                        const execution = await runScript({ workspace: root, code: expressions[call.name], params, strict: true, includeTrace: true, timeoutMs: Math.min(5000, Math.max(1, limits.durationMs - (Date.now() - startedMs))) });\"},{\"file\":\"dist/explore.js\",\"line\":288,\"text\":\"                        const { runScript } = await import('codetour-exploration-sandbox');\"},{\"file\":\"dist/explore.js\",\"line\":309,\"text\":\"                            const execution = await runScript({ workspace: root, code, params, scripts: strict ? undefined : library?.sources(),