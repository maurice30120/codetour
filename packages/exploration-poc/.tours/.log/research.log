: { contextLines: 5 }, getGitDiff: { revision2: 'HEAD' } };\",\"          const params = { ...(defaults[call.name as keyof typeof defaults] ?? {}), ...args };\",\"          const execution = await runScript({ workspace: root, code: expressions[call.name], params, strict: true, includeTrace: true, timeoutMs: Math.min(5000, Math.max(1, limits.durationMs - (Date.now() - startedMs))) });\",\"          let value = execution.value;\",\"          // Direct model-facing reads show absolute line numbers. The sandbox\",\"          // primitive contract used by procedures keeps its original string[].\",\"          if ((call.name === 'readLines' || call.name === 'readAround') && value && typeof value === 'object') {\",\"            const read = value as { file: string; start: number; lines: string[] };\",\"            value = { ...read, lines: read.lines.map((text, index) => ({ line: read.start + index, text })) };\",\"          }\",\"          output = boundedOutput(value, { revision: await resolveRevision(), sourceTruncated: execution.trace.truncated, primitiveDerived: true });\",\"        }\",\"        else if (call.name === 'list') output = await tools.list();\",\"        else if (call.name === 'search' && typeof call.arguments.query === 'string') output = await tools.search(call.arguments.query);\",\"        else if (call.name === 'read' && typeof call.arguments.file === 'string') {\",\"          const start = Number(call.arguments.startLine ?? 1);\",\"          output = await tools.read(call.arguments.file, start, Number(call.arguments.endLine ?? start + 99));\",\"        }\",\"        else if (call.name === 'git') output = await tools.git(limits.durationMs - (Date.now() - startedMs));\",\"        else if (library && call.name === 'memory_list') {\",\"          const listed = library.memory_list(typeof call.arguments.query === 'string' ? call.arguments.query : undefined);\",\"          const available = listed.length === 0 ? library.catalog() : [];\",\"          if (listed.length === 0 && available.length > 0) {\",\"            output = { results: [], available, note: 'No entries match the exact query. The catalogue is not empty; inspect the available entries or retry with a shorter literal query.' };\",\"          } else if (listed.length === 0 && ++emptyMemoryListCount >= 2 && !emptyMemoryListNoteEmitted) {\",\"            emptyMemoryListNoteEmitted = true;\",\"            output = { results: [], note: 'The catalogue is empty again. Revising the plan in a loop will not fill it: if the question you are serving is durably reusable and no permanent primitive covers it, build the missing capability once with function_try(source, params) instead of revising the plan again; otherwise state why not in the final result.' };\",\"          } else {\",\"            output = listed;\",\"          }\",\"        }\",\"        else if (library && call.name === 'memory_unusable' && typeof call.arguments.id === 'string') {\",\"          const id = call.arguments.id;\",\"          // Issue #187: a proposed candidate may also be abandoned by name —\",\"          // a candidate marked unusable never reaches the catalogue.\",\"          if (!attempts.some(a => a.id === id || a.candidate?.name === id)) throw new Error('Script must have been executed in this run');\",\"          unusableIds.add(id);\",\"          for (const previous of attempts) if (previous.candidate?.name === id) abandonedAttempts.add(previous);\",\"          output = { recordedAfterValidation: true };\",\"        }\",\"        else if (codeMode && ((call.name === 'code' && typeof call.arguments.code === 'string') || (call.name === 'function_try' && typeof call.arguments.source === 'string') || (library && call.name === 'memory_run' && typeof call.arguments.id === 'string'))) {\",\"          const stored = call.name === 'memory_run' ? library?.get(String(call.arguments.id)) : undefined;\",\"          if (call.name === 'memory_run' && !stored) throw new Error('Unknown script');\",\"   