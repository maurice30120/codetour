ance":"unverified","uncertainty":["No primitive-derived evidence is verified for this output; relations remain unverified."]}},{"name":"list_files_exploration","question":"List all files in the workspace to identify exploration sandbox files","description":"Returns the list of files in the current workspace to help identify exploration sandbox source files","paramsSchema":[],"returns":"string[]","code":"listFiles()","output":{"result":[".npmrc",".tours/.memory/8bbdd70ec3d478897e7fa877e6b7a0636f9efa28734ee963a1426d6094b40887.json",".tours/.memory/functions/find_memory_run_references.ts",".tours/.memory/functions/search_tours_memory_path.ts",".tours/memoire-procedurale-mcp.tour","benchmarks/query-probe.mjs","dist/citation-validator.js","dist/cli.js","dist/decomposition-prompt.js","dist/exploration-evidence.js","dist/exploration-helpers.js","dist/explore.js","dist/memory-output.js","dist/memory.js","dist/mistral.js","dist/primitives.js","dist/research-log.js","dist/tool-contract.js","dist/workspace.js","package-lock.json","package.json","README.md","skills/codetour-research/SKILL.md","src/citation-validator.ts","src/cli.ts","src/decomposition-prompt.ts","src/exploration-evidence.ts","src/exploration-helpers.ts","src/explore.ts","src/memory-output.ts","src/memory.ts","src/mistral.ts","src/primitives.ts","src/research-log.ts","src/sandbox.d.ts","src/tool-contract.ts","src/workspace.ts","test/citation-repair.test.ts","test/citation-validator.test.ts","test/cli.test.ts","test/consolidation-d04.test.ts","test/consolidation.test.ts","test/empty-memory-list-note.test.ts","test/explore.test.ts","test/final-answer-fence-whitespace.test.ts","test/final-answer-json-recovery.test.ts","test/final-answer-recovery-visibility.test.ts","test/finish-t02.test.ts","test/fixture-explore.ts","test/internal-instructions-english.test.ts"],"returned":50,"observed":62,"truncated":true,"bounds":{"maxItems":50,"maxBytes":8000},"bytes":1404,"revision":"3e8f2aa7da11dd6d26bbb6e3dffde679471c9780","provenance":"unverified","uncertainty":["No primitive-derived evidence is verified for this output; relations remain unverified.","Output truncated to 50 items / 8000 bytes; it is NOT exhaustive. Re-run with narrower params to see the remainder."]}},{"name":"read_explore_ts","question":"How does the harness execute tools and control their execution via sandboxing and strict mode?","description":"Reads src/explore.ts to understand how runScript is called, how strict mode and timeouts are enforced, and how outputs are validated","paramsSchema":[],"returns":"ReadResult","code":"readLines(\"src/explore.ts\", 1, 100)","output":{"result":{"file":"src/explore.ts","start":1,"lines":["import { Annotation, END, START, StateGraph } from '@langchain/langgraph';","import { createEvidenceTracker, resultSchema } from './exploration-evidence.ts';","import { workspace } from './workspace.ts';","import { scriptMemory } from './memory.ts';","import type { ConsolidationCandidate, ReconciliationOutcome } from './memory.ts';","import { boundedOutput, looksLikeEvidence, sampleEvidenceRefs } from './memory-output.ts';","import { citationAccess, citationRepairFeedback, validateCitations } from './citation-validator.ts';","import { DECOMPOSITION_PROMPT, PROMPT_SHA256, PROMPT_VERSION } from './decomposition-prompt.ts';","import { primitiveNames } from './tool-contract.ts';","import { derivedCandidateName, citationOutcome, summarizeOutcome } from './exploration-helpers.ts';","import type { Model, Budget, PlanRecord, CallTraceItem } from './exploration-helpers.ts';","import { researchLog } from './research-log.ts';","import type { Logger } from 'pino';","export type { Model, Budget, PlanRecord, CallTraceItem, ToolCall } from './exploration-helpers.ts';","","export { DECOMPOSITION_PROMPT, PROMPT_SHA256, PROMPT_VERSION };","","const State = Annotation.Root({ messages: Annotation<any[]>({ reducer: (a, b) => a.concat(b), default: () => [] }), result: Annotation<any>, stopReason: Annotation<string> });","","","interface Attempt {","  id?: string;","  candidate?: { objective: string; description: string; name?: string; returns?: string; code: string; parameters: string[]; paramsSchema?: Array<{ name: string; type: string }>; executionMode?: 'strict' | 'legacy'; revision?: string };","  params?: Record<string, unknown>;","  output: unknown;","  /** Issue #194: the trial output was truncated (sandbox cap or bounding) — flagged, never presented as exhaustive. */","  truncated?: boolean;","  proofValid?: boolean;","  proofSignature?: string[];","}","","/** An exploration returns validated references, never Tour prose. */","export async function explore({ root, objective, model, budget = {}, codeMode = false, memory }: { root: string; objective: string; model: Model; budget?: Budget; codeMode?: boolean; memory?: { directory: string } }) {","  if (memory && !codeMode) throw new Error('Script memory requires Code Mode');","  const limits = { iterations: budget.iterations ?? 100, calls: budget.calls ?? 400, tokens: budget.tokens ?? 1000000, durationMs: budget.durationMs ?? 900000 };","  if (Object.values(limits).some(n => !Number.isFinite(n) || n <= 0)) throw new Error('Budgets must be positive');","  const startedMs = Date.now();","  const runId = crypto.randomUUID();","  let plan: PlanRecord = { status: 'missing', runId };","  const metrics = { inputTokens: 0, outputTokens: 0, usageAvailable: true, modelCalls: 0, toolCalls: 0, durationMs: 0, outputBytes: 0, cost: null as number | null, memoryReuses: 0, memoryPurges: 0, memoryQueryRejects: 0, memoryResultsCompacted: 0, memoryResultsRepeated: 0, autoAttachedEvidence: 0, selectionSkip: null as string | null };","  const callTrace: CallTraceItem[] = [];","  let callSeq = 0;","  let logger: Logger | undefined;","  let requestedEvidenceRecovery = false;","  let requestedJsonRecovery = false;","  let nextOutputLimit = 16384;","  let requestedSchemaRecovery = false;","  // Ticket #190: on the 2026-11-16 run the model called memory_list six times","  // with returned=0 and revised its plan seven times without ever reaching","  // function_try — it treats an empty catalogue as a dead end instead of a","  // creation trigger. After two empty memory_list results in the same run, the","  // tool result itself carries a visible note inviting function_try for","  // durably reusable questions (once per run, traced, no extra LLM call).","  let emptyMemoryListCount = 0;","  let emptyMemoryListNoteEmitted = false;","  const recordCall = (base: Omit<CallTraceItem, 'seq' | 'runId' | 'startedAt' | 'endedAt' | 'durationMs'>, startedAt: Date, endedAt: Date): void => {","    const entry = { ...base, runId, seq: callSeq++, startedAt: startedAt.toISOString(), endedAt: endedAt.toISOString(), durationMs: endedAt.getTime() - startedAt.getTime() };","    callTrace.push(entry);","    logger?.info({ event: 'trace', trace: entry });","  };","  // Spec #183 trace vocabulary: every run — complete, partial or failed — ends","  // with a run_end entry carrying the stop reason and the final usage.","  const recordRunEnd = (status: 'complete' | 'partial' | 'failed', stopReason: string | null): void => {","    const now = new Date();","    recordCall({","      type: 'run_end', name: 'run_end', inputTokens: metrics.inputTokens, outputTokens: metrics.outputTokens, usageMissing: !metrics.usageAvailable,","      outcome: `status=${status}; stopReason=${stopReason ?? 'none'}`,","      result: { status, stopReason, inputTokens: metrics.inputTokens, outputTokens: metrics.outputTokens, modelCalls: metrics.modelCalls, toolCalls: metrics.toolCalls, durationMs: metrics.durationMs }","    }, now, now);","  };","  try {","  const tools = await workspace(root);","  logger = researchLog(root, runId);","  logger.info({ event: 'research_start', objective, root, budget: limits, codeMode, memoryEnabled: !!memory, model: model.snapshot?.() });","  const complete: Model['complete'] = async (messages, options) => {","    logger!.info({ event: 'model_request', messages, options: { maxOutputTokens: options?.maxOutputTokens, codeMode: options?.codeMode, memory: options?.memory, toolsEnabled: options?.toolsEnabled } });","    try {","      const response = await model.complete(messages, options);","      logger!.info({ event: 'model_response', response, model: model.snapshot?.() });","      return response;","    } catch (error) {","      logger!.error({ event: 'model_error', error: String(error), model: model.snapshot?.() });","      throw error;","    }","  };","  const library = memory ? await scriptMemory(root, memory.directory) : undefined;","  // Background revision lookup (lazily filled): used for staleness + sourcing.","  let currentRevision: string | undefined;","  const resolveRevision = async (): Promise<string> => {","    if (currentRevision !== undefined) return currentRevision;","    try { currentRevision = String(await tools.git(limits.durationMs)).split('\\n')[0].trim() || 'unknown-revision'; }","    catch { currentRevision = 'unknown-revision'; }","    return currentRevision;","  };","  const attempts: Attempt[] = [];","  // Issue #187 (D04) + #188 (D05): per-candidate reconciliation log. Filled","  // during the run for proposals that never reach the deterministic validator,","  // and during consolidation for the ones that do.","  const unreconciled: ReconciliationOutcome[] = [];","  // In-session traces only: the catalogue is mutated once, at the end of the run (correction 3)."]},"returned":1,"observed":null,"truncated":false,"bounds":{"maxItems":50,"maxBytes":8000},"bytes":6854,"revision":"3e8f2aa7da11dd6d26bbb6e3dffde679471c9780","provenance":"unverified","uncertainty":["No primitive-derived evidence is verified for this output; relations remain unverified."]}},{"name":"read_explore_ts_part2","question":"How does the harness execute tools and control their execution via sandboxing and strict mode?","description":"Reads a middle section of src/explore.ts to understand tool execution, strict mode, timeouts, and validation flow","paramsSchema":[],"returns":"ReadResult","code":"readLines(\"src/explore.ts\", 200, 290)","output":{"result":{"file":"src/explore.ts","start":200,"lines":["    if (!response.toolCalls?.length) throw new Error('Model returned neither tools nor result');","    const calls = response.toolCalls.slice(0, Math.max(0, Math.min(8, limits.calls - metrics.modelCalls - metrics.toolCalls)));","    const outputs: any[] = [{ role: 'assistant', tool_calls: calls.map(call => ({ id: call.id, type: 'function', function: { name: call.name, arguments: JSON.stringify(call.arguments) } })) }];","    for (const originalCall of calls) {","      // Optional caller metadata is retained in the trace, but never gates exploration.","      const questionId = typeof originalCall.arguments.question_id === 'string' ? originalCall.arguments.question_id : undefined;","      const call = { ...originalCall, arguments: { ...originalCall.arguments } };","      delete call.arguments.question_id;","      if (Date.now() - startedMs >= limits.durationMs || metrics.inputTokens + metrics.outputTokens >= limits.tokens) break;","      metrics.toolCalls++;","      const toolStarted = new Date();","      let output: unknown;","      let failed = false;","      let attempt: Attempt | undefined;","      let scriptCall: { type: 'memory_run' | 'function_try'; name: string } | undefined;","      try {","        if (primitiveNames.has(call.name)) {","          const { runScript } = await import('codetour-exploration-sandbox');","          const args = call.arguments;","          const expressions: Record<string, string> = {","            listFiles: 'listFiles(params.maxFiles)', searchText: 'searchText(params.query)', searchIdentifiers: 'searchIdentifiers(params.identifier)',","            readLines: 'readLines(params.file, params.startLine, params.endLine)', readAround: 'readAround(params.file, params.line, params.contextLines)',","            listSymbols: 'listSymbols()', findDefinitions: 'findDefinitions(params.symbol)', findReferences: 'findReferences(params.symbol)',","            getImports: 'getImports(params.file)', getGitDiff: 'getGitDiff(params.revision1, params.revision2)'","          };","          const defaults = { listFiles: { maxFiles: 500 }, readAround: { contextLines: 5 }, getGitDiff: { revision2: 'HEAD' } };","          const params = { ...(defaults[call.name as keyof typeof defaults] ?? {}), ...args };","          const execution = await runScript({ workspace: root, code: expressions[call.name], params, strict: true, includeTrace: true, timeoutMs: Math.min(5000, Math.max(1, limits.durationMs - (Date.now() - startedMs))) });","          let value = execution.value;","          // Direct model-facing reads show absolute line numbers. The sandbox","          // primitive contract used by procedures keeps its original string[].","          if ((call.name === 'readLines' || call.name === 'readAround') && value && typeof value === 'object') {","            const read = value as { file: string; start: number; lines: string[] };","            value = { ...read, lines: read.lines.map((text, index) => ({ line: read.start + index, text })) };","          }","          output = boundedOutput(value, { revision: await resolveRevision(), sourceTruncated: execution.trace.truncated, primitiveDerived: true });","        }","        else if (call.name === 'list') output = await tools.list();","        else if (call.name === 'search' && typeof call.arguments.query === 'string') output = await tools.search(call.arguments.query);","        else if (call.name === 'read' && typeof call.arguments.file === 'string') {","          const start = Number(call.arguments.startLine ?? 1);","          output = await tools.read(call.arguments.file, start, Number(call.arguments.endLine ?? start + 99));","        }","        else if (call.name === 'git') output = await tools.git(limits.durationMs - (Date.now() - startedMs));","        else if (library && call.name === 'memory_list') {","          const listed = library.memory_list(typeof call.arguments.query === 'string' ? call.arguments.query : undefined);","          const available = listed.length === 0 ? library.catalog() : [];","          if (listed.length === 0 && available.length > 0) {","            output = { results: [], available, note: 'No entries match the exact query. The catalogue is not empty; inspect the available entries or retry with a shorter literal query.' };","          } else if (listed.length === 0 && ++emptyMemoryListCount >= 2 && !emptyMemoryListNoteEmitted) {","            emptyMemoryListNoteEmitted = true;","            output = { results: [], note: 'The catalogue is empty again. Revising the plan in a loop will not fill it: if the question you are serving is durably reusable and no permanent primitive covers it, build the missing capability once with function_try(source, params) instead of revising the plan again; otherwise state why not in the final result.' };","          } else {","            output = listed;","          }","        }","        else if (library && call.name === 'memory_unusable' && typeof call.arguments.id === 'string') {","          const id = call.arguments.id;","          // Issue #187: a proposed candidate may also be abandoned by name —","          // a candidate marked unusable never reaches the catalogue.","          if (!attempts.some(a => a.id === id || a.candidate?.name === id)) throw new Error('Script must have been executed in this run');","          unusableIds.add(id);","          for (const previous of attempts) if (previous.candidate?.name === id) abandonedAttempts.add(previous);","          output = { recordedAfterValidation: true };","        }","        else if (codeMode && ((call.name === 'code' && typeof call.arguments.code === 'string') || (call.name === 'function_try' && typeof call.arguments.source === 'string') || (library && call.name === 'memory_run' && typeof call.arguments.id === 'string'))) {","          const stored = call.name === 'memory_run' ? library?.get(String(call.arguments.id)) : undefined;","          if (call.name === 'memory_run' && !stored) throw new Error('Unknown script');","          const code = stored?.code ?? String(call.arguments.source ?? call.arguments.code);","          const params = call.arguments.params ?? {};","          if (!params || typeof params !== 'object' || Array.isArray(params)) throw new Error('Invalid parameters');","          const remaining = limits.durationMs - (Date.now() - startedMs);","          if (remaining <= 0) return { messages: outputs, stopReason: 'duration' };","          const { runScript } = await import('codetour-exploration-sandbox');","          const controller = new AbortController();","          const timer = setTimeout(() => controller.abort(), remaining);","          scriptCall = { type: stored ? 'memory_run' : 'function_try', name: stored ? stored.id : 'function_try' };","          // Ticket #191: any memory_run/function_try call — accepted or failed —","          // counts as having served its declared question; the trace carries the","          // outcome, the reminder only targets questions never attempted.","          const runStarted = new Date();","          try {","            let raw: unknown;","            if (stored) {","              metrics.memoryReuses++;","              // Issue #174 complement (B-verification): stored revision + proof validity","              // checked against the fixture — uncertain/obsolete proofs are signalled","              // explicitly, never returned silently as fresh.","              const revision = await resolveRevision();","              if (stored.revision && revision !== 'unknown-revision' && !revision.startsWith(stored.revision.slice(0, 12))) {","                output = { staleness: { signal: 'stored-revision-differs', storedRevision: stored.revision, currentRevision: revision, note: `Proofs were consolidated at revision ${stored.revision}. Re-verify before relying on them; prefer re-exploring with the permanent primitives if the references below look obsolete.` } };"]},"returned":1,"observed":null,"truncated":false,"bounds":{"maxItems":50,"maxBytes":8000},"bytes":7990,"revision":"3e8f2aa7da11dd6d26bbb6e3dffde679471c9780","provenance":"unverified","uncertainty":["No primitive-derived evidence is verified for this output; relations remain unverified."]}},{"name":"read_explore_ts_part3","question":"How does the harness execute tools and control their execution via sandboxing and strict mode?","description":"Reads the continuation of src/explore.ts to understand how runScript results are validated, how citations are checked, and how refusals are handled","paramsSchema":[],"returns":"ReadResult","code":"readLines(\"src/explore.ts\", 300, 390)","output":{"result":{"preview":"{\"file\":\"src/explore.ts\",\"start\":300,\"lines\":[\"            // exhaustively validated without any LLM — no sample, no judge. A\",\"            // citation-invalid trial returns short structured repair feedback\",\"            // instead of its result, is never proposed for consolidation, and\",\"            // leaves its code and diagnostics in the trace only.\",\"            const citations = call.name === 'function_try' ? await validateCitations(raw, { access: citationAccess(tools), revision: await resolveRevision() }) : undefined;\",\"            const citationFailure = citations?.status === 'validation_failed' ? citationRepairFeedback(citations) : undefined;\",\"            recordCall({ type: scriptCall.type, name: scriptCall.name, callId: call.id, questionId, parameters: call.name === 'function_try' ? { remember: call.arguments.remember === true, name: call.arguments.name, question: call.arguments.question, description: call.arguments.description } : { id: stored?.id, params }, inputTokens: null, outputTokens: null, usageMissing: false, execution: execution.trace, result: stored ? bounded : citationFailure?.validation, outcome: `returned=${bounded.returned}${bounded.truncated ? '; TRUNCATED, not exhaustive' : ''}${citationOutcome(citations)}` }, runStarted, runEnded);\",\"            output = citationFailure ?? (output && typeof output === 'object' && 'staleness' in (output as Record<string, unknown>) ? { ...(output as Record<string, unknown>), result: bounded } : bounded);\",\"            // The description is kept whole: a deterministic gate at consolidation\",\"            // refuses off-format or oversized descriptions with a precise reason\",\"            // instead of silently truncating them (issue #187).\",\"            const description = typeof call.arguments.description === 'string' ? call.arguments.description.trim() : '';\",\"            const name = typeof call.arguments.name === 'string' ? call.arguments.name.trim().slice(0, 100) : '';\",\"            const returns = typeof call.arguments.returns === 'string' ? call.arguments.returns.trim().slice(0, 300) : undefined;\",\"            // Issue #194: every successfully-executed strict function_try trial\",\"            // is automatically submitted to post-Tour selection — the model\",\"            // never has to flag it with remember. Failed trials (the sandbox\",\"            // throw above) and citation-invalid trials (citationFailure) never\",\"            // become candidates; a truncated view is still submitted but\",\"            // flagged as such in the selection input, and the deterministic\",\"            // replay still validates the full raw output.\",\"            const viewTruncated = Boolean((bounded as { truncated?: boolean } | null)?.truncated);\",\"            let candidate = !citationFailure && library && !stored\",\"              ? { objective: String(call.arguments.question ?? objective).slice(0, 500), description, name: name || derivedCandidateName(String(call.arguments.question ?? objective), code), returns: strict ? execution.trace.contract.returns : returns, code, parameters: Object.keys(params).slice(0, 30), paramsSchema: execution.trace.contract?.paramsSchema, executionMode: strict ? 'strict' as const : 'legacy' as const, revision: await resolveRevision() }\",\"              : undefined;\",\"            if (library && (stored || candidate)) {\",\"              // Proof spot-check: verify a sample of (file,line) references against the\",\"              // actual fixture. Invalid proofs are explicit — contractRespected=false in\",\"              // the consolidation signal — and never silently trusted.\",\"              const refs = sampleEvidenceRefs(raw, 3);\",\"              let proofOk = refs.length > 0;\",\"              const proofSignature: string[] = [];\",\"              for (const ref of refs.slice(0, 3)) {\",\"                try {\",\"                  const lines = await tools.read(ref.file, ref.line, ref.line, true);\",\"                  const valid = Array.isArray(lines) && lines.length === 1 && typeof lines[0]?.text === 'string';\",\"                  proofSignature.push(`${ref.file}:${ref.line}:${valid ? 'ok' : 'empty'}`);\",\"                  if (!valid) proofOk = false;\",\"                } catch { proofSignature.push(`${ref.file}:${ref.line}:unreadable`); proofOk = false; }\",\"              }\",\"              attempt = { id: stored?.id, candidate, params: params as Record<string, unknown>, output: raw, truncated: viewTruncated, proofValid: refs.length === 0 ? undefined : proofOk, proofSignature };\",\"            }\",\"          } catch (error) {\",\"            recordCall({ type: scriptCall?.type ?? 'function_try', name: call.name === 'memory_run' ? String(call.arguments.id ?? call.name) : 'function_try', callId: call.id, questionId, parameters: stored ? { id: stored.id, params } : undefined, inputTokens: null, outputTokens: null, usageMissing: false, error: String(error) }, runStarted, new Date());\",\"            if (stored) runtimeFailures.push(stored.id);\",\"            // Issue #188 (D05): a proposal (remember=true) whose trial never\",\"            // executed is an explicit reconciliation outcome — proposed but not\",\"            // tried — never a silent gap between the plan and the catalogue.\",\"            if (!stored && call.arguments.remember === true) {\",\"              unreconciled.push({ name: typeof call.arguments.name === 'string' ? call.arguments.name.trim().slice(0, 100) : '', proposed: true, replayed: false, accepted: false, reason: `Trial failed before execution: ${String((error as Error)?.message ?? error).slice(0, 200)}` });\",\"            }\",\"            throw error;\",\"          }\",\"          finally { clearTimeout(timer); }\",\"        }\",\"        else throw new Error('Unknown tool or invalid arguments');\",\"      } catch (error) { failed = true; output = { error: String((error as Error).message ?? error).slice(0, 500) }; }\",\"      const identity = call.name === 'function_try' ? { source: call.arguments.source, params: call.arguments.params }\",\"        : call.name === 'code' ? { code: call.arguments.code, params: call.arguments.params }\",\"        : call.name === 'memory_run' ? { id: call.arguments.id, params: call.arguments.params }\",\"        : call.arguments;\",\"      const failureKey = JSON.stringify(stableValue([call.name, identity, failed ? (output as { error: string }).error : null]));\",\"      consecutiveFailures = failed ? (fail"},"returned":1,"observed":null,"truncated":true,"bounds":{"maxItems":50,"maxBytes":8000},"bytes":6559,"revision":"3e8f2aa7da11dd6d26bbb6e3dffde679471c9780","provenance":"unverified","uncertainty":["No primitive-derived evidence is verified for this output; relations remain unverified.","Output truncated to 50 items / 8000 bytes; it is NOT exhaustive. Re-run with narrower params to see the remainder."]}},{"name":"search_consolidation","question":"Find where consolidation refusals or rejections are handled in the codebase","description":"Searches for the term consolidation across files to identify refusal mechanisms for consolidation and how they are signaled","paramsSchema":[],"returns":"SourceMatch[]","code":"searchText(\"consolidation\")","output":{"result":[{"file":".tours/memoire-procedurale-mcp.tour","line":4,"text":"  \"description\": \"Parcours du mécanisme de **mémoire procédurale** du harness de recherche CodeTour (paquet `codetour-exploration-poc`) : où vivent les procédures apprises (`.tours/.memory`), comment un `function_try` les capture, comment `memory_run` les réexécute, comment sélection, replay déterministe et portes de consolidation décident de la persistance, et comment tout cela s'observe dans les journaux et la télémétrie.\","},{"file":".tours/memoire-procedurale-mcp.tour","line":8,"text":"      \"description\": \"Ce dépôt héberge `codetour-research` (paquet `codetour-exploration-poc`) : un CLI qui répond à une question de recherche sur un dépôt en pilotant un modèle LLM et en justifiant chaque conclusion par des extraits de code vérifiés à la ligne près. Ce tour suit un mécanisme précis de ce harness : la **mémoire procédurale**, qui apprend des fonctions TypeScript pendant une exploration, les persiste sur disque, les réexécute lors des runs suivants, et n'accepte une nouvelle procédure qu'après une validation strictement déterministe.\\n\\n**Diagram — Context view**\\n\\n```mermaid\\nflowchart LR\\n  dev[\\\"Développeur / analyste\\\"]\\n  cli[\\\"codetour-research — CLI d'exploration\\\"]\\n  mistral[\\\"API Mistral — LLM externe\\\"]\\n  dev -->|\\\"Pose une question en ligne de commande\\\"| cli\\n  cli -->|\\\"Appels de complétion en HTTPS\\\"| mistral\\n  mistral -->|\\\"Plan, appels d'outils et résultat JSON\\\"| cli\\n  cli -->|\\\"Compte-rendu JSON avec preuves\\\"| dev\\n```\\n\\n**Diagram — Containers**\\n\\n```mermaid\\nflowchart LR\\n  subgraph proc[\\\"Processus CLI d'exploration\\\"]\\n    loop[\\\"Boucle d'exploration LangGraph\\\"]\\n  end\\n  mem[(\\\"Catalogue .tours/.memory — JSON + functions/*.ts\\\")]\\n  logs[(\\\"Journal .tours/.log/research.log\\\")]\\n  mistral[\\\"API Mistral\\\"]\\n  loop -->|\\\"Lit et écrit le catalogue via scriptMemory, JSON atomique 0600\\\"| mem\\n  loop -->|\\\"Trace chaque événement pino, rotation 10 Mo\\\"| logs\\n  loop -->|\\\"Complétions HTTPS avec usage token\\\"| mistral\\n```\\n\\nOù travailler :\\n\\n- [src/](src) — toute la logique : [src/cli.ts](src/cli.ts) (options et chemin canonique de la mémoire), [src/explore.ts](src/explore.ts) (boucle d'exploration, réutilisation et consolidation), [src/memory.ts](src/memory.ts) (catalogue et portes de persistance), [src/memory-output.ts](src/memory-output.ts) (enveloppes de sortie bornées), [src/research-log.ts](src/research-log.ts) (journal rotatif).\\n- [test/](test) — tests du comportement de la mémoire et de la validation.\\n- `.tours/.me"},{"file":".tours/memoire-procedurale-mcp.tour","line":26,"text":"      \"description\": \"Le schéma zod `entrySchema` définit ce qu'une procédure apprise est : un identifiant TypeScript (`id`), la **question canonique** (`objective`, 500 caractères max) qu'elle sert indépendamment du run qui l'a créée, une description bornée à 300 caractères, le code source lui-même (32 768 max), les paramètres typés (`paramsSchema`) et un **contrat de sortie** (`outputContract` : forme annoncée, champs attendus sur chaque item, bornes).\\n\\nViennent ensuite les garde-fous : `limits` (maxItems 50, maxBytes 8000 par défaut), `uncertaintyCases` (cas où la sortie ne doit pas être crue aveuglément, avec le signal remis à l'appelant), `revision` Git au moment de la consolidation, compteurs `successes`/`failures`, et `executionMode` (`strict` ou `legacy`). Le code note une contrainte G0 explicite : **aucune purge sur inactivité** — la mémoire n'oublie pas par défaut ; c'est un catalogue curaté, pas un cache LRU.\","},{"file":".tours/memoire-procedurale-mcp.tour","line":46,"text":"      \"description\": \"C'est le point de capture. En mode mémoire, les dix primitives permanentes (`listFiles`, `searchText`, `readLines`, …) ne sont **pas** exposées comme outils directs : le modèle doit les emballer dans une fonction TypeScript unique et l'essayer avec `function_try(source, params)`. Cette contrainte d'emballage, énoncée dans les instructions système (`memoryInstructions`), fait qu'une candidate est d'emblée une procédure paramétrable et réutilisable, pas un appel brut.\\n\\nL'essai est exécuté par la vraie sandbox (`runScript`, mode `strict`, timeout borné), et tracé via `scriptCall = { type: 'memory_run' | 'function_try' }`. Toute fonction_try **réussie** devient automatiquement candidate à la consolidation — plus aucun flag `remember` à positionner (ticket #194). Un essai qui échoue (sandbox ou citations) est tracé, jamais proposé ; un nom absent est dérivé de la question par `derivedCandidateName` (src/exploration-helpers.ts).\","},{"file":".tours/memoire-procedurale-mcp.tour","line":56,"text":"      \"description\": \"Deux filtres s'appliquent avant même de parler de mémorisation. D'abord, en mode `strict`, **chaque** référence obligatoire émise par l'essai est validée sans LLM par `validateCitations` (src/citation-validator.ts) : pas d'échantillonnage, pas de juge. Un essai aux citations invalides ne renvoie qu'un court feedback de réparation structuré et ne sera jamais candidat.\\n\\nEnsuite la sortie brute est enveloppée par `boundedOutput` (src/memory-output.ts) : compacte (bornes maxItems/maxBytes), sourcée (révision du workspace), avec provenance `primitive-derived` ou `unverified`, et — point crucial — une sortie tronquée porte un flag `truncated` et n'est **jamais présentée comme exhaustive**. En parallèle, `sampleEvidenceRefs` prélève jusqu'à 3 références fichier/ligne pour un contrôle par sondage contre le vrai dépôt ; ce contrôle alimente `contractRespected` du futur signal de consolidation.\","},{"file":".tours/memoire-procedurale-mcp.tour","line":76,"text":"      \"description\": \"La consolidation n'est pas décidée par l'essai lui-même mais par une étape **post-Tour**. Quand le run aboutit à un résultat structuré avec preuves valides et sans stop reason, les candidats stricts exécutés (et jamais abandonnés via `memory_unusable`) sont soumis à un appel LLM dédié `memory-selection`. La trace de cet appel montre ce qui lui est envoyé : `selectionInput` contient le tour produit, le catalogue courant et chaque candidat avec code, contrat et sortie bornée. Le modèle renvoie `{\\\"selected\\\":[\\\"name\\\"]}` et a le droit de ne rien sélectionner.\\n\\nLa consigne de sélection est critériée : contribution réelle à la recherche, fonctionnement correct, documentation (but, paramètres, retour, limites), absence de doublon — « les procédures spécifiques au projet sont les bienvenues ; ne prédis pas l'utilité future ». Chaque candidat non retenu, marqué unusable, ou `legacy` est consigné avec sa raison dans le journal de réconciliation (issues #187/#194) : rien ne disparaît en silence entre le plan et le catalogue.\","},{"file":".tours/memoire-procedurale-mcp.tour","line":86,"text":"      \"description\": \"Dernier filtre, entièrement déterministe : chaque candidat sélectionné est **rejoué** — même code, mêmes paramètres, même sandbox `strict`. La sortie du rejeu doit être identique à la sortie d'origine (comparaison JSON exacte) et **toutes** les citations sont revalidées exactement comme à l'essai. Toute divergence (« the re-execution did not reproduce the exact original output ») ou citation invalide refuse le candidat, avec la raison conservée.\\n\\nChaque rejeu est tracé sous le nom `consolidation-validation`. Aucun second juge LLM n'intervient : c'est l'ancrage de la confiance — une procédure n'est persistée que si sa réussite est reproductible mécaniquement. Faute de budget restant, le candidat est refusé avec la raison `Budget exhausted before the reconciliation replay`.\","}],"returned":7,"observed":50,"truncated":true,"bounds":{"maxItems":50,"maxBytes":8000},"bytes":7924,"revision":"3e8f2aa7da11dd6d26bbb6e3dffde679471c9780","provenance":"unverified","uncertainty":["No primitive-derived evidence is verified for this output; relations remain unverified.","Output truncated to 50 items / 8000 bytes; it is NOT exhaustive. Re-run with narrower params to see the remainder."]}},{"name":"read_memory_ts","question":"How does the memory system handle consolidation refusals and what signals are used?","description":"Reads src/memory.ts to understand consolidation gates, refusal reasons, and how candidates are accepted or rejected","paramsSchema":[],"returns":"ReadResult","code":"readLines(\"src/memory.ts\", 1, 100)","output":{"result":{"file":"src/memory.ts","start":1,"lines":["import { createHash, randomUUID } from 'node:crypto';","import { lstat, mkdir, readFile, realpath, rename, unlink, writeFile } from 'node:fs/promises';","import { isAbsolute, join, relative, resolve, sep } from 'node:path';","import { z } from 'zod';","","// ============================================================================","// Catalogue entry model (issue #174 complement)","// ============================================================================","","const paramSchemaShape = z.object({","  name: z.string().min(1),","  type: z.string().min(1).max(200).default('unknown'),","  description: z.string().max(200).optional(),","});","","const outputContractShape = z.object({","  // Human-readable description of the returned shape, e.g. \"SearchMatch[] {file, line, text}\".","  returns: z.string().min(1).max(300),","  // Structural fields expected on each item (proof contract).","  itemFields: z.array(z.string()).max(20).default([]),","  // Bounds the output honours.","  bounds: z.object({ maxItems: z.number().int().positive(), maxBytes: z.number().int().positive() }),","});","","const uncertaintyCaseShape = z.object({","  // Concrete case in which the output must not be trusted blindly.","  case: z.string().min(1).max(200),","  // Explicit signal the caller receives in that case.","  signal: z.string().min(1).max(200),","});","","const entrySchema = z.object({","  id: z.string().min(1),","  objective: z.string().max(500),","  description: z.string().max(300),","  code: z.string().max(32768),","  parameters: z.array(z.string()).max(30),","  paramsSchema: z.array(paramSchemaShape).max(30).default([]),","  outputContract: outputContractShape.optional(),","  limits: z.object({ maxItems: z.number().int().positive().default(50), maxBytes: z.number().int().positive().default(8000) }).optional(),","  uncertaintyCases: z.array(uncertaintyCaseShape).max(10).default([]),","  revision: z.string().max(64).optional(),","  successes: z.number().int().nonnegative().optional(),","  failures: z.number().int().nonnegative().optional(),","  // G0 requirement: NO inactivity tracking or purge","  fingerprint: z.string().optional(),","  version: z.number().int().nonnegative().optional(),","  replacedBy: z.string().optional(),","  variantOf: z.string().optional(),","  validated: z.boolean().optional(),","  executionMode: z.enum(['strict', 'legacy']).optional(),","  referenceCases: z.array(z.object({ params: z.record(z.string(), z.unknown()), ok: z.boolean(), at: z.string() })).max(5).optional()","}).passthrough();","type Entry = z.infer<typeof entrySchema>;","","/** Outcome of a catalogue comparison. 'indeterminate' is reported honestly instead of inventing equivalence. */","export type ComparisonOutcome = 'duplicate' | 'distinct' | 'indeterminate';","","export interface ReferenceCase { params: Record<string, unknown>; ok: boolean; at: string }","","/** Deterministic replay evidence (issue #187): the exact same code and params were re-executed and every citation re-checked. */","export interface ReplayEvidence {","  ok: boolean;","  reason?: string;","  citations?: 'valid' | 'no_references' | 'validation_failed';","}","","/** Issue #187: per-candidate reconciliation log — proposed / replayed / accepted / rejected with reason. */","export interface ReconciliationOutcome {","  name: string;","  /** True when the model proposed (selected) the candidate for consolidation. */","  proposed: boolean;","  /** True when the deterministic reconciliation re-executed the exact code and params with all citations re-checked. */","  replayed: boolean;","  accepted: boolean;","  reason?: string;","}","","export interface ConsolidationCandidate {","  objective: string;","  description: string;","  code: string;","  parameters: string[];","  paramsSchema?: Array<{ name: string; type: string }>;","  executionMode?: 'strict' | 'legacy';","  /** TypeScript identifier used as the catalogue key. */","  name: string;","  /** Output contract declared with the candidate. */","  returns?: string;","  uncertaintyCases?: Array<{ case: string; signal: string }>;","  verified: boolean;","  /** Concrete operational consolidation signal (correction 3): never a blind benchmark judge. */","  consolidationSignal?: { executedSuccessfully: boolean; proofAvailable: boolean; contractRespected: boolean };","  /** Deterministic replay evidence (issue #187): required — no replay, no persistence. */","  replay?: ReplayEvidence;","  version?: number;","  variantOf?: string;","  revision?: string;","}",""]},"returned":1,"observed":null,"truncated":false,"bounds":{"maxItems":50,"maxBytes":8000},"bytes":4581,"revision":"3e8f2aa7da11dd6d26bbb6e3dffde679471c9780","provenance":"unverified","uncertainty":["No primitive-derived evidence is verified for this output; relations remain unverified."]}},{"name":"read_memory_ts_part2","question":"How does the memory system handle consolidation refus refusals and what signals are used?","description":"Reads the continuation of src/memory.ts to understand consolidation gates, refusal reasons, and how candidates are accepted or rejected","paramsSchema":[],"returns":"ReadResult","code":"readLines(\"src/memory.ts\", 101, 200)","output":{"result":{"file":"src/memory.ts","start":101,"lines":["export interface ConsolidationReport {","  accepted: string[];","  rejected: Array<{ name: string; reason: string }>;","  duplicates: string[];","  indeterminate: string[];","  /** Issue #187: one entry per candidate that reached the deterministic validator. */","  reconciliation: ReconciliationOutcome[];","}","","/** Maximum stored description length (matches the entry schema bound). */","const MAX_DESCRIPTION_LENGTH = 300;","","/**"," * Practable English screen — not proof of English: non-ASCII is refused"," * outright, and an accepted description must contain at least one common"," * English function word. A passing text is screened, never proven English"," * (spec #183: a heuristic language detector is never sold as infallible)."," */","const ENGLISH_FUNCTION_WORDS = new Set(['the', 'a', 'an', 'and', 'or', 'of', 'for', 'with', 'from', 'to', 'in', 'on', 'by', 'is', 'are', 'be', 'been', 'was', 'were', 'has', 'have', 'had', 'does', 'do', 'did', 'returns', 'return', 'returning', 'given', 'when', 'each', 'its', 'this', 'that', 'which', 'not', 'into', 'over', 'under', 'out', 'as', 'at', 'than', 'then', 'can', 'will', 'would', 'should', 'may', 'must', 'never', 'always', 'per', 'via', 'using', 'use', 'uses', 'used', 'searches', 'search', 'finds', 'find', 'reads', 'read', 'lists', 'list', 'counts', 'count', 'reports', 'report']);","","/**"," * Deterministic description validation (issue #187, D04): a candidate is kept"," * only with a non-empty, length-bounded English description stating what the"," * procedure does, its scope, its result shape and its key limits. No LLM judges"," * the text: empty and oversized"," * descriptions are refused outright, while the English rule is a practable"," * heuristic screen (see ENGLISH_FUNCTION_WORDS) — a description passing it"," * is screened, not proven English."," */","export function validateDescription(description: string): { ok: boolean; reason?: string } {","  const trimmed = typeof description === 'string' ? description.trim() : '';","  if (!trimmed) return { ok: false, reason: 'Description is mandatory: state what the procedure does, its scope, the shape of its result and its key limits.' };","  if (trimmed.includes('*/')) return { ok: false, reason: 'Description cannot contain a JSDoc comment terminator.' };","  if (trimmed.length > MAX_DESCRIPTION_LENGTH) return { ok: false, reason: `Description is too long: ${trimmed.length} characters; at most ${MAX_DESCRIPTION_LENGTH} are allowed.` };","  if (/[^\\x20-\\x7E]/.test(trimmed)) return { ok: false, reason: 'Description must be written in English: non-ASCII (e.g. accented) characters are not accepted.' };","  const words = trimmed.toLowerCase().match(/[a-z']+/g) ?? [];","  if (!words.some(word => ENGLISH_FUNCTION_WORDS.has(word))) return { ok: false, reason: 'Description must be written in English: no common English word was found in the text.' };","  return { ok: true };","}","","const digest = (s: string) => createHash('sha256').update(s).digest('hex');","","/** Accept any usable TypeScript identifier; its meaning belongs in the documentation. */","export function validateCanonicalName(name: string): { ok: boolean; reason?: string } {","  if (!/^[$_\\p{ID_Start}][$_\\u200c\\u200d\\p{ID_Continue}]*$/u.test(name) || new Set(['break','case','catch','class','const','continue','debugger','default','delete','do','else','export','extends','finally','for','function','if','import','in','instanceof','let','new','return','super','switch','this','throw','try','typeof','var','void','while','with','yield','enum','await','implements','interface','package','private','protected','public','static']).has(name)) return { ok: false, reason: 'Name must be a valid TypeScript identifier' };","  return { ok: true };","}","","/**"," * Dedup on question + scope + contract — never on the name alone."," * No embeddings, no classifier: only normalized exact comparisons. When the"," * comparison cannot be decided, the outcome is 'indeterminate' and BOTH"," * entries are kept (never an invented equivalence)."," */","export function compareCandidates(candidate: { objective: string; description: string; returns?: string }, entry: { objective: string; description: string; outputContract?: { returns: string } }): ComparisonOutcome {","  const norm = (s: string) => s.toLowerCase().replace(/\\s+/g, ' ').trim();","  const sameQuestion = norm(candidate.objective) === norm(entry.objective);","  const sameScope = norm(candidate.description) === norm(entry.description);","  if (!sameQuestion || !sameScope) return 'distinct';","  // Same question + same scope: the contract decides.","  const candidateContract = candidate.returns ? norm(candidate.returns) : undefined;","  const entryContract = entry.outputContract?.returns ? norm(entry.outputContract.returns) : undefined;","  if (candidateContract && entryContract) return candidateContract === entryContract ? 'duplicate' : 'distinct';","  // Missing contract information on either side: comparison is indeterminate.","  return 'indeterminate';","}","","/** Local experimental store. The file name derives from the real repository path. */","export async function scriptMemory(root: string, directory: string) {","  const repo = await realpath(root);","  const targetDirectory = resolve(directory);","  const relativeDirectory = relative(repo, targetDirectory);","  const insideWorkspace = relativeDirectory !== '..' && !relativeDirectory.startsWith(`..${sep}`) && !isAbsolute(relativeDirectory);","  const ensureDirectory = async (path: string) => {","    try {","      const info = await lstat(path);","      if (info.isSymbolicLink() || !info.isDirectory()) throw new Error(`Unsafe memory directory: ${path}`);","    } catch (error: any) {","      if (error?.code !== 'ENOENT') throw error;","      await mkdir(path);","    }","  };","  if (insideWorkspace) {","    let current = repo;","    for (const part of relativeDirectory.split(sep).filter(Boolean)) {","      current = join(current, part);","      await ensureDirectory(current);","    }","  } else {","    await mkdir(targetDirectory, { recursive: true });","    await ensureDirectory(targetDirectory);","  }","  const rejectSymlink = async (path: string) => {","    try { if ((await lstat(path)).isSymbolicLink()) throw new Error(`Unsafe memory file: ${path}`); }","    catch (error: any) { if (error?.code !== 'ENOENT') throw error; }","  };","  const file = join(directory, `${digest(repo)}.json`);","  await rejectSymlink(file);","  let entries: Entry[];","  try { entries = z.array(entrySchema).parse(JSON.parse(await readFile(file, 'utf8'))); }"]},"returned":1,"observed":null,"truncated":false,"bounds":{"maxItems":50,"maxBytes":8000},"bytes":6657,"revision":"3e8f2aa7da11dd6d26bbb6e3dffde679471c9780","provenance":"unverified","uncertainty":["No primitive-derived evidence is verified for this output; relations remain unverified."]}},{"name":"search_runscript_export","question":"Find the definition of runScript to understand the tool contract and sandboxing constraints","description":"Searches for the export of runScript to extract its signature and constraints","paramsSchema":[],"returns":"SourceMatch[]","code":"searchText(\"export function runScript\")","output":{"result":[{"file":"src/sandbox.d.ts","line":2,"text":"  export function runScript(options: { workspace: string; code: string; params?: object; timeoutMs?: number; signal?: AbortSignal; scripts?: Record<string, string>; strict?: boolean; includeTrace?: boolean }): Promise<any>;"}],"returned":1,"observed":1,"truncated":false,"bounds":{"maxItems":50,"maxBytes":8000},"bytes":271,"revision":"3e8f2aa7da11dd6d26bbb6e3dffde679471c9780","provenance":"unverified","uncertainty":["No primitive-derived evidence is verified for this output; relations remain unverified."]}},{"name":"read_citation_validator_last","question":"What are the remaining parts of src/citation-validator.ts, including helper functions and exports?","description":"Reads the last lines of src/citation-validator.ts to extract any remaining functions, ty