exible guide: follow new evidence freely without revising or tracking the plan. When memory is enabled, consult memory_list for useful capabilities and run matching procedures with memory_run, verify their evidence, and investigate only what is missing. In Code Mode with memory, use function_try to explore via the provided primitives and propose useful parameterized procedures. Do not recreate equivalent procedures or nest memorized procedures. Do not write a Tour. Return sourced findings and explicit uncertainties.';\"},{\"file\":\"dist/explore.js\",\"line\":277,\"context\":\"else if (codeMode && ((call.name === 'code' && typeof call.arguments.code === 'string') || (call.name === 'function_try' && typeof call.arguments.source === 'string') || (library && call.name === 'memory_run' && typeof call.arguments.id === 'string'))) {\"},{\"file\":\"dist/explore.js\",\"line\":278,\"context\":\"const stored = call.name === 'memory_run' ? library?.get(String(call.arguments.id)) : undefined;\"},{\"file\":\"dist/explore.js\",\"line\":279,\"context\":\"if (call.name === 'memory_run' && !stored)\"},{\"file\":\"dist/explore.js\",\"line\":291,\"context\":\"scriptCall = { type: stored ? 'memory_run' : 'function_try', name: stored ? stored.id : 'function_try' };\"},{\"file\":\"dist/explore.js\",\"line\":292,\"context\":\"// Ticket #191: any memory_run/function_try call — accepted or failed —\"},{\"file\":\"dist/explore.js\",\"line\":312,\"context\":\"// Compact, structured, bounded, sourced output for memory_run AND function_try.\"},{\"file\":\"dist/explore.js\",\"line\":364,\"context\":\"recordCall({ type: scriptCall?.type ?? 'function_try', name: call.name === 'memory_run' ? String(call.arguments.id ?? call.name) : 'function_try', callId: call.id, questionId, parameters: stored ? { id: stored.id, params } : undefined, inputTokens: null, outputTokens: null, usageMissing: false, error: String(error) }, runStarted, new Date());\"},{\"file\":\"dist/explore.js\",\"line\":388,\"context\"