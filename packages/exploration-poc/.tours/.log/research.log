d.length === 0 && available.length > 0) {\",\"            output = { results: [], available, note: 'No entries match the exact query. The catalogue is not empty; inspect the available entries or retry with a shorter literal query.' };\",\"          } else if (listed.length === 0 && ++emptyMemoryListCount >= 2 && !emptyMemoryListNoteEmitted) {\",\"            emptyMemoryListNoteEmitted = true;\",\"            output = { results: [], note: 'The catalogue is empty again. Revising the plan in a loop will not fill it: if the question you are serving is durably reusable and no permanent primitive covers it, build the missing capability once with function_try(source, params) instead of revising the plan again; otherwise state why not in the final result.' };\",\"          } else {\",\"            output = listed;\",\"          }\",\"        }\",\"        else if (library && call.name === 'memory_unusable' && typeof call.arguments.id === 'string') {\",\"          const id = call.arguments.id;\",\"          // Issue #187: a proposed candidate may also be abandoned by name —\",\"          // a candidate marked unusable never reaches the catalogue.\",\"          if (!attempts.some(a => a.id === id || a.candidate?.name === id)) throw new Error('Script must have been executed in this run');\",\"          unusableIds.add(id);\",\"          for (const previous of attempts) if (previous.candidate?.name === id) abandonedAttempts.add(previous);\",\"          output = { recordedAfterValidation: true };\",\"        }\",\"        else if (codeMode && ((call.name === 'code' && typeof call.arguments.code === 'string') || (call.name === 'function_try' && typeof call.arguments.source === 'string') || (library && call.name === 'memory_run' && typeof call.arguments.id === 'string'))) {\",\"          const stored = call.name === 'memory_run' ? library?.get(String(call.arguments.id)) : undefined;\",\"          if (call.name === 'memory_run' && !stored) throw new Error('Unknown script');\",\"   