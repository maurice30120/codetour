ing.\"},{\"file\":\"src/decomposition-prompt.ts\",\"line\":4,\"context\":\"export const DECOMPOSITION_PROMPT = 'Investigate the supplied technical question. Treat the initial research plan as a flexible guide: follow new evidence freely without revising or tracking the plan. When memory is enabled, consult memory_list for useful capabilities and run matching procedures with memory_run, verify their evidence, and investigate only what is missing. In Code Mode with memory, use function_try to explore via the provided primitives and propose useful parameterized procedures. Do not recreate equivalent procedures or nest memorized procedures. Do not write a Tour. Return sourced findings and explicit uncertainties.';\"},{\"file\":\"src/exploration-helpers.ts\",\"line\":28,\"context\":\"type: 'model' | 'tool' | 'memory_run' | 'memory_list' | 'function_try' | 'decomposition_plan' | 'decomposition_decision' | 'run_end';\"},{\"file\":\"src/explore.ts\",\"line\":214,\"context\":\"let scriptCall: { type: 'memory_run' | 'function_try'; name: string } | undefined;\"},{\"file\":\"src/explore.ts\",\"line\":265,\"context\":\"else if (codeMode && ((call.name === 'code' && typeof call.arguments.code === 'string') || (call.name === 'function_try' && typeof call.arguments.source === 'string') || (library && call.name === 'memory_run' && typeof call.arguments.id === 'string'))) {\"},{\"file\":\"src/explore.ts\",\"line\":266,\"context\":\"const stored = call.name === 'memory_run' ? library?.get(String(call.arguments.id)) : undefined;\"},{\"file\":\"src/explore.ts\",\"line\":267,\"context\":\"if (call.name === 'memory_run' && !stored) throw new Error('Unknown script');\"},{\"file\":\"src/explore.ts\",\"line\":276,\"context\":\"scriptCall = { type: stored ? 'memory_run' : 'function_try', name: stored ? stored.id : 'function_try' };\"},{\"file\":\"src/explore.ts\",\"line\":277,\"context\":\"// Ticket #191: any memory_run/function_try call — accepted or failed —\"}],\"returned\":23,\"observed\