Schema?: Array<{ name: string; type: string }>; executionMode?: 'strict' | 'legacy'; revision?: string };\",\"  params?: Record<string, unknown>;\",\"  output: unknown;\",\"  /** Issue #194: the trial output was truncated (sandbox cap or bounding) — flagged, never presented as exhaustive. */\",\"  truncated?: boolean;\",\"  proofValid?: boolean;\",\"  proofSignature?: string[];\",\"}\",\"\",\"/** An exploration returns validated references, never Tour prose. */\",\"export async function explore({ root, objective, model, budget = {}, codeMode = false, memory }: { root: string; objective: string; model: Model; budget?: Budget; codeMode?: boolean; memory?: { directory: string } }) {\",\"  if (memory && !codeMode) throw new Error('Script memory requires Code Mode');\",\"  const limits = { iterations: budget.iterations ?? 100, calls: budget.calls ?? 400, tokens: budget.tokens ?? 1000000, durationMs: budget.durationMs ?? 900000 };\",\"  if (Object.values(limits).some(n => !Number.isFinite(n) || n <= 0)) throw new Error('Budgets must be positive');\",\"  const startedMs = Date.now();\",\"  const runId = crypto.randomUUID();\",\"  let plan: PlanRecord = { status: 'missing', runId };\",\"  const metrics = { inputTokens: 0, outputTokens: 0, usageAvailable: true, modelCalls: 0, toolCalls: 0, durationMs: 0, outputBytes: 0, cost: null as number | null, memoryReuses: 0, memoryPurges: 0, memoryQueryRejects: 0, memoryResultsCompacted: 0, memoryResultsRepeated: 0, autoAttachedEvidence: 0, selectionSkip: null as string | null };\",\"  const callTrace: CallTraceItem[] = [];\",\"  let callSeq = 0;\",\"  let logger: Logger | undefined;\",\"  let requestedEvidenceRecovery = false;\",\"  let requestedJsonRecovery = false;\",\"  let nextOutputLimit = 16384;\",\"  let requestedSchemaRecovery = false;\",\"  // Ticket #190: on the 2026-11-16 run the model called memory_list six times\",\"  // with returned=0 and revised its plan seven times without ever reaching\",\"  // function_try — it tre