attempt.candidate.code, params: attempt.params, strict: true, includeTrace: true, timeoutMs: Math.min(5000, remaining) });\"},{\"file\":\"src/memory.ts\",\"line\":260,\"text\":\"      // Note: Actual execution happens in explore.ts via runScript with params.\"},{\"file\":\"src/sandbox.d.ts\",\"line\":2,\"text\":\"  export function runScript(options: { workspace: string; code: string; params?: object; timeoutMs?: number; signal?: AbortSignal; scripts?: Record<string, string>; strict?: boolean; includeTrace?: boolean }): Promise<any>;\"},{\"file\":\"test/spec-172-conformance.test.ts\",\"line\":15,\"text\":\"import { runScript } from '../../exploration-sandbox/index.js';\"},{\"file\":\"test/spec-172-conformance.test.ts\",\"line\":31,\"text\":\"    const files = await runScript({ workspace: tempDir, code: 'listFiles().length', params: {}, timeoutMs: 3000 });\"},{\"file\":\"test/spec-172-conformance.test.ts\",\"line\":34,\"text\":\"    const matches = await runScript({ workspace: tempDir, code: 'search(\\\"helper\\\")', params: {}, timeoutMs: 3000 });\"},{\"file\":\"test/spec-172-conformance.test.ts\",\"line\":40,\"text\":\"    const result = await runScript({ workspace: tempDir, code: 'const x: number = 42; x + params.added', params: { added: 8 }, timeoutMs: 3000 });\"},{\"file\":\"test/spec-172-conformance.test.ts\",\"line\":45,\"text\":\"    await assert.rejects(runScript({ workspace: tempDir, code: 'const x: number =;', params: {}, timeoutMs: 3000 }), /Sandbox failed|validation/i);\"},{\"file\":\"test/spec-172-conformance.test.ts\",\"line\":46,\"text\":\"    await assert.rejects(runScript({ workspace: tempDir, code: 'while(true) {}', params: {}, timeoutMs: 200 }), /abort|timeout|Terminated/i);\"},{\"file\":\"test/spec-172-conformance.test.ts\",\"line\":50,\"text\":\"    await assert.rejects(runScript({ workspace: tempDir, code: 'x'.repeat(33000), params: {}, timeoutMs: 1000 }), /Invalid sandbox input/);\"},{\"file\":\"test/spec-172-conformance.test.ts\",\"line\":51,\