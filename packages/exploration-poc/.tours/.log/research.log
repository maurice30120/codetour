: { contextLines: 5 }, getGitDiff: { revision2: 'HEAD' } };\",\"          const params = { ...(defaults[call.name as keyof typeof defaults] ?? {}), ...args };\",\"          const execution = await runScript({ workspace: root, code: expressions[call.name], params, strict: true, includeTrace: true, timeoutMs: Math.min(5000, Math.max(1, limits.durationMs - (Date.now() - startedMs))) });\",\"          let value = execution.value;\",\"          // Direct model-facing reads show absolute line numbers. The sandbox\",\"          // primitive contract used by procedures keeps its original string[].\",\"          if ((call.name === 'readLines' || call.name === 'readAround') && value && typeof value === 'object') {\",\"            const read = value as { file: string; start: number; lines: string[] };\",\"            value = { ...read, lines: read.lines.map((text, index) => ({ line: read.start + index, text })) };\",\"          }\",\"          output = boundedOutput(value, { revision: await resolveRevision(), sourceTruncated: execution.trace.truncated, primitiveDerived: true });\",\"        }\",\"        else if (call.name === 'list') output = await tools.list();\",\"        else if (call.name === 'search' && typeof call.arguments.query === 'string') output = await tools.search(call.arguments.query);\",\"        else if (call.name === 'read' && typeof call.arguments.file === 'string') {\",\"          const start = Number(call.arguments.startLine ?? 1);\",\"          output = await tools.read(call.arguments.file, start, Number(call.arguments.endLine ?? start + 99));\",\"        }\",\"        else if (call.name === 'git') output = await tools.git(limits.durationMs - (Date.now() - startedMs));\",\"        else if (library && call.name === 'memory_list') {\",\"          const listed = library.memory_list(typeof call.arguments.query === 'string' ? call.arguments.query : undefined);\",\"          const available = listed.length === 0 ? library.catalog() : [];\",\"          if (liste