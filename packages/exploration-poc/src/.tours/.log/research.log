}`); }\"},{\"line\":103,\"text\":\"}\"},{\"line\":104,\"text\":\"// Progress is appended as JSON lines next to the output file so a long run can be followed with tail -f.\"},{\"line\":105,\"text\":\"let onProgress: ((event: Record<string, unknown>) => void) | undefined;\"},{\"line\":106,\"text\":\"if (outputFile) {\"},{\"line\":107,\"text\":\"  const progressFile = `${outputFile}.progress`;\"},{\"line\":108,\"text\":\"  await writeFile(progressFile, '');\"},{\"line\":109,\"text\":\"  onProgress = event => appendFileSync(progressFile, `${JSON.stringify(event)}\\\\n`);\"},{\"line\":110,\"text\":\"}\"},{\"line\":111,\"text\":\"const result = await explore({ root, objective, codeMode, memory, budget, model, config, onProgress });\"},{\"line\":112,\"text\":\"await emit(result);\"},{\"line\":113,\"text\":\"} catch (error) {\"},{\"line\":114,\"text\":\"  if ((error as any).lockConflict) { process.stderr.write(`${(error as Error).message}\\\\n`); process.exitCode = 1; }\"},{\"line\":115,\"text\":\"  else {\"},{\"line\":116,\"text\":\"  const failure = ((error as any).exploration) ?? { status: 'failed', error: String((error as Error).message ?? error).slice(0, 500), promptSha256: PROMPT_SHA256, modelConfig: model?.snapshot?.(), metrics: { modelCalls: 0, toolCalls: 0, inputTokens: 0, outputTokens: 0, usageAvailable: false }, callTrace: [] };\"},{\"line\":117,\"text\":\"  try { await emit(failure); }\"},{\"line\":118,\"text\":\"  catch (writeError) { process.stderr.write(`Unable to write output file: ${(writeError as Error).message}\\\\n`); }\"},{\"line\":119,\"text\":\"  process.exitCode = 1;\"},{\"line\":120,\"text\":\"  }\"},{\"line\":121,\"text\":\"} finally {\"},{\"line\":122,\"text\":\"  await releaseLock?.();\"},{\"line\":123,\"text\":\"}\"}],\"nextLine\":null,\"truncatedLines\":[]},\"returned\":1,\"observed\":null,\"truncated\":false,\"bounds\":{\"maxItems\":50,\"maxBytes\":8000},\"bytes\":2400,\"revision\":\"3e8f2aa7da11dd6d26bbb6e3dffde679471c9780\",\"provenance\":\"