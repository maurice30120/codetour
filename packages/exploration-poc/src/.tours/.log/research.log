eak;\n  }\n  return out;\n}"},"result":{"result":[{"file":"cli.ts","line":7,"text":"import { explore } from './explore.ts';"},{"file":"cli.ts","line":12,"text":"import type { Budget, Model } from './explore.ts';"},{"file":"cli.ts","line":111,"text":"const result = await explore({ root, objective, codeMode, memory, budget, model, config, onProgress });"},{"file":"decomposition-prompt.ts","line":4,"text":"export const DECOMPOSITION_PROMPT = 'Investigate the supplied technical question. Treat the initial research plan as a flexible guide: follow new evidence freely without revising or tracking the plan. When memory is enabled, consult memory_list for useful capabilities and run matching procedures with memory_run, verify their evidence, and investigate only what is missing. In Code Mode with memory, use function_try to explore via the provided primitives and propose useful parameterized procedures"},{"file":"explore.ts","line":39,"text":"export async function explore({ root, objective, model, budget = {}, codeMode = false, memory, config = DEFAULT_CONFIG, onProgress }: { onProgress?: (event: Record<string, unknown>) => void; root: string; objective: string; model: Model; budget?: Budget; codeMode?: boolean; memory?: { directory: string }; config?: HarnessConfig }) {"},{"file":"explore.ts","line":173,"text":"          { role: 'user', content: (error as { rawContent?: unknown }).rawContent === '' && metrics.toolCalls === 0 ? 'Your previous response was empty. Use the available tools to explore the repository and gather evidence before returning the required JSON; report any unresolved gaps.' : 'Your final answer was not valid JSON. Your plan block, if any, was already extracted and recorded. Reply again with the final result as a single JSON object matching the required schema, outside any fenced cod"},{"file":"memory.ts","line":260,"text":"      // Note: Actual execution happens in explore.ts via runScript with params."},{"file":"mistral.ts","line":1,"text":"import type