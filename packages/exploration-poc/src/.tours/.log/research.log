:{"status":"passed","timestamp":"2026-11-17T14:53:42.837Z","checks":{"typeChecking":true,"primitiveWhitelist":true,"callTracing":true,"reExecution":false},"notes":["Local technical validation only","No claims of semantic validation","No claims of exhaustiveness"]}},"contract":{"paramsSchema":[{"name":"symbol","type":"string"},{"name":"limit","type":"number | undefined"}],"returns":"{ file: string; line: number; text: string; }[]"},"source":"(params: {symbol: string, limit?: number}) => {\n  const limit = params.limit ?? 3;\n  const byId = searchIdentifiers(params.symbol).map(r => ({file: r.file, line: r.line, text: r.text || ''}));\n  const byText = searchText(params.symbol).map(r => ({file: r.file, line: r.line, text: r.text || ''}));\n  const seen = new Set<string>();\n  const out: {file: string, line: number, text: string}[] = [];\n  for (const r of [...byId, ...byText]) {\n    const key = r.file + ':' + r.line;\n    if (seen.has(key)) continue;\n    seen.add(key);\n    out.push(r);\n    if (out.length >= limit) break;\n  }\n  return out;\n}"},"result":{"result":[{"file":".tours/recherche_configuration_memoire.tour","line":8,"text":"      \"description\": \"Le harnais de recherche CodeTour aide une personne à explorer du code et à retrouver des références de fichiers. Ce parcours suit le chargement de sa configuration, le lancement d’une recherche et la résolution d’une fonction mémorisée ; il ne décrit pas l’ensemble de l’extension CodeTour.\\n\\n**Diagram — Context view**\\n```mermaid\\nflowchart LR\\n U[\\\"Personne : explore du code\\\"] -->|\\\"pose une question par CLI\\\"| S[\\\"Harnais de recherche CodeTour\\\"]\\n S -->|\\\"envoie des re"},{"file":".tours/recherche_configuration_memoire.tour","line":30,"text":"      \"description\": \"La CLI passe à `explore` la racine, la question, le modèle, les budgets et les options de mémoire. Elle attend le résultat avant de l’émettre ; lorsque le fichier de sortie est configuré, un callback écrit aussi la progress