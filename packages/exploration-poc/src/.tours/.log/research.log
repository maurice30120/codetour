s/config.json holds every setting; CLI options override it per run. Only the API key may also come from the environment.\"},{\"line\":94,\"text\":\"const config = await loadConfig(root);\"},{\"line\":95,\"text\":\"const effectiveTemperature = temperature ?? config.mistral.temperature;\"},{\"line\":96,\"text\":\"if (!Number.isFinite(effectiveTemperature) || effectiveTemperature < 0 || effectiveTemperature > 1) throw new Error('Temperature must be between 0 and 1');\"},{\"line\":97,\"text\":\"model = mistral(process.env.MISTRAL_API_KEY || config.mistral.apiKey, modelName ?? config.mistral.model, { ...config.mistral, temperature: effectiveTemperature });\"},{\"line\":98,\"text\":\"if (codeMode) {\"},{\"line\":99,\"text\":\"  // Exercise the real sandbox before starting a model run, including QuickJS and TypeScript.\"},{\"line\":100,\"text\":\"  const { runScript } = await import('codetour-exploration-sandbox');\"}]"}],"options":{"maxOutputTokens":16384,"codeMode":true,"memory":false}}
