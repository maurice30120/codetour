.query)', searchIdentifiers: 'searchIdentifiers(params.identifier)',"},{"line":248,"text":"            readLines: 'readLines(params.file, params.startLine, params.endLine)', readLineFragment: 'readLineFragment(params.file, params.line, params.offset)', readAround: 'readAround(params.file, params.line, params.contextLines)',"},{"line":249,"text":"            listSymbols: 'listSymbols()', findDefinitions: 'findDefinitions(params.symbol)', findReferences: 'findReferences(params.symbol)',"},{"line":250,"text":"            getImports: 'getImports(params.file)', getGitDiff: 'getGitDiff(params.revision1, params.revision2)'"},{"line":251,"text":"          };"},{"line":252,"text":"          const defaults = { listFiles: { maxFiles: 500 }, readAround: { contextLines: 5 }, getGitDiff: { revision2: 'HEAD' } };"},{"line":253,"text":"          // Models often send start/end instead of startLine/endLine; the"},{"line":254,"text":"          // typed expression would otherwise fail identically on every retry."},{"line":255,"text":"          if (call.name === 'readLines') {"},{"line":256,"text":"            if (args.startLine === undefined && args.start !== undefined) args.startLine = args.start;"},{"line":257,"text":"            if (args.endLine === undefined && args.end !== undefined) args.endLine = args.end;"},{"line":258,"text":"            delete args.start;"},{"line":259,"text":"            delete args.end;"},{"line":260,"text":"          }"},{"line":261,"text":"          const params = { ...(defaults[call.name as keyof typeof defaults] ?? {}), ...args };"},{"line":262,"text":"          const execution = await runScript({ workspace: root, code: expressions[call.name], params, strict: true, includeTrace: true, timeoutMs: Math.min(scriptTimeoutMs, Math.max(1, limits.durationMs - (Date.now() - startedMs))) });"},{"line":263,"text":"          let value = execution.value;"},{"line":264,"text":"          // Direct model-facing reads show absolute line numbers. The sandbox"},{"line":265,"text":"          // primitive contract used by procedures keeps its original string[]."},{"line":266,"text":"          if ((call.name === 'readLines' || call.name === 'readAround') && value && typeof value === 'object') {"},{"line":267,"text":"            const read = value as { file: string; start: number; lines: string[] };"},{"line":268,"text":"            value = { ...read, lines: read.lines.map((text, index) => ({ line: read.start + index, text })) };"},{"line":269,"text":"          }"},{"line":270,"text":"          const revision = await resolveRevision();"},{"line":271,"text":"          const bounded = () => boundedOutput(value, { maxItems: config.memoryOutput.maxItems, maxBytes: config.memoryOutput.maxBytes, revision, sourceTruncated: execution.trace.truncated, primitiveDerived: true });"},{"line":272,"text":"          if ((call.name === 'readLines' || call.name === 'readLineFragment') && value && typeof value === 'object') {"},{"line":273,"text":"            const page = value as { start?: number; lines?: Array<{ line: number; text: string }>; nextLine?: number | null; truncatedLines?: number[]; offset?: number; content?: string; nextOffset?: number | null };"},{"line":274,"text":"            while (bounded().truncated || Buffer.byteLength(JSON.stringify(bounded())) > config.context.maxResultBytes) {"},{"line":275,"text":"              if (call.name === 'readLines' && page.lines?.length) {"},{"line":276,"text":"                if (page.lines.length > 1) {"},{"line":277,"text":"                  page.nextLine = page.lines.pop()!.line;"},{"line":278,"text":"                  page.truncatedLines = page.truncatedLines?.filter(line => line < page.nextLine!);"},{"line":279,"text":"                } else if (page.lines[0].text.length > 500) {"},{"line":280,"text":"                  let end = 500;"},{"line":281,"text":"                  const text = page.lines[0].text;"},{"line":282,"text":"                  if (/[\\uD800-\\uDBFF]/.test(text[end - 1]) && /[\\uDC00-\\uDFFF]/.test(text[end])) end--;"},{"line":283,"text":"                  page.lines[0].text = text.slice(0, end);"},{"line":284,"text":"                  page.truncatedLines = [...new Set([...(page.truncatedLines ?? []), page.lines[0].line])];"}],"nextLine":285,"truncatedLines":[]},"returned":1,"observed":null,"truncated":false,"bounds":{"maxItems":50,"maxBytes":8000},"bytes":5646,"revision":"3e8f2aa7da11dd6d26bbb6e3dffde679471c9780","provenance":"primitive-derived","uncertainty":["Primitive matches provide syntactic evidence, not semantic certainty or proof of absence."]},"inputTokens":null,"outputTokens":null,"usageMissing":false,"outcome":"keys=result,returned,observed,truncated","runId":"c88e1464-9a2b-4068-b37d-c2074b8fda66","seq":12,"startedAt":"2026-11-17T14:14:57.813Z","endedAt":"2026-11-17T14:14:58.013Z","durationMs":200},{"type":"model","name":"model","maxOutputTokens":16384,"inputTokens":9948,"outputTokens":212,"usageMissing":false,"runId":"c88e1464-9a2b-4068-b37d-c2074b8fda66","seq":13,"startedAt":"2026-11-17T14:14:58.015Z","endedAt":"2026-11-17T14:15:00.394Z","durationMs":2379},{"type":"tool","name":"searchText","callId":"chatcmpl-tool-a2740525113632da","parameters":{"query":"memory_run"},"result":{"result":[{"file":"decomposition-prompt.ts","line":4,"text":"export const DECOMPOSITION_PROMPT = 'Investigate the supplied technical question. Treat the initial research plan as a flexible guide: follow new evidence freely without revising or tracking the plan. When memory is enabled, consult memory_list for useful capabilities and run matching procedures with memory_run, verify their evidence, and investigate only what is missing. In Code Mode with memory, use function_try to explore via the provided primitives and propose useful parameterized procedures. Do not recreate equivalent procedures or nest memorized procedures. Do not write a Tour. Return sourced findings and explicit uncertainties.';"},{"file":"exploration-helpers.ts","line":28,"text":"  type: 'model' | 'tool' | 'memory_run' | 'memory_list' | 'function_try' | 'decomposition_plan' | 'decomposition_decision' | 'run_end';"},{"file":"exploration-helpers.ts","line":50,"text":"  /** Per-call reuse outcome of a stored procedure (memory_run only). */"},{"file":"explore.ts","line":237,"text":"      let scriptCall: { type: 'memory_run' | 'function_try'; name: string } | undefined;"},{"file":"explore.ts","line":326,"text":"        else if (codeMode && ((call.name === 'code' && typeof call.arguments.code === 'string') || (call.name === 'function_try' && typeof call.arguments.source === 'string') || (library && call.name === 'memory_run' && typeof call.arguments.id === 'string'))) {"},{"file":"explore.ts","line":327,"text":"          const stored = call.name === 'memory_run' ? library?.get(String(call.arguments.id)) : undefined;"},{"file":"explore.ts","line":328,"text":"          if (call.name === 'memory_run' && !stored) throw new Error('Unknown script');"},{"file":"explore.ts","line":337,"text":"          scriptCall = { type: stored ? 'memory_run' : 'function_try', name: stored ? stored.id : 'function_try' };"},{"file":"explore.ts","line":339,"text":"          // Ticket #191: any memory_run/function_try call — accepted or failed —"},{"file":"explore.ts","line":360,"text":"            // Compact, structured, bounded, sourced output for memory_run AND function_try."},{"file":"explore.ts","line":414,"text":"            recordCall({ type: scriptCall?.type ?? 'function_try', name: call.name === 'memory_run' ? String(call.arguments.id ?? call.name) : 'function_try', callId: call.id, questionId, parameters: stored ? { id: stored.id, params } : undefined, inputTokens: null, outputTokens: null, usageMissing: false, error: String(error) }, runStarted, new Date());"},{"file":"explore.ts","line":430,"text":"        : call.name === 'memory_run' ? { id: call.arguments.id, params: call.arguments.params }"},{"file":"explore.ts","line":480,"text":"  const memoryInstructions = library ? ` Script memory is enabled. memory_list(query) returns the catalogue WITHOUT function source code: id (TypeScript identifier), objective (canonical question), description (scope), typed params, output contract, limits and uncertainty cases. Available entries: ${JSON.stringify(library.catalog())}. If a listed function can help, call memory_run with its id and suitable params, verify its proofs, and complete only what is missing. The permanent primitives (listFiles, searchText, searchIdentifiers, readLines, readLineFragment, readAround, listSymbols, findDefinitions, findReferences, getImports, getGitDiff) are available as direct tools: use them for simple reads and searches. Before concluding, run at least one function_try that composes several primitives or filters their results into structured, cited evidence for this question: it is the only way a reusable procedure can reach memory. Use a TypeScript function expression with typed inputs; the harness passes params to it. searchText(query) returns {file,line,text}[], readLines(file,start,end) returns {file,start,lines,nextLine,truncatedLines}; continue with nextLine and the same end, and recover truncated lines with readLineFragment(file,line,offset), starting at offset 0 and continuing with nextOffset. listFiles() returns paths. Give useful procedures a valid TypeScript identifier and parameterize variations. When a stored procedure fails or is unusable for its declared subject, you may submit a corrected function_try under its existing id only if its purpose and contract remain unchanged; otherwise use a new name. Supply question as a stable canonical question independent of this Tour and a non-empty English description (ASCII only: no accented characters, even when the question is in French) stating what the procedure does, its scope, the shape of its result and its key limits. Every successfully executed function_try trial is automatically submitted to post-Tour selection —"},{"file":"explore.ts","line":771,"text":"  if (library && metrics.functionTries + metrics.memoryReuses === 0) progress('memory_unused', { note: 'memory enabled but no function_try or memory_run was attempted: nothing can be consolidated' });"},{"file":"memory-output.ts","line":3,"text":" * calls (memory_run / function_try)."},{"file":"memory.ts","line":257,"text":"    memory_run: (id: string, params: Record<string, unknown> = {}) => {"},{"file":"mistral.ts","line":27,"text":"      { type: 'function', function: { name: 'memory_run', description: 'Run a stored script with new parameters against the current workspace.', parameters: { type: 'object', properties: { id: { type: 'string' }, params: { type: 'object' } }, required: ['id', 'params'] } } },"},{"file":"mistral.ts","line":89,"text":"          ? { id: call.id, name: 'memory_run', arguments: { id: named.id, params: Object.fromEntries(named.parameters.filter(parameter => args[parameter] !== undefined).map(parameter => [parameter, args[parameter]])) } }"}],"returned":18,"observed":18,"truncated":false,"bounds":{"maxItems":50,"maxBytes":8000},"bytes":5752,"revision":"3e8f2aa7da11dd6d26bbb6e3dffde679471c9780","provenance":"primitive-derived","uncertainty":["Primitive matches provide syntactic evidence, not semantic certainty or proof of absence."]},"inputTokens":null,"outputTokens":null,"usageMissing":false,"outcome":"keys=result,returned,observed,truncated","runId":"c88e1464-9a2b-4068-b37d-c2074b8fda66","seq":14,"startedAt":"2026-11-17T14:15:00.395Z","endedAt":"2026-11-17T14:15:00.618Z","durationMs":223},{"type":"tool","name":"searchText","callId":"chatcmpl-tool-a87c51829a44e787","parameters":{"query":"function scriptMemory"},"result":{"result":[{"file":"memory.ts","line":169,"text":"export async function scriptMemory(root: string, directory: string) {"}],"returned":1,"observed":1,"truncated":false,"bounds":{"maxItems":50,"maxBytes":8000},"bytes":112,"revision":"3e8f2aa7da11dd6d26bbb6e3dffde679471c9780","provenance":"primitive-derived","uncertainty":["Primitive matches provide syntactic evidence, not semantic certainty or proof of absence."]},"inputTokens":null,"outputTokens":null,"usageMissing":false,"outcome":"keys=result,returned,observed,truncated","runId":"c88e1464-9a2b-4068-b37d-c2074b8fda66","seq":15,"startedAt":"2026-11-17T14:15:00.618Z","endedAt":"2026-11-17T14:15:00.818Z","durationMs":200},{"type":"model","name":"model","maxOutputTokens":16384,"inputTokens":11499,"outputTokens":27,"usageMissing":false,"runId":"c88e1464-9a2b-4068-b37d-c2074b8fda66","seq":16,"startedAt":"2026-11-17T14:15:00.819Z","endedAt":"2026-11-17T14:15:02.878Z","durationMs":2059},{"type":"tool","name":"readLines","callId":"chatcmpl-tool-82e54b701e3b6f37","parameters":{"endLine":330,"file":"memory.ts","startLine":160},"result":{"result":{"file":"memory.ts","start":160,"lines":[{"line":160,"text":"  // Same question + same scope: the contract decides."},{"line":161,"text":"  const candidateContract = candidate.returns ? norm(candidate.returns) : undefined;"},{"line":162,"text":"  const entryContract = entry.outputContract?.returns ? norm(entry.outputContract.returns) : undefined;"},{"line":163,"text":"  if (candidateContract && entryContract) return candidateContract === entryContract ? 'duplicate' : 'distinct';"},{"line":164,"text":"  // Missing contract information on either side: comparison is indeterminate."},{"line":165,"text":"  return 'indeterminate';"},{"line":166,"text":"}"},{"line":167,"text":""},{"line":168,"text":"/** Local experimental store. The file name derives from the real repository path. */"},{"line":169,"text":"export async function scriptMemory(root: string, directory: string) {"},{"line":170,"text":"  const repo = await realpath(root);"},{"line":171,"text":"  const targetDirectory = resolve(directory);"},{"line":172,"text":"  const relativeDirectory = relative(repo, targetDirectory);"},{"line":173,"text":"  const insideWorkspace = relativeDirectory !== '..' && !relativeDirectory.startsWith(`..${sep}`) && !isAbsolute(relativeDirectory);"},{"line":174,"text":"  const ensureDirectory = async (path: string) => {"},{"line":175,"text":"    try {"},{"line":176,"text":"      const info = await lstat(path);"},{"line":177,"text":"      if (info.isSymbolicLink() || !info.isDirectory()) throw new Error(`Unsafe memory directory: ${path}`);"},{"line":178,"text":"    } catch (error: any) {"},{"line":179,"text":"      if (error?.code !== 'ENOENT') throw error;"},{"line":180,"text":"      await mkdir(path);"},{"line":181,"text":"    }"},{"line":182,"text":"  };"},{"line":183,"text":"  if (insideWorkspace) {"},{"line":184,"text":"    let current = repo;"},{"line":185,"text":"    for (const part of relativeDirectory.split(sep).filter(Boolean)) {"},{"line":186,"text":"      current = join(current, part);"},{"line":187,"text":"      await ensureDirectory(current);"},{"line":188,"text":"    }"},{"line":189,"text":"  } else {"},{"line":190,"text":"    await mkdir(targetDirectory, { recursive: true });"},{"line":191,"text":"    await ensureDirectory(targetDirectory);"},{"line":192,"text":"  }"},{"line":193,"text":"  const rejectSymlink = async (path: string) => {"},{"line":194,"text":"    try { if ((await lstat(path)).isSymbolicLink()) throw new Error(`Unsafe memory file: ${path}`); }"},{"line":195,"text":"    catch (error: any) { if (error?.code !== 'ENOENT') throw error; }"},{"line":196,"text":"  };"},{"line":197,"text":"  const file = join(directory, `${digest(repo)}.json`);"},{"line":198,"text":"  await rejectSymlink(file);"},{"line":199,"text":"  let entries: Entry[];"},{"line":200,"text":"  try { entries = z.array(entrySchema).parse(JSON.parse(await readFile(file, 'utf8'))); }"},{"line":201,"text":"  catch (error: any) { if (error?.code === 'ENOENT') entries = []; else throw new Error('Invalid script memory'); }"},{"line":202,"text":"  const persist = async () => {"},{"line":203,"text":"    await rejectSymlink(file);"},{"line":204,"text":"    const temporary = `${file}.${process.pid}.${randomUUID()}.tmp`;"},{"line":205,"text":"    await writeFile(temporary, JSON.stringify(entries), { mode: 0o600 });"},{"line":206,"text":"    await rename(temporary, file);"},{"line":207,"text":"  };"},{"line":208,"text":"  const functionDirectory = join(directory, 'functions');"},{"line":209,"text":"  const writeFunction = async (entry: Entry) => {"},{"line":210,"text":"    await ensureDirectory(functionDirectory);"},{"line":211,"text":"    const escapeComment = (value: string) => value.replace(/\\*\\//g, '* /').replace(/[\\r\\n]+/g, ' ');"},{"line":212,"text":"    const description = escapeComment(entry.description);"},{"line":213,"text":"    const params = entry.paramsSchema.map(p => ` * @param ${escapeComment(p.name)} ${escapeComment(p.description ?? p.type)}`).join('\\n');"},{"line":214,"text":"    const limits = entry.uncertaintyCases.map(c => `${c.case}: ${c.signal}`).join('; ') || 'Bounded by the workspace sandbox and output limits.';"},{"line":215,"text":"    const source = `/**\\n * ${description}\\n * @question ${escapeComment(entry.objective)}\\n${params ? params + '\\n' : ''} * @returns ${escapeComment(entry.outputContract?.returns ?? 'See the function result.')}\\n * @remarks ${escapeComment(limits)}\\n */\\nexport const ${entry.id} = ${entry.code};\\n`;"},{"line":216,"text":"    const target = join(functionDirectory, `${entry.id}.ts`);"},{"line":217,"text":"    const temporary = `${target}.${process.pid}.${randomUUID()}.tmp`;"},{"line":218,"text":"    await writeFile(temporary, source, { mode: 0o600 });"},{"line":219,"text":"    await rename(temporary, target);"},{"line":220,"text":"  };"},{"line":221,"text":""},{"line":222,"text":"  // Full catalogue projection WITHOUT the function source: id, canonical"},{"line":223,"text":"  // question, scope, typed params, output contract, limits, uncertainty"},{"line":224,"text":"  // cases (issue #174 complement: no source leakage through memory_list)."},{"line":225,"text":"  const project = (entry: Entry) => ({"},{"line":226,"text":"    id: entry.id,"},{"line":227,"text":"    objective: entry.objective,"},{"line":228,"text":"    description: entry.description,"},{"line":229,"text":"    parameters: entry.parameters,"},{"line":230,"text":"    paramsSchema: entry.paramsSchema,"},{"line":231,"text":"    outputContract: entry.outputContract,"},{"line":232,"text":"    limits: entry.limits,"},{"line":233,"text":"    uncertaintyCases: entry.uncertaintyCases,"},{"line":234,"text":"    revision: entry.revision,"},{"line":235,"text":"  });"},{"line":236,"text":""},{"line":237,"text":"  // In-session traces only: the catalogue is NEVER mutated mid-run"},{"line":238,"text":"  // (correction 3). Failure/reuse traces are applied in finish()."},{"line":239,"text":"  const sessionFailures: string[] = [];"},{"line":240,"text":""},{"line":241,"text":""},{"line":242,"text":"  return {"},{"line":243,"text":"    /** Catalogue without sources (public projection). */"},{"line":244,"text":"    catalog: () => entries.map(project),"}],"nextLine":245,"truncatedLines":[]},"returned":1,"observed":null,"truncated":false,"bounds":{"maxItems":50,"maxBytes":8000},"bytes":6270,"revision":"3e8f2aa7da11dd6d26bbb6e3dffde679471c9780","provenance":"primitive-derived","uncertainty":["Primitive matches provide syntactic evidence, not semantic certainty or proof of absence."]},"inputTokens":null,"outputTokens":null,"usageMissing":false,"outcome":"keys=result,returned,observed,truncated","runId":"c88e1464-9a2b-4068-b37d-c2074b8fda66","seq":17,"startedAt":"2026-11-17T14:15:02.879Z","endedAt":"2026-11-17T14:15:03.099Z","durationMs":220},{"type":"model","name":"model","maxOutputTokens":16384,"inputTokens":13281,"outputTokens":28,"usageMissing":false,"runId":"c88e1464-9a2b-4068-b37d-c2074b8fda66","seq":18,"startedAt":"2026-11-17T14:15:03.100Z","endedAt":"2026-11-17T14:15:04.601Z","durationMs":1501},{"type":"tool","name":"readLines","callId":"chatcmpl-tool-946863b578896315","parameters":{"endLine":330,"file":"memory.ts","startLine":244},"result":{"result":{"file":"memory.ts","start":244,"lines":[{"line":244,"text":"    catalog: () => entries.map(project),"},{"line":245,"text":"    /** memory_list with query support (spec #172 G0 requirement). */"},{"line":246,"text":"    memory_list: (query?: string) => {"},{"line":247,"text":"      if (!query) return entries.map(project);"},{"line":248,"text":"      const lowerQuery = query.toLowerCase();"},{"line":249,"text":"      const haystack = (entry: Entry) => [entry.objective, entry.description, entry.outputContract?.returns ?? '', ...entry.parameters, entry.id].join('\\n').toLowerCase();"},{"line":250,"text":"      return entries.filter(entry => haystack(entry).includes(lowerQuery)).map(project);"},{"line":251,"text":"    },"},{"line":252,"text":"    /** Record an in-run failure trace (applied to the catalogue at finish). */"},{"line":253,"text":"    recordFailure: (id: string) => { sessionFailures.push(id); },"},{"line":254,"text":"    /** Peek at stored entry (source included; for execution wiring only). */"},{"line":255,"text":"    get: (id: string) => entries.find(entry => entry.id === id),"},{"line":256,"text":"    sources: () => Object.fromEntries(entries.map(({ id, code }) => [id, code])),"},{"line":257,"text":"    memory_run: (id: string, params: Record<string, unknown> = {}) => {"},{"line":258,"text":"      const entry = entries.find(item => item.id === id);"},{"line":259,"text":"      if (!entry) throw new Error('Unknown script');"},{"line":260,"text":"      // Note: Actual execution happens in explore.ts via runScript with params."},{"line":261,"text":"      return { id, code: entry.code, params, outputContract: entry.outputContract, revision: entry.revision };"},{"line":262,"text":"    },"},{"line":263,"text":"    async finish(successIds: string[], candidates: ConsolidationCandidate[]): Promise<ConsolidationReport> {"},{"line":264,"text":"      const report: ConsolidationReport = { accepted: [], rejected: [], duplicates: [], indeterminate: [], reconciliation: [] };"},{"line":265,"text":"      // Observation and failures stay in the run trace; they are not usage history."},{"line":266,"text":"      void successIds;"},{"line":267,"text":"      for (const candidate of candidates) {"},{"line":268,"text":"        const canonical = `${candidate.name ?? ''}`;"},{"line":269,"text":"        const recordOutcome = (accepted: boolean, reason?: string): void => {"},{"line":270,"text":"          report.reconciliation.push({ name: canonical, proposed: true, replayed: candidate.replay?.ok === true, accepted, ...(reason ? { reason } : {}) });"},{"line":271,"text":"        };"},{"line":272,"text":"        // Gate: only consolidate EXECUTED, proven, contract-respecting candidates from a validated Tour."},{"line":273,"text":"        const signal = candidate.consolidationSignal;"},{"line":274,"text":"        if (!candidate.verified) {"},{"line":275,"text":"          report.rejected.push({ name: canonical, reason: 'Non-executed or unverified candidate: only procedures actually executed during a validated Tour may be consolidated' });"},{"line":276,"text":"          recordOutcome(false, report.rejected.at(-1)!.reason);"},{"line":277,"text":"          continue;"},{"line":278,"text":"        }"},{"line":279,"text":"        if (!signal || !signal.executedSuccessfully || !signal.proofAvailable || !signal.contractRespected) {"},{"line":280,"text":"          report.rejected.push({ name: canonical, reason: 'Consolidation signal missing: execution status success + structural proof availability + contract respected are all required' });"},{"line":281,"text":"          recordOutcome(false, report.rejected.at(-1)!.reason);"},{"line":282,"text":"          continue;"},{"line":283,"text":"        }"},{"line":284,"text":"        // Gate: canonical naming (camelCase verb+domain+object)."},{"line":285,"text":"        const naming = validateCanonicalName(candidate.name);"},{"line":286,"text":"        if (!naming.ok) {"},{"lin