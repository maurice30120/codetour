essage}`); }"},{"line":103,"text":"}"},{"line":104,"text":"// Progress is appended as JSON lines next to the output file so a long run can be followed with tail -f."},{"line":105,"text":"let onProgress: ((event: Record<string, unknown>) => void) | undefined;"},{"line":106,"text":"if (outputFile) {"},{"line":107,"text":"  const progressFile = `${outputFile}.progress`;"},{"line":108,"text":"  await writeFile(progressFile, '');"},{"line":109,"text":"  onProgress = event => appendFileSync(progressFile, `${JSON.stringify(event)}\\n`);"},{"line":110,"text":"}"},{"line":111,"text":"const result = await explore({ root, objective, codeMode, memory, budget, model, config, onProgress });"},{"line":112,"text":"await emit(result);"},{"line":113,"text":"} catch (error) {"},{"line":114,"text":"  if ((error as any).lockConflict) { process.stderr.write(`${(error as Error).message}\\n`); process.exitCode = 1; }"},{"line":115,"text":"  else {"}],"nextLine":116,"truncatedLines":[]},"returned":1,"observed":null,"truncated":false,"bounds":{"maxItems":50,"maxBytes":8000},"bytes":2651,"revision":"3e8f2aa7da11dd6d26bbb6e3dffde679471c9780","provenance":"primitive-derived","uncertainty":["Primitive matches provide syntactic evidence, not semantic certainty or proof of absence."]},"inputTokens":null,"outputTokens":null,"usageMissing":false,"outcome":"keys=result,returned,observed,truncated","runId":"8fe415d1-951e-45ab-95b2-5bbe6b5ed617","seq":17,"startedAt":"2026-11-17T14:53:52.031Z","endedAt":"2026-11-17T14:53:52.255Z","durationMs":224}}
