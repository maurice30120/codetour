ral.ts';\"},{\"line\":9,\"text\":\"import { loadConfig } from './config.ts';\"},{\"line\":10,\"text\":\"import { PROMPT_SHA256 } from './decomposition-prompt.ts';\"},{\"line\":11,\"text\":\"import { summarize } from './summary.ts';\"},{\"line\":12,\"text\":\"import type { Budget, Model } from './explore.ts';\"},{\"line\":13,\"text\":\"\"},{\"line\":14,\"text\":\"let model: Model | undefined;\"},{\"line\":15,\"text\":\"let outputFile: string | undefined;\"},{\"line\":16,\"text\":\"const emit = async (value: unknown) => {\"},{\"line\":17,\"text\":\"  const json = `${JSON.stringify(value, null, 2)}\\\\n`;\"},{\"line\":18,\"text\":\"  if (outputFile) {\"},{\"line\":19,\"text\":\"    await writeFile(outputFile, json);\"},{\"line\":20,\"text\":\"    process.stdout.write(`${JSON.stringify(summarize(value, outputFile))}\\\\n`);\"},{\"line\":21,\"text\":\"  } else process.stdout.write(json);\"},{\"line\":22,\"text\":\"};\"},{\"line\":23,\"text\":\"let releaseLock: (() => Promise<void>) | undefined;\"},{\"line\":24,\"text\":\"// Refuses a second run on the same output file while the first process is alive; stale locks of dead pids are replaced.\"},{\"line\":25,\"text\":\"const acquireLock = async (root: string, file: string) => {\"},{\"line\":26,\"text\":\"  const target = resolve(file);\"},{\"line\":27,\"text\":\"  const dir = join(root, '.tours', '.log', 'locks');\"},{\"line\":28,\"text\":\"  const lock = join(dir, `${createHash('sha256').update(target).digest('hex')}.lock`);\"},{\"line\":29,\"text\":\"  await mkdir(dir, { recursive: true });\"},{\"line\":30,\"text\":\"  for (let attempt = 0; ; attempt++) {\"},{\"line\":31,\"text\":\"    try { await writeFile(lock, JSON.stringify({ pid: process.pid, outputFile: target, startedAt: Date.now() }), { flag: 'wx' }); break; }\"},{\"line\":32,\"text\":\"    catch (error) {\"},{\"line\":33,\"text\":\"      if ((error as NodeJS.ErrnoException).code !== 'EEXIST') throw error;\"},{\"line\":34,\"text\":\"      const pid = Number(JSON.p