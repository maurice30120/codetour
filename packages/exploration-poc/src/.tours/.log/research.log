ed && !execution.trace.truncated) scratchRaw = raw;\"},{\"line\":373,\"text\":\"            // The description is kept whole: a deterministic gate at consolidation\"},{\"line\":374,\"text\":\"            // refuses off-format or oversized descriptions with a precise reason\"},{\"line\":375,\"text\":\"            // instead of silently truncating them (issue #187).\"},{\"line\":376,\"text\":\"            const description = typeof call.arguments.description === 'string' ? call.arguments.description.trim() : '';\"},{\"line\":377,\"text\":\"            const name = typeof call.arguments.name === 'string' ? call.arguments.name.trim().slice(0, 100) : '';\"},{\"line\":378,\"text\":\"            const returns = typeof call.arguments.returns === 'string' ? call.arguments.returns.trim().slice(0, 300) : undefined;\"},{\"line\":379,\"text\":\"            // Surface the description gate now, while the model can still resubmit.\"},{\"line\":380,\"text\":\"            if (library && !stored && !citationFailure && output && typeof output === 'object') {\"},{\"line\":381,\"text\":\"              const descriptionCheck = validateDescription(description);\"},{\"line\":382,\"text\":\"              if (!descriptionCheck.ok) output = { ...(output as Record<string, unknown>), descriptionWarning: `${descriptionCheck.reason} Resubmit this function_try with a corrected ASCII-only English description or the trial will be refused at consolidation.` };\"},{\"line\":383,\"text\":\"            }\"},{\"line\":384,\"text\":\"            // Issue #194: every successfully-executed strict function_try trial\"},{\"line\":385,\"text\":\"            // is automatically submitted to post-Tour selection — the model\"},{\"line\":386,\"text\":\"            // never has to flag it with remember. Failed trials (the sandbox\"},{\"line\":387,\"text\":\"            // throw above) and citation-invalid trials (citationFailure) never\"},{\"line\":388,\"text\":\"            // become candidates; a truncated view is