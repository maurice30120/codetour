';\\\"},{\\\"file\\\":\\\"exploration-helpers.ts\\\",\\\"line\\\":28,\\\"text\\\":\\\"  type: 'model' | 'tool' | 'memory_run' | 'memory_list' | 'function_try' | 'decomposition_plan' | 'decomposition_decision' | 'run_end';\\\"},{\\\"file\\\":\\\"exploration-helpers.ts\\\",\\\"line\\\":50,\\\"text\\\":\\\"  /** Per-call reuse outcome of a stored procedure (memory_run only). */\\\"},{\\\"file\\\":\\\"explore.ts\\\",\\\"line\\\":239,\\\"text\\\":\\\"      let scriptCall: { type: 'memory_run' | 'function_try'; name: string } | undefined;\\\"},{\\\"file\\\":\\\"explore.ts\\\",\\\"line\\\":328,\\\"text\\\":\\\"        else if (codeMode && ((call.name === 'code' && typeof call.arguments.code === 'string') || (call.name === 'function_try' && typeof call.arguments.source === 'string') || (library && call.name === 'memory_run' && typeof call.arguments.id === 'string'))) {\\\"},{\\\"file\\\":\\\"explore.ts\\\",\\\"line\\\":329,\\\"text\\\":\\\"          const stored = call.name === 'memory_run' ? library?.get(String(call.arguments.id)) : undefined;\\\"},{\\\"file\\\":\\\"explore.ts\\\",\\\"line\\\":330,\\\"text\\\":\\\"          if (call.name === 'memory_run' && !stored) throw new Error('Unknown script');\\\"},{\\\"file\\\":\\\"explore.ts\\\",\\\"line\\\":339,\\\"text\\\":\\\"          scriptCall = { type: stored ? 'memory_run' : 'function_try', name: stored ? stored.id : 'function_try' };\\\"},{\\\"file\\\":\\\"explore.ts\\\",\\\"line\\\":341,\\\"text\\\":\\\"          // Ticket #191: any memory_run/function_try call — accepted or failed —\\\"},{\\\"file\\\":\\\"explore.ts\\\",\\\"line\\\":362,\\\"text\\\":\\\"            // Compact, structured, bounded, sourced output for memory_run AND function_try.\\\"},{\\\"file\\\":\\\"explore.ts\\\",\\\"line\\\":416,\\\"text\\\":\\\"            recordCall({ type: scriptCall?.type ?? 'function_try', name: call.name === 'memory_run' ? String(call.arguments.id ?? call.name) : 'function_try', callId: call.id, questionId, parameters: stored ?