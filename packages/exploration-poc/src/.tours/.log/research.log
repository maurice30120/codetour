with tail -f."},{"line":105,"text":"let onProgress: ((event: Record<string, unknown>) => void) | undefined;"},{"line":106,"text":"if (outputFile) {"},{"line":107,"text":"  const progressFile = `${outputFile}.progress`;"},{"line":108,"text":"  await writeFile(progressFile, '');"},{"line":109,"text":"  onProgress = event => appendFileSync(progressFile, `${JSON.stringify(event)}\\n`);"},{"line":110,"text":"}"},{"line":111,"text":"const result = await explore({ root, objective, codeMode, memory, budget, model, config, onProgress });"},{"line":112,"text":"await emit(result);"}],"nextLine":null,"truncatedLines":[]},"returned":1,"observed":null,"truncated":false,"bounds":{"maxItems":50,"maxBytes":8000},"bytes":2291,"revision":"3e8f2aa7da11dd6d26bbb6e3dffde679471c9780","provenance":"primitive-derived","uncertainty":["Primitive matches provide syntactic evidence, not semantic certainty or proof of absence."]},"inputTokens":null,"outputTokens":null,"usageMissing":false,"outcome":"keys=result,returned,observed,truncated","runId":"aeaaf87e-950d-495a-b1e1-4fd4c4389ef3","seq":5,"startedAt":"2026-11-17T14:39:44.769Z","endedAt":"2026-11-17T14:39:44.990Z","durationMs":221}}
