xItems, maxBytes: config.memoryOutput.maxBytes, revision, sourceTruncated: execution.trace.truncated, primitiveDerived: true });"},{"file":"explore.ts","line":305,"text":"        else if (library && call.name === 'memory_list') {"},{"file":"explore.ts","line":306,"text":"          const listed = library.memory_list(typeof call.arguments.query === 'string' ? call.arguments.query : undefined);"},{"file":"explore.ts","line":317,"text":"        else if (library && call.name === 'memory_unusable' && typeof call.arguments.id === 'string') {"},{"file":"explore.ts","line":326,"text":"        else if (codeMode && ((call.name === 'code' && typeof call.arguments.code === 'string') || (call.name === 'function_try' && typeof call.arguments.source === 'string') || (library && call.name === 'memory_run' && typeof call.arguments.id === 'string'))) {"},{"file":"explore.ts","line":327,"text":"          const stored = call.name === 'memory_run' ? library?.get(String(call.arguments.id)) : undefined;"},{"file":"explore.ts","line":328,"text":"          if (call.name === 'memory_run' && !stored) throw new Error('Unknown script');"},{"file":"explore.ts","line":337,"text":"          scriptCall = { type: stored ? 'memory_run' : 'function_try', name: stored ? stored.id : 'function_try' };"},{"file":"explore.ts","line":339,"text":"          // Ticket #191: any memory_run/function_try call — accepted or failed —"},{"file":"explore.ts","line":346,"text":"              metrics.memoryReuses++;"},{"file":"explore.ts","line":360,"text":"            // Compact, structured, bounded, sourced output for memory_run AND function_try."},{"file":"explore.ts","line":361,"text":"            const bounded = boundedOutput(raw, { revision: await resolveRevision(), maxItems: stored?.limits?.maxItems ?? config.memoryOutput.maxItems, maxBytes: stored?.limits?.maxBytes ?? config.memoryOutput.maxBytes, sourceTruncated: execution.trace.truncated, primitiveDerived: execution.trace.executedCalls.length > 0 });"},{"file"