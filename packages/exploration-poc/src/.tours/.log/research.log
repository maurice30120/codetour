IG)) throw new Error(`Unknown section ${key}`);\\\"},{\\\"line\\\":47,\\\"text\\\":\\\"  const input = raw as Record<string, unknown>;\\\"},{\\\"line\\\":48,\\\"text\\\":\\\"  const config = Object.fromEntries(Object.entries(DEFAULT_CONFIG).map(([section, defaults]) => [section, merge(defaults, input[section], section)])) as HarnessConfig;\\\"},{\\\"line\\\":49,\\\"text\\\":\\\"  for (const [section, values] of Object.entries(config)) {\\\"},{\\\"line\\\":50,\\\"text\\\":\\\"    for (const [key, value] of Object.entries(values)) {\\\"},{\\\"line\\\":51,\\\"text\\\":\\\"      if (typeof value === 'number' && (!Number.isFinite(value) || value <= 0) && !(section === 'mistral' && ['temperature', 'maxRetries'].includes(key) && value >= 0) && !(section === 'context' && key === 'keepToolResults' && value >= 0)) throw new Error(`${section}.${key} must be a positive number`);\\\"},{\\\"line\\\":52,\\\"text\\\":\\\"    }\\\"},{\\\"line\\\":53,\\\"text\\\":\\\"  }\\\"},{\\\"line\\\":54,\\\"text\\\":\\\"  if (config.mistral.temperature > 1) throw new Error('Temperature must be between 0 and 1');\\\"},{\\\"line\\\":55,\\\"text\\\":\\\"  if (!Number.isSafeInteger(config.limits.memorySynthesisAttemp\",\"note\":\"Full result available via readScratch with resultId chatcmpl-tool-984dc0b74e0c2626 and offset 0; cite original sources.\"}"}],"options":{"maxOutputTokens":16384,"codeMode":true,"memory":false}}
