,"errors":[],"proofs":[],"revision":"","durationMs":109,"validation":{"typeChecking":{"valid":true,"errors":[]},"primitiveWhitelist":{"valid":true,"violations":[]},"reExecutionVerified":false,"documentation":{"status":"passed","timestamp":"2026-11-17T14:39:45.170Z","checks":{"typeChecking":true,"primitiveWhitelist":true,"callTracing":true,"reExecution":false},"notes":["Local technical validation only","No claims of semantic validation","No claims of exhaustiveness"]}},"contract":{"paramsSchema":[{"name":"symbol","type":"string"},{"name":"limit","type":"number | undefined"}],"returns":"{ file: string; line: number; text: string; }[]"},"source":"(params: {symbol: string, limit?: number}) => {\n  const limit = params.limit ?? 3;\n  const byId = searchIdentifiers(params.symbol).map(r => ({file: r.file, line: r.line, text: r.text || ''}));\n  const byText = searchText(params.symbol).map(r => ({file: r.file, line: r.line, text: r.text || ''}));\n  const seen = new Set<string>();\n  const out: {file: string, line: number, text: string}[] = [];\n  for (const r of [...byId, ...byText]) {\n    const key = r.file + ':' + r.line;\n    if (seen.has(key)) continue;\n    seen.add(key);\n    out.push(r);\n    if (out.length >= limit) break;\n  }\n  return out;\n}"},"result":{"result":[{"file":"cli.ts","line":7,"text":"import { explore } from './explore.ts';"},{"file":"cli.ts","line":12,"text":"import type { Budget, Model } from './explore.ts';"},{"file":"cli.ts","line":111,"text":"const result = await explore({ root, objective, codeMode, memory, budget, model, config, onProgress });"},{"file":"decomposition-prompt.ts","line":4,"text":"export const DECOMPOSITION_PROMPT = 'Investigate the supplied technical question. Treat the initial research plan as a flexible guide: follow new evidence freely without revising or tracking the plan. When memory is enabled, consult memory_list for useful capabilities and run matching procedures with memory_run, verify their evidence, and investigate 