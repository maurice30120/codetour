tions: 100, calls: 400, tokens: 1000000, durationMs: 900000 },"},{"line":21,"text":"  limits: { scriptTimeoutMs: 5000, maxOutputTokens: 16384, planMaxOutputTokens: 4096, memorySynthesisAttempts: 5 },"},{"line":22,"text":"  citations: { maxReferences: 300 },"},{"line":23,"text":"  memoryOutput: { maxItems: 50, maxBytes: 8000 },"},{"line":24,"text":"  log: { size: '10M', maxFiles: 10 },"},{"line":25,"text":"  search: { exclude: ['.tours/research-reports', '.tours/.log', '.tours/.memory', '.tours/.scratch'] },"},{"line":26,"text":"  context: { keepToolResults: 8, maxResultBytes: 8000 }"},{"line":27,"text":"};"},{"line":28,"text":""},{"line":29,"text":"const EFFORTS = ['low', 'medium', 'high', 'max'];"},{"line":30,"text":""},{"line":31,"text":"function merge(defaults: Record<string, any>, overrides: unknown, path: string): any {"},{"line":32,"text":"  if (overrides === undefined) return defaults;"},{"line":33,"text":"  if (!overrides || typeof overrides !== 'object' || Array.isArray(overrides)) throw new Error(`${path} must be an object`);"}],"nextLine":34,"truncatedLines":[]},"returned":1,"observed":null,"truncated":false,"bounds":{"maxItems":50,"maxBytes":8000},"bytes":2677,"revision":"3e8f2aa7da11dd6d26bbb6e3dffde679471c9780","provenance":"primitive-derived","uncertainty":["Primitive matches provide syntactic evidence, not semantic certainty or proof of absence."]},"inputTokens":null,"outputTokens":null,"usageMissing":false,"outcome":"keys=result,returned,observed,truncated","runId":"4ce6b7ad-a280-491f-8aa8-3bce6342de82","seq":5,"startedAt":"2026-11-17T14:35:20.978Z","endedAt":"2026-11-17T14:35:21.206Z","durationMs":228},{"type":"model","name":"model","maxOutputTokens":16384,"inputTokens":4207,"outputTokens":27,"usageMissing":false,"runId":"4ce6b7ad-a280-491f-8aa8-3bce6342de82","seq":6,"startedAt":"2026-11-17T14:35:21.207Z","endedAt":"2026-11-17T14:35:26.086Z","durationMs":4879},{"type":"tool","name":"readLines","callId":"chatcmpl-tool-8e8bdca450068a52","parameters":