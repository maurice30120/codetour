,"text":"const result = await explore({ root, objective, codeMode, memory, budget, model, config, onProgress });"},{"line":112,"text":"await emit(result);"}],"nextLine":null,"truncatedLines":[]},"returned":1,"observed":null,"truncated":false,"bounds":{"maxItems":50,"maxBytes":8000},"bytes":2291,"revision":"3e8f2aa7da11dd6d26bbb6e3dffde679471c9780","provenance":"primitive-derived","uncertainty":["Primitive matches provide syntactic evidence, not semantic certainty or proof of absence."]},"inputTokens":null,"outputTokens":null,"usageMissing":false,"outcome":"keys=result,returned,observed,truncated","runId":"f3e8dfee-7ee1-4075-b616-68bf2405b280","seq":2,"startedAt":"2026-11-17T14:51:42.601Z","endedAt":"2026-11-17T14:51:42.841Z","durationMs":240},{"type":"model","name":"model","maxOutputTokens":16384,"inputTokens":3349,"outputTokens":1145,"usageMissing":false,"runId":"f3e8dfee-7ee1-4075-b616-68bf2405b280","seq":3,"startedAt":"2026-11-17T14:51:42.844Z","endedAt":"2026-11-17T14:51:57.808Z","durationMs":14964},{"type":"model","name":"memory-synthesis","inputTokens":1967,"outputTokens":1787,"usageMissing":false,"result":{"proposed":true},"runId":"f3e8dfee-7ee1-4075-b616-68bf2405b280","seq":4,"startedAt":"2026-11-17T14:51:57.824Z","endedAt":"2026-11-17T14:52:17.640Z","durationMs":19816},{"type":"model","name":"memory-synthesis","inputTokens":2610,"outputTokens":810,"usageMissing":false,"result":{"proposed":true},"runId":"f3e8dfee-7ee1-4075-b616-68bf2405b280","seq":5,"startedAt":"2026-11-17T14:52:17.641Z","endedAt":"2026-11-17T14:52:22.216Z","durationMs":4575},{"type":"run_end","name":"run_end","inputTokens":10885,"outputTokens":4253,"usageMissing":false,"outcome":"status=complete; stopReason=none","result":{"status":"complete","stopReason":null,"inputTokens":10885,"outputTokens":4253,"modelCalls":5,"toolCalls":1,"durationMs":64314},"runId":"f3e8dfee-7ee1-4075-b616-68bf2405b280","seq":6,"startedAt":"2026-11-17T14:52:22.219Z","endedAt":"2026-11-17T14:52:22.219Z","durationMs":0