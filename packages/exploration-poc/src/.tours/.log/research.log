nst acquireLock = async (root: string, file: string) => {\"},{\"line\":26,\"text\":\"  const target = resolve(file);\"},{\"line\":27,\"text\":\"  const dir = join(root, '.tours', '.log', 'locks');\"},{\"line\":28,\"text\":\"  const lock = join(dir, `${createHash('sha256').update(target).digest('hex')}.lock`);\"},{\"line\":29,\"text\":\"  await mkdir(dir, { recursive: true });\"},{\"line\":30,\"text\":\"  for (let attempt = 0; ; attempt++) {\"},{\"line\":31,\"text\":\"    try { await writeFile(lock, JSON.stringify({ pid: process.pid, outputFile: target, startedAt: Date.now() }), { flag: 'wx' }); break; }\"},{\"line\":32,\"text\":\"    catch (error) {\"},{\"line\":33,\"text\":\"      if ((error as NodeJS.ErrnoException).code !== 'EEXIST') throw error;\"},{\"line\":34,\"text\":\"      const pid = Number(JSON.parse(await readFile(lock, 'utf8').catch(() => '{}')).pid);\"},{\"line\":35,\"text\":\"      let alive = false;\"},{\"line\":36,\"text\":\"      if (Number.isInteger(pid) && pid > 0) {\"}],\"nextLine\":null,\"truncatedLines\":[]},\"returned\":1,\"observed\":null,\"truncated\":false,\"bounds\":{\"maxItems\":50,\"maxBytes\":8000},\"bytes\":2591,\"revision\":\"3e8f2aa7da11dd6d26bbb6e3dffde679471c9780\",\"provenance\":\"primitive-derived\",\"uncertainty\":[\"Primitive matches provide syntactic evidence, not semantic certainty or proof of absence.\"]}"},{"role":"assistant","tool_calls":[{"id":"chatcmpl-tool-912203e2c009e276","type":"function","function":{"name":"readLines","arguments":"{\"endLine\":97,\"file\":\"cli.ts\",\"startLine\":60}"}}]},{"role":"tool","tool_call_id":"chatcmpl-tool-912203e2c009e276","content":"{\"result\":{\"file\":\"cli.ts\",\"start\":60,\"lines\":[{\"line\":60,\"text\":\"while (args[0]?.startsWith('--')) {\"},{\"line\":61,\"text\":\"  const option = args.shift();\"},{\"line\":62,\"text\":\"  if (option === '--code') codeMode = true;\"},{\"line\":63,\"text\":\"  else if (option === '--memory') {\"},{\"line\":64,\"text\":\"    memoryEnabled = true;\"},{\"line\":65,\"text\":\"    // Retain the previous directory argument when it is visibly a path.\"},{\"line\":66,\"text\":\"    if (args[0] && (args[0].startsWith('/') || args[0].startsWith('./') || args[0].startsWith('../'))) legacyMemory = args.shift();\"},{\"line\":67,\"text\":\"  }\"},{\"line\":68,\"text\":\"  else if ((option === '--workspace' || option === '--root') && args[0]) workspacePath = args.shift();\"},{\"line\":69,\"text\":\"  else if (option === '--output-file' && args[0] && !args[0].startsWith('--')) outputFile = args.shift();\"},{\"line\":70,\"text\":\"  else if (option === '--tokens' || option === '--token-budget') budget.tokens = positive(args.shift());\"},{\"line\":71,\"text\":\"  else if (option === '--duration-ms' || option === '--time-budget-ms') budget.durationMs = positive(args.shift());\"},{\"line\":72,\"text\":\"  else if (option === '--iterations') budget.iterations = positive(args.shift());\"},{\"line\":73,\"text\":\"  else if (option === '--calls') budget.calls = positive(args.shift());\"},{\"line\":74,\"text\":\"  else if (option === '--temperature' && args[0] !== undefined) temperature = Number(args.shift());\"},{\"line\":75,\"text\":\"  else if (option === '--model' && args[0]) modelName = args.shift();\"},{\"line\":76,\"text\":\"  else throw new Error('Unknown or incomplete option');\"},{\"line\":77,\"text\":\"}\"},{\"line\":78,\"text\":\"if (!args.length) throw new Error('Usage: codetour-research [--workspace <directory>] [--code] [--memory] [--output-file <path>] [--tokens <n>] [--duration-ms <n>] <question>');\"},{\"line\":79,\"text\":\"// Preserve the old positional workspace form when the first argument is an existing directory.\"},{\"line\":80,\"text\":\"if (!workspacePath && args.length > 1) {\"},{\"line\":81,\"text\":\"  try { if ((await stat(resolve(args[0]))).isDirectory()) workspacePath = args.shift(); } catch { /* question, not a directory */ }\"},{\"line\":82,\"text\":\"}\"},{\"line\":83,\"text\":\"const requestedRoot = resolve(workspacePath ?? process.cwd());\"},{\"line\":84,\"text\":\"const root = await realpath(requestedRoot);\"},{\"line\":85,\"text\":\"if (!(await stat(root)).isDirectory()) throw new Error('Workspace must be a single project directory; select a root explicitly for multi-root workspaces');\"},{\"line\":86,\"text\":\"await access(root, constants.R_OK | constants.W_OK | constants.X_OK);\"},{\"line\":87,\"text\":\"if (outputFile) await acquireLock(root, outputFile);\"}],\"nextLine\":88,\"truncatedLines\":[]},\"returned\":1,\"observed\":null,\"truncated\":false,\"bounds\":{\"maxItems\":50,\"maxBytes\":8000},\"bytes\":2689,\"revision\":\"3e8f2aa7da11dd6d26bbb6e3dffde679471c9780\",\"provenance\":\"primitive-derived\",\"uncertainty\":[\"Primitive matches provide syntactic evidence, not semantic certainty or proof of absence.\"]}"}],"options":{"maxOutputTokens":16384,"codeMode":true,"memory":true}}
