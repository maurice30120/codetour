:\"      consecutiveFailures = failed ? (failureKey === previousFailedCall ? consecutiveFailures + 1 : 1) : 0;\"},{\"line\":434,\"text\":\"      previousFailedCall = failed ? failureKey : undefined;\"},{\"line\":435,\"text\":\"      if (consecutiveFailures === 2) {\"},{\"line\":436,\"text\":\"        output = { ...(output as object), note: 'The same tool call has failed twice. Change the source or parameters, use a different approach, or return a partial result with uncertainties. Do not repeat the same failed call.' };\"},{\"line\":437,\"text\":\"        const guardAt = new Date();\"},{\"line\":438,\"text\":\"        recordCall({ type: 'tool', name: 'repeated_failure_guard', callId: call.id, inputTokens: null, outputTokens: null, usageMissing: false, outcome: 'warning: same tool call failed twice' }, guardAt, guardAt);\"},{\"line\":439,\"text\":\"      }\"},{\"line\":440,\"text\":\"      if (!failed) {\"},{\"line\":441,\"text\":\"        const key = createHash('sha256').update(JSON.stringify(stableValue([call.name, identity, output]))).digest('hex');\"},{\"line\":442,\"text\":\"        const count = (identicalResults.get(key) ?? 0) + 1;\"},{\"line\":443,\"text\":\"        identicalResults.set(key, count);\"},{\"line\":444,\"text\":\"        maxIdenticalResults = Math.max(maxIdenticalResults, count);\"},{\"line\":445,\"text\":\"        if (count === 2) {\"},{\"line\":446,\"text\":\"          const note = 'This exact call already returned the same result. Do not repeat it: change the query or parameters, use a different approach, or conclude with what you have and list the gaps as uncertainties.';\"},{\"line\":447,\"text\":\"          output = Array.isArray(output) ? { results: output, note } : { ...(output as object), note };\"},{\"line\":448,\"text\":\"          const guardAt = new Date();\"},{\"line\":449,\"text\":\"          recordCall({ type: 'tool', name: 'repeated_call_guard', callId: call.id, inputTokens: null, outputTokens: null, usageMissing: false, outcome