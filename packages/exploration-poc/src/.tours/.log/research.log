,{"line":67,"text":""},{"line":68,"text":"/** Issue #187: per-candidate reconciliation log — proposed / replayed / accepted / rejected with reason. */"},{"line":69,"text":"export interface ReconciliationOutcome {"},{"line":70,"text":"  name: string;"},{"line":71,"text":"  /** True when the model proposed (selected) the candidate for consolidation. */"},{"line":72,"text":"  proposed: boolean;"},{"line":73,"text":"  /** True when the deterministic reconciliation re-executed the exact code and params with all citations re-checked. */"},{"line":74,"text":"  replayed: boolean;"},{"line":75,"text":"  accepted: boolean;"},{"line":76,"text":"  reason?: string;"},{"line":77,"text":"}"},{"line":78,"text":""},{"line":79,"text":"export interface ConsolidationCandidate {"},{"line":80,"text":"  objective: string;"},{"line":81,"text":"  description: string;"},{"line":82,"text":"  code: string;"},{"line":83,"text":"  parameters: string[];"},{"line":84,"text":"  paramsSchema?: Array<{ name: string; type: string }>;"},{"line":85,"text":"  executionMode?: 'strict' | 'legacy';"},{"line":86,"text":"  /** TypeScript identifier used as the catalogue key. */"},{"line":87,"text":"  name: string;"},{"line":88,"text":"  /** Output contract declared with the candidate. */"},{"line":89,"text":"  returns?: string;"},{"line":90,"text":"  uncertaintyCases?: Array<{ case: string; signal: string }>;"},{"line":91,"text":"  verified: boolean;"},{"line":92,"text":"  /** Concrete operational consolidation signal (correction 3): never a blind benchmark judge. */"},{"line":93,"text":"  consolidationSignal?: { executedSuccessfully: boolean; proofAvailable: boolean; contractRespected: boolean };"},{"line":94,"text":"  /** Deterministic replay evidence (issue #187): required — no replay, no persistence. */"},{"line":95,"text":"  replay?: ReplayEvidence;"},{"line":96,"text":"  version?: number;"}],"nextLine":97,"truncatedLines":[]},"returned":1,"observed":null,"truncated":false,"bounds":{"maxItems":50,"maxByt