dd(key);\\n    out.push(r);\\n    if (out.length >= limit) break;\\n  }\\n  return out;\\n}\",\"parameters\":[\"limit\",\"symbol\"],\"paramsSchema\":[{\"name\":\"symbol\",\"type\":\"string\"},{\"name\":\"limit\",\"type\":\"number | undefined\"}],\"executionMode\":\"strict\",\"outputContract\":{\"returns\":\"{ file: string; line: number; text: string; }[]\",\"itemFields\":[\"file\",\"line\"],\"bounds\":{\"maxItems\":50,\"maxBytes\":8000}},\"limits\":{\"maxItems\":50,\"maxBytes\":8000},\"uncertaintyCases\":[],\"revision\":\"3e8f2aa7da11dd6d26bbb6e3dffde679471c9780\",\"validated\":true}]"},{"file":".tours/.memory/functions/findSymbolOccurrences.ts","line":11,"text":"  const byId = searchIdentifiers(params.symbol).map(r => ({file: r.file, line: r.line, text: r.text || ''}));"},{"file":"citation-validator.ts","line":56,"text":"/** Per-line excerpt truncation bounds of the permanent primitives (searchText/readLines: 2000, searchIdentifiers/findDefinitions: 500). */"},{"file":"explore.ts","line":254,"text":"            listFiles: 'listFiles(params.maxFiles)', searchText: 'searchText(params.query)', searchIdentifiers: 'searchIdentifiers(params.identifier)',"},{"file":"explore.ts","line":518,"text":"  const memoryInstructions = library ? ` Script memory is enabled. memory_list(query) returns the catalogue WITHOUT function source code: id (TypeScript identifier), objective (canonical question), description (scope), typed params, output contract, limits and uncertainty cases. Available entries: ${JSON.stringify(library.catalog())}. If a listed function can help, call memory_run with its id and suitable params, verify its proofs, and complete only what is missing. The permanent primitives (listFiles, searchText, searchIdentifiers, readLines, readLineFragment, readAround, listSymbols, findDefinitions, findReferences, getImports, getGitDiff) are available as direct tools: use them for simple reads and searches. Before concluding, run at least one function_try that composes several primitives or filters their results into structured, cited evidence for this question: it is the only way a reusable procedure can reach memory. Use a TypeScript function expression with typed inputs; the harness passes params to it. searchText(query) returns {file,line,text}[], readLines(file,start,end) returns {file,start,lines,nextLine,truncatedLines}; continue with nextLine and the same end, and recover truncated lines with readLineFragment(file,line,offset), starting at offset 0 and continuing with nextOffset. listFiles() returns paths. Give useful procedures a valid TypeScript identifier and parameterize variations. When a stored procedure fails or is unusable for its declared subject, you may submit a corrected function_try under its existing id only if its purpose and contract remain unchanged; otherwise use a new name. Supply question as a stable canonical question independent of this Tour and a non-empty English description (ASCII only: no accented characters, even when the question is in French) stating what the procedure does, its scope, the shape of its result and its key limits. Every successfully executed function_try trial is automatically submitted to post-Tour selection —"},{"file":"primitives.ts","line":174,"text":" * searchIdentifiers - Search for exact identifier matches"},{"file":"primitives.ts","line":518,"text":"  searchIdentifiers(identifier: string, options?: SearchIdentifiersOptions): Promise<SearchIdentifiersResult>;"},{"file":"tool-contract.ts","line":7,"text":"  { name: 'searchIdentifiers', description: 'Find exact identifier occurrences', properties: { identifier: string }, required: ['identifier'] },"},{"file":"workspace.ts","line":237,"text":"  // searchIdentifiers - Search for exact identifier matches"},{"file":"workspace.ts","line":240,"text":"  async function searchIdentifiers(identifier: string, options: { limit?: number; offset?: number; pathPrefix?: string } = {}) {"},{"file":"workspace.ts","line":531,"text":"    // For refer