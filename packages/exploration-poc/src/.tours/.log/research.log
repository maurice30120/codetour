"line\":2,\"text\":\"import { join } from 'node:path';\"},{\"line\":3,\"text\":\"\"},{\"line\":4,\"text\":\"export type ReasoningEffort = 'low' | 'medium' | 'high' | 'max';\"},{\"line\":5,\"text\":\"\"},{\"line\":6,\"text\":\"export type HarnessConfig = {\"},{\"line\":7,\"text\":\"  mistral: { apiKey: string; model: string; apiUrl: string; reasoningEffort: ReasoningEffort; temperature: number; maxRetries: number; retryBaseDelayMs: number };\"},{\"line\":8,\"text\":\"  budget: { iterations: number; calls: number; tokens: number; durationMs: number };\"},{\"line\":9,\"text\":\"  limits: { scriptTimeoutMs: number; maxOutputTokens: number; planMaxOutputTokens: number; memorySynthesisAttempts: number };\"},{\"line\":10,\"text\":\"  citations: { maxReferences: number };\"},{\"line\":11,\"text\":\"  memoryOutput: { maxItems: number; maxBytes: number };\"},{\"line\":12,\"text\":\"  log: { size: string; maxFiles: number };\"},{\"line\":13,\"text\":\"  search: { exclude: string[] };\"},{\"line\":14,\"text\":\"  context: { keepToolResults: number; maxResultBytes: number };\"},{\"line\":15,\"text\":\"};\"},{\"line\":16,\"text\":\"\"},{\"line\":17,\"text\":\"// The only place where defaults live; .tours/config.json overrides them section by section.\"},{\"line\":18,\"text\":\"export const DEFAULT_CONFIG: HarnessConfig = {\"},{\"line\":19,\"text\":\"  mistral: { apiKey: '', model: 'mistral-small-latest', apiUrl: 'https://api.mistral.ai/v1/chat/completions', reasoningEffort: 'high', temperature: 0, maxRetries: 3, retryBaseDelayMs: 20000 },\"},{\"line\":20,\"text\":\"  budget: { iterations: 100, calls: 400, tokens: 1000000, durationMs: 900000 },\"},{\"line\":21,\"text\":\"  limits: { scriptTimeoutMs: 5000, maxOutputTokens: 16384, planMaxOutputTokens: 4096, memorySynthesisAttempts: 5 },\"},{\"line\":22,\"text\":\"  citations: { maxReferences: 300 },\"},{\"line\":23,\"text\":\"  memoryOutput: { maxItems: 50, maxBytes: 8000 },\"},{\"line\":24,\"text\":\"  log: { size: '10M', maxFiles: