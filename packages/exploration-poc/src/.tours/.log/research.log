 | undefined;\"},{\"line\":24,\"text\":\"// Refuses a second run on the same output file while the first process is alive; stale locks of dead pids are replaced.\"},{\"line\":25,\"text\":\"const acquireLock = async (root: string, file: string) => {\"},{\"line\":26,\"text\":\"  const target = resolve(file);\"},{\"line\":27,\"text\":\"  const dir = join(root, '.tours', '.log', 'locks');\"},{\"line\":28,\"text\":\"  const lock = join(dir, `${createHash('sha256').update(target).digest('hex')}.lock`);\"},{\"line\":29,\"text\":\"  await mkdir(dir, { recursive: true });\"},{\"line\":30,\"text\":\"  for (let attempt = 0; ; attempt++) {\"},{\"line\":31,\"text\":\"    try { await writeFile(lock, JSON.stringify({ pid: process.pid, outputFile: target, startedAt: Date.now() }), { flag: 'wx' }); break; }\"},{\"line\":32,\"text\":\"    catch (error) {\"},{\"line\":33,\"text\":\"      if ((error as NodeJS.ErrnoException).code !== 'EEXIST') throw error;\"},{\"line\":34,\"text\":\"      const pid = Number(JSON.parse(await readFile(lock, 'utf8').catch(() => '{}')).pid);\"},{\"line\":35,\"text\":\"      let alive = false;\"},{\"line\":36,\"text\":\"      if (Number.isInteger(pid) && pid > 0) {\"}],\"nextLine\":null,\"truncatedLines\":[]},\"returned\":1,\"observed\":null,\"truncated\":false,\"bounds\":{\"maxItems\":50,\"maxBytes\":8000},\"bytes\":2591,\"revision\":\"3e8f2aa7da11dd6d26bbb6e3dffde679471c9780\",\"provenance\":\"primitive-derived\",\"uncertainty\":[\"Primitive matches provide syntactic evidence, not semantic certainty or proof of absence.\"]}"}],"options":{"maxOutputTokens":16384,"codeMode":true,"memory":true}}
