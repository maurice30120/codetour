if (!Number.isSafeInteger(config.limits.memorySynthesisAttempts)) throw new Error('limits.memorySynthesisAttempts must be a positive integer');"},{"line":56,"text":"  if (!Array.isArray(config.search.exclude) || config.search.exclude.some(entry => typeof entry !== 'string' || !entry.trim())) throw new Error('search.exclude must be an array of non-empty strings');"},{"line":57,"text":"  if (!EFFORTS.includes(config.mistral.reasoningEffort)) throw new Error('reasoningEffort must be low, medium, high or max');"},{"line":58,"text":"  return config;"},{"line":59,"text":"}"},{"line":60,"text":""},{"line":61,"text":"/** Load <root>/.tours/config.json; a missing file yields the defaults. */"}],"nextLine":62,"truncatedLines":[]},"returned":1,"observed":null,"truncated":false,"bounds":{"maxItems":50,"maxBytes":8000},"bytes":2660,"revision":"3e8f2aa7da11dd6d26bbb6e3dffde679471c9780","provenance":"primitive-derived","uncertainty":["Primitive matches provide syntactic evidence, not semantic certainty or proof of absence."]},"inputTokens":null,"outputTokens":null,"usageMissing":false,"outcome":"keys=result,returned,observed,truncated","runId":"4ce6b7ad-a280-491f-8aa8-3bce6342de82","seq":7,"startedAt":"2026-11-17T14:35:26.088Z","endedAt":"2026-11-17T14:35:26.306Z","durationMs":218},{"type":"model","name":"model","maxOutputTokens":16384,"inputTokens":5038,"outputTokens":27,"usageMissing":false,"runId":"4ce6b7ad-a280-491f-8aa8-3bce6342de82","seq":8,"startedAt":"2026-11-17T14:35:26.307Z","endedAt":"2026-11-17T14:35:30.554Z","durationMs":4247},{"type":"tool","name":"readLines","callId":"chatcmpl-tool-bdd4171948ece0ac","parameters":{"endLine":110,"file":"config.ts","startLine":61},"result":{"result":{"file":"config.ts","start":61,"lines":[{"line":61,"text":"/** Load <root>/.tours/config.json; a missing file yields the defaults. */"},{"line":62,"text":"export async function loadConfig(root: string): Promise<HarnessConfig> {"},{"line":63,"text":"  let text: string;"},{"line":64,"text":" 