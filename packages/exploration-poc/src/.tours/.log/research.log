new Error('Unknown script');"},{"file":"explore.ts","line":337,"text":"          scriptCall = { type: stored ? 'memory_run' : 'function_try', name: stored ? stored.id : 'function_try' };"},{"file":"explore.ts","line":339,"text":"          // Ticket #191: any memory_run/function_try call — accepted or failed —"},{"file":"explore.ts","line":360,"text":"            // Compact, structured, bounded, sourced output for memory_run AND function_try."},{"file":"explore.ts","line":414,"text":"            recordCall({ type: scriptCall?.type ?? 'function_try', name: call.name === 'memory_run' ? String(call.arguments.id ?? call.name) : 'function_try', callId: call.id, questionId, parameters: stored ? { id: stored.id, params } : undefined, inputTokens: null, outputTokens: null, usageMissing: false, error: String(error) }, runStarted, new Date());"},{"file":"explore.ts","line":430,"text":"        : call.name === 'memory_run' ? { id: call.arguments.id, params: call.arguments.params }"},{"file":"explore.ts","line":480,"text":"  const memoryInstructions = library ? ` Script memory is enabled. memory_list(query) returns the catalogue WITHOUT function source code: id (TypeScript identifier), objective (canonical question), description (scope), typed params, output contract, limits and uncertainty cases. Available entries: ${JSON.stringify(library.catalog())}. If a listed function can help, call memory_run with its id and suitable params, verify its proofs, and complete only what is missing. The permanent primitives (listFiles, searchText, searchIdentifiers, readLines, readLineFragment, readAround, listSymbols, findDefinitions, findReferences, getImports, getGitDiff) are available as direct tools: use them for simple reads and searches. Before concluding, run at least one function_try that composes several primitives or filters their results into structured, cited evidence for this question: it is the only way a reusable procedure can reach memory. Use a TypeScript function expression with typed inputs; the harness passes params to it. searchText(query) returns {file,line,text}[], readLines(file,start,end) returns {file,start,lines,nextLine,truncatedLines}; continue with nextLine and the same end, and recover truncated lines with readLineFragment(file,line,offset), starting at offset 0 and continuing with nextOffset. listFiles() returns paths. Give useful procedures a valid TypeScript identifier and parameterize variations. When a stored procedure fails or is unusable for its declared subject, you may submit a corrected function_try under its existing id only if its purpose and contract remain unchanged; otherwise use a new name. Supply question as a stable canonical question independent of this Tour and a non-empty English description (ASCII only: no accented characters, even when the question is in French) stating what the procedure does, its scope, the shape of its result and its key limits. Every successfully executed function_try trial is automatically submitted to post-Tour selection —"},{"file":"explore.ts","line":771,"text":"  if (library && metrics.functionTries + metrics.memoryReuses === 0) progress('memory_unused', { note: 'memory enabled but no function_try or memory_run was attempted: nothing can be consolidated' });"},{"file":"memory-output.ts","line":3,"text":" * calls (memory_run / function_try)."},{"file":"memory.ts","line":257,"text":"    memory_run: (id: string, params: Record<string, unknown> = {}) => {"},{"file":"mistral.ts","line":27,"text":"      { type: 'function', function: { name: 'memory_run', description: 'Run a stored script with new parameters against the current workspace.', parameters: { type: 'object', properties: { id: { type: 'string' }, params: { type: 'object' } }, required: ['id', 'params'] } } },"},{"file":"mistral.ts","line":89,"text":"          ? { id: call.id, name: 'memory_run', arguments: { id: named.id, params: Object.fromEntries(named.parameters.filter(parameter => args[parameter] !== undefined).map(parameter => [parameter, args[parameter]])) } }"}],"returned":18,"observed":18,"truncated":false,"bounds":{"maxItems":50,"maxBytes":8000},"bytes":5752,"revision":"3e8f2aa7da11dd6d26bbb6e3dffde679471c9780","provenance":"primitive-derived","uncertainty":["Primitive matches provide syntactic evidence, not semantic certainty or proof of absence."]},"inputTokens":null,"outputTokens":null,"usageMissing":false,"outcome":"keys=result,returned,observed,truncated","runId":"c88e1464-9a2b-4068-b37d-c2074b8fda66","seq":14,"startedAt":"2026-11-17T14:15:00.395Z","endedAt":"2026-11-17T14:15:00.618Z","durationMs":223}}
