z.object({\"},{\"line\":26,\"text\":\"  // Concrete case in which the output must not be trusted blindly.\"},{\"line\":27,\"text\":\"  case: z.string().min(1).max(200),\"},{\"line\":28,\"text\":\"  // Explicit signal the caller receives in that case.\"},{\"line\":29,\"text\":\"  signal: z.string().min(1).max(200),\"},{\"line\":30,\"text\":\"});\"},{\"line\":31,\"text\":\"\"},{\"line\":32,\"text\":\"const entrySchema = z.object({\"},{\"line\":33,\"text\":\"  id: z.string().min(1),\"},{\"line\":34,\"text\":\"  objective: z.string().max(500),\"},{\"line\":35,\"text\":\"  description: z.string().max(300),\"},{\"line\":36,\"text\":\"  code: z.string().max(32768),\"},{\"line\":37,\"text\":\"  parameters: z.array(z.string()).max(30),\"},{\"line\":38,\"text\":\"  paramsSchema: z.array(paramSchemaShape).max(30).default([]),\"},{\"line\":39,\"text\":\"  outputContract: outputContractShape.optional(),\"},{\"line\":40,\"text\":\"  limits: z.object({ maxItems: z.number().int().positive().default(50), maxBytes: z.number().int().positive().default(8000) }).optional(),\"},{\"line\":41,\"text\":\"  uncertaintyCases: z.array(uncertaintyCaseShape).max(10).default([]),\"},{\"line\":42,\"text\":\"  revision: z.string().max(64).optional(),\"},{\"line\":43,\"text\":\"  successes: z.number().int().nonnegative().optional(),\"},{\"line\":44,\"text\":\"  failures: z.number().int().nonnegative().optional(),\"},{\"line\":45,\"text\":\"  // G0 requirement: NO inactivity tracking or purge\"},{\"line\":46,\"text\":\"  fingerprint: z.string().optional(),\"},{\"line\":47,\"text\":\"  version: z.number().int().nonnegative().optional(),\"},{\"line\":48,\"text\":\"  replacedBy: z.string().optional(),\"},{\"line\":49,\"text\":\"  variantOf: z.string().optional(),\"},{\"line\":50,\"text\":\"  validated: z.boolean().optional(),\"},{\"line\":51,\"text\":\"  executionMode: z.enum(['strict', 'legacy']).optional(),\"},{\"line\":52,\"text\":\"  referenceCases: z.array(z.object({ params: z.record(z.string(), z.unknown()), ok: z.boolean(), at: z.string() })).max(5).optional()\"},{\"line\":53,\"text\":\"}).passthrough();\"},{\"line\":54,\"text\":\"type Entry = z.infer<typeof entrySchema>;\"},{\"line\":55,\"text\":\"\"},{\"line\":56,\"text\":\"/** Outcome of a catalogue comparison. 'indeterminate' is reported honestly instead of inventing equivalence. */\"},{\"line\":57,\"text\":\"export type ComparisonOutcome = 'duplicate' | 'distinct' | 'indeterminate';\"},{\"line\":58,\"text\":\"\"},{\"line\":59,\"text\":\"export interface ReferenceCase { params: Record<string, unknown>; ok: boolean; at: string }\"},{\"line\":60,\"text\":\"\"},{\"line\":61,\"text\":\"/** Deterministic replay evidence (issue #187): the exact same code and params were re-executed and every citation re-checked. */\"},{\"line\":62,\"text\":\"export interface ReplayEvidence {\"},{\"line\":63,\"text\":\"  ok: boolean;\"},{\"line\":64,\"text\":\"  reason?: string;\"},{\"line\":65,\"text\":\"  citations?: 'valid' | 'no_references' | 'validation_failed';\"},{\"line\":66,\"text\":\"}\"},{\"line\":67,\"text\":\"\"},{\"line\":68,\"text\":\"/** Issue #187: per-candidate reconciliation log — proposed / replayed / accepted / rejected with reason. */\"},{\"line\":69,\"text\":\"export interface ReconciliationOutcome {\"},{\"line\":70,\"text\":\"  name: string;\"},{\"line\":71,\"text\":\"  /** True when the model proposed (selected) the candidate for consolidation. */\"},{\"line\":72,\"text\":\"  proposed: boolean;\"},{\"line\":73,\"text\":\"  /** True when the deterministic reconciliation re-executed the exact code and params with all citations re-checked. */\"},{\"line\":74,\"text\":\"  replayed: boolean;\"},{\"line\":75,\"text\":\"  accepted: boolean;\"},{\"line\":76,\"text\":\"  reason?: string;\"},{\"line\":77,\"text\":\"}\"},{\"line\":78,\"text\":\"\"},{\"line\":79,\"text\":\"export interface ConsolidationCandidate {\"},{\"line\":80,\"text\":\"  objective: string;\"},{\"line\":81,\"text\":\"  description: string;\"},