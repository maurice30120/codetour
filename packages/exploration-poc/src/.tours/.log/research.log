s provide syntactic evidence, not semantic certainty or proof of absence.\"]}},{\"name\":\"readLines\",\"parameters\":{\"endLine\":120,\"file\":\"config.ts\",\"startLine\":34},\"result\":{\"result\":{\"file\":\"config.ts\",\"start\":34,\"lines\":[{\"line\":34,\"text\":\"  const result: Record<string, any> = { ...defaults };\"},{\"line\":35,\"text\":\"  for (const [key, value] of Object.entries(overrides)) {\"},{\"line\":36,\"text\":\"    if (!(key in defaults)) throw new Error(`Unknown setting ${path}.${key}`);\"},{\"line\":37,\"text\":\"    if (typeof defaults[key] !== typeof value) throw new Error(`${path}.${key} must be a ${typeof defaults[key]}`);\"},{\"line\":38,\"text\":\"    result[key] = value;\"},{\"line\":39,\"text\":\"  }\"},{\"line\":40,\"text\":\"  return result;\"},{\"line\":41,\"text\":\"}\"},{\"line\":42,\"text\":\"\"},{\"line\":43,\"text\":\"export function parseConfig(raw: unknown): HarnessConfig {\"},{\"line\":44,\"text\":\"  if (raw === undefined) return DEFAULT_CONFIG;\"},{\"line\":45,\"text\":\"  if (!raw || typeof raw !== 'object' || Array.isArray(raw)) throw new Error('Configuration must be an object');\"},{\"line\":46,\"text\":\"  for (const key of Object.keys(raw)) if (!(key in DEFAULT_CONFIG)) throw new Error(`Unknown section ${key}`);\"},{\"line\":47,\"text\":\"  const input = raw as Record<string, unknown>;\"},{\"line\":48,\"text\":\"  const config = Object.fromEntries(Object.entries(DEFAULT_CONFIG).map(([section, defaults]) => [section, merge(defaults, input[section], section)])) as HarnessConfig;\"},{\"line\":49,\"text\":\"  for (const [section, values] of Object.entries(config)) {\"},{\"line\":50,\"text\":\"    for (const [key, value] of Object.entries(values)) {\"},{\"line\":51,\"text\":\"      if (typeof value === 'number' && (!Number.isFinite(value) || value <= 0) && !(section === 'mistral' && ['temperature', 'maxRetries'].includes(key) && value >= 0) && !(section === 'context' && key === 'keepToolResults' && value >= 0)) throw new Error(`${section}.${key} must be a positive number`);\"},{\"line\":52,\"text\":\"    }\"},{\"line\":53,\"text\":\"  }\"},{\"line\":54,\"text\":\"  if (config.mistral.temperature > 1) throw new Error('Temperature must be between 0 and 1');\"},{\"line\":55,\"text\":\"  if (!Number.isSafeInteger(config.limits.memorySynthesisAttempts)) throw new Error('limits.memorySynthesisAttempts must be a positive integer');\"},{\"line\":56,\"text\":\"  if (!Array.isArray(config.search.exclude) || config.search.exclude.some(entry => typeof entry !== 'string' || !entry.trim())) throw new Error('search.exclude must be an array of non-empty strings');\"},{\"line\":57,\"text\":\"  if (!EFFORTS.includes(config.mistral.reasoningEffort)) throw new Error('reasoningEffort must be low, medium, high or max');\"},{\"line\":58,\"text\":\"  return config;\"},{\"line\":59,\"text\":\"}\"},{\"line\":60,\"text\":\"\"},{\"line\":61,\"text\":\"/** Load <root>/.tours/config.json; a missing file yields the defaults. */\"}],\"nextLine\":62,\"truncatedLines\":[]},\"returned\":1,\"observed\":null,\"truncated\":false,\"bounds\":{\"maxItems\":50,\"maxBytes\":8000},\"bytes\":2660,\"revision\":\"3e8f2aa7da11dd6d26bbb6e3dffde679471c9780\",\"provenance\":\"primitive-derived\",\"uncertainty\":[\"Primitive matches provide syntactic evidence, not semantic certainty or proof of absence.\"]}},{\"name\":\"readLines\",\"parameters\":{\"endLine\":110,\"file\":\"config.ts\",\"startLine\":61},\"result\":{\"result\":{\"file\":\"config.ts\",\"start\":61,\"lines\":[{\"line\":61,\"text\":\"/** Load <root>/.tours/config.json; a missing file yields the defaults. */\"},{\"line\":62,\"text\":\"export async function loadConfig(root: string): Promise<HarnessConfig> {\"},{\"line\":63,\"text\":\"  let text: string;\"},{\"line\":64,\"text\":\"  try { text = await readFile(join(root, '.tours', 'config.json'), 'utf8'); }\"},{\"line\":65,\"text\":\"  catch (error) {\"},{\"line\":66,\"text\":\"    if ((error as NodeJS.ErrnoException).code