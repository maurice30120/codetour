    let attempt: Attempt | undefined;\"},{\"line\":237,\"text\":\"      let scriptCall: { type: 'memory_run' | 'function_try'; name: string } | undefined;\"},{\"line\":238,\"text\":\"      try {\"},{\"line\":239,\"text\":\"        if (call.name === 'readScratch') {\"},{\"line\":240,\"text\":\"          if (typeof call.arguments.resultId !== 'string' || typeof call.arguments.offset !== 'number') throw new Error('resultId and offset are required');\"},{\"line\":241,\"text\":\"          output = scratch.read(call.arguments.resultId, call.arguments.offset);\"},{\"line\":242,\"text\":\"        }\"},{\"line\":243,\"text\":\"        else if (primitiveNames.has(call.name)) {\"},{\"line\":244,\"text\":\"          const { runScript } = await import('codetour-exploration-sandbox');\"},{\"line\":245,\"text\":\"          const args = call.arguments;\"},{\"line\":246,\"text\":\"          const expressions: Record<string, string> = {\"},{\"line\":247,\"text\":\"            listFiles: 'listFiles(params.maxFiles)', searchText: 'searchText(params.query)', searchIdentifiers: 'searchIdentifiers(params.identifier)',\"},{\"line\":248,\"text\":\"            readLines: 'readLines(params.file, params.startLine, params.endLine)', readLineFragment: 'readLineFragment(params.file, params.line, params.offset)', readAround: 'readAround(params.file, params.line, params.contextLines)',\"},{\"line\":249,\"text\":\"            listSymbols: 'listSymbols()', findDefinitions: 'findDefinitions(params.symbol)', findReferences: 'findReferences(params.symbol)',\"},{\"line\":250,\"text\":\"            getImports: 'getImports(params.file)', getGitDiff: 'getGitDiff(params.revision1, params.revision2)'\"},{\"line\":251,\"text\":\"          };\"},{\"line\":252,\"text\":\"          const defaults = { listFiles: { maxFiles: 500 }, readAround: { contextLines: 5 }, getGitDiff: { revision2: 'HEAD' } };\"},{\"line\":253,\"text\":\"          // Models often send start/end instead of startLine/endLine; the\"},{\"line\":254,\"text\":\"          // typed expression would otherwise fail identically on every retry.\"},{\"line\":255,\"text\":\"          if (call.name === 'readLines') {\"},{\"line\":256,\"text\":\"            if (args.startLine === undefined && args.start !== undefined) args.startLine = args.start;\"},{\"line\":257,\"text\":\"            if (args.endLine === undefined && args.end !== undefined) args.endLine = args.end;\"},{\"line\":258,\"text\":\"            delete args.start;\"},{\"line\":259,\"text\":\"            delete args.end;\"},{\"line\":260,\"text\":\"          }\"},{\"line\":261,\"text\":\"          const params = { ...(defaults[call.name as keyof typeof defaults] ?? {}), ...args };\"},{\"line\":262,\"text\":\"          const execution = await runScript({ workspace: root, code: expressions[call.name], params, strict: true, includeTrace: true, timeoutMs: Math.min(scriptTimeoutMs, Math.max(1, limits.durationMs - (Date.now() - startedMs))) });\"},{\"line\":263,\"text\":\"          let value = execution.value;\"},{\"line\":264,\"text\":\"          // Direct model-facing reads show absolute line numbers. The sandbox\"},{\"line\":265,\"text\":\"          // primitive contract used by procedures keeps its original string[].\"},{\"line\":266,\"text\":\"          if ((call.name === 'readLines' || call.name === 'readAround') && value && typeof value === 'object') {\"},{\"line\":267,\"text\":\"            const read = value as { file: string; start: number; lines: string[] };\"},{\"line\":268,\"text\":\"            value = { ...read, lines: read.lines.map((text, index) => ({ line: read.start + index, text })) };\"},{\"line\":269,\"text\":\"          }\"},{\"line\":270,\"text\":\"          const revision = await resolveRevision();\"},{\"line\":271,\"text\":\"          const bounded = () => boundedOutput(value, { maxItems: config.memoryOutput.maxItems, maxBytes: config.memoryOutput.maxBytes, revision, sourceTruncated: execution.trace.truncated, primitiveDerived: true });\"},{\"line\":272,\"text\":\"          if ((call.name === 'readLines' || call.name === 'readLineFragment') && value && typeof value === 'object') {\"},{\"line\":273,\"text\":\"            const page = value as { start?: number; lines?: Array<{ line: number; text: string }>; nextLine?: number | null; truncatedLines?: number[]; offset?: number; content?: string; nextOffset?: number | null };\"},{\"line\":274,\"text\":\"            while (bounded().truncated || Buffer.byteLength(JSON.stringify(bounded())) > config.context.maxResultBytes) {\"},{\"line\":275,\"text\":\"              if (call.name === 'readLines' && page.lines?.length) {\"},{\"line\":276,\"text\":\"                if (page.lines.length > 1) {\"},{\"line\":277,\"text\":\"                  page.nextLine = page.lines.pop()!.line;\"},{\"line\":278,\"text\":\"                  page.truncatedLines = page.truncatedLines?.filter(line => line < page.nextLine!);\"},{\"line\":279,\"text\":\"                } else if (page.lines[0].text.length > 500) {\"},{\"line\":280,\"text\":\"                  let end = 500;\"},{\"line\":281,\"text\":\"                  const text = page.lines[0].text;\"},{\"line\":282,\"text\":\"                  if (/[\\\\uD800-\\\\uDBFF]/.test(text[end - 1]) && /[\\\\uDC00-\\\\uDFFF]/.test(text[end])) end--;\"},{\"line\":283,\"text\":\"                  page.lines[0].text = text.slice(0, end);\"},{\"line\":284,\"text\":\"                  page.truncatedLines = [...new Set([...(page.truncatedLines ?? []), page.lines[0].line])];\"}],\"nextLine\":285,\"truncatedLines\":[]},\"returned\":1,\"observed\":null,\"truncated\":false,\"bounds\":{\"maxItems\":50,\"maxBytes\":8000},\"bytes\":5646,\"revision\":\"3e8f2aa7da11dd6d26bbb6e3dffde679471c9780\",\"provenance\":\"primitive-derived\",\"uncertainty\":[\"Primitive matches provide syntactic evidence, not semantic certainty or proof of absence.\"]}"}],"options":{"maxOutputTokens":16384,"codeMode":true,"memory":true}}
