e\":63,\"text\":\"  let text: string;\"},{\"line\":64,\"text\":\"  try { text = await readFile(join(root, '.tours', 'config.json'), 'utf8'); }\"},{\"line\":65,\"text\":\"  catch (error) {\"},{\"line\":66,\"text\":\"    if ((error as NodeJS.ErrnoException).code === 'ENOENT') return DEFAULT_CONFIG;\"},{\"line\":67,\"text\":\"    throw error;\"},{\"line\":68,\"text\":\"  }\"},{\"line\":69,\"text\":\"  try { return parseConfig(JSON.parse(text)); }\"},{\"line\":70,\"text\":\"  catch (error) { throw new Error(`Invalid .tours/config.json: ${(error as Error).message}`); }\"},{\"line\":71,\"text\":\"}\"}]","offset":0,"nextOffset":null,"totalBytes":5838,"note":"Temporary tool result; cite original source files, not this result."},"inputTokens":null,"outputTokens":null,"usageMissing":false,"outcome":"keys=content,offset,nextOffset,totalBytes","runId":"2f2aab5f-747d-4c30-b49f-b167923ae95c","seq":10,"startedAt":"2026-11-17T14:37:41.200Z","endedAt":"2026-11-17T14:37:41.201Z","durationMs":1}}
