; a missing file yields the defaults. */\"},{\"line\":62,\"text\":\"export async function loadConfig(root: string): Promise<HarnessConfig> {\"},{\"line\":63,\"text\":\"  let text: string;\"},{\"line\":64,\"text\":\"  try { text = await readFile(join(root, '.tours', 'config.json'), 'utf8'); }\"},{\"line\":65,\"text\":\"  catch (error) {\"},{\"line\":66,\"text\":\"    if ((error as NodeJS.ErrnoException).code === 'ENOENT') return DEFAULT_CONFIG;\"},{\"line\":67,\"text\":\"    throw error;\"},{\"line\":68,\"text\":\"  }\"},{\"line\":69,\"text\":\"  try { return parseConfig(JSON.parse(text)); }\"},{\"line\":70,\"text\":\"  catch (error) { throw new Error(`Invalid .tours/config.json: ${(error as Error).message}`); }\"},{\"line\":71,\"text\":\"}\"}],\"nextLine\":null,\"truncatedLines\":[]},\"returned\":1,\"observed\":null,\"truncated\":false,\"bounds\":{\"maxItems\":50,\"maxBytes\":8000},\"bytes\":1441,\"revision\":\"3e8f2aa7da11dd6d26bbb6e3dffde679471c9780\",\"provenance\":\"primitive-derived\",\"uncertainty\":[\"Primitive matches provide syntactic evidence, not semantic certainty or proof of absence.\"]}"},{"role":"assistant","tool_calls":[{"id":"chatcmpl-tool-961bfab3d26116c5","type":"function","function":{"name":"readLines","arguments":"{\"endLine\":54,\"file\":\"config.ts\",\"startLine\":1}"}}]},{"role":"tool","tool_call_id":"chatcmpl-tool-961bfab3d26116c5","content":"{\"result\":{\"file\":\"config.ts\",\"start\":1,\"lines\":[{\"line\":1,\"text\":\"import { readFile } from 'node:fs/promises';\"},{\"line\":2,\"text\":\"import { join } from 'node:path';\"},{\"line\":3,\"text\":\"\"},{\"line\":4,\"text\":\"export type ReasoningEffort = 'low' | 'medium' | 'high' | 'max';\"},{\"line\":5,\"text\":\"\"},{\"line\":6,\"text\":\"export type HarnessConfig = {\"},{\"line\":7,\"text\":\"  mistral: { apiKey: string; model: string; apiUrl: string; reasoningEffort: ReasoningEffort; temperature: number; maxRetries: number; retryBaseDelayMs: number };\"},{\"line\":8,\"text\":\"  budget: { iterations: number; calls: number; tokens: number; durationMs: number };\"},{\"line\":9,\"text\":\"  limits: { scriptTimeoutMs: number; maxOutputTokens: number; planMaxOutputTokens: number; memorySynthesisAttempts: number };\"},{\"line\":10,\"text\":\"  citations: { maxReferences: number };\"},{\"line\":11,\"text\":\"  memoryOutput: { maxItems: number; maxBytes: number };\"},{\"line\":12,\"text\":\"  log: { size: string; maxFiles: number };\"},{\"line\":13,\"text\":\"  search: { exclude: string[] };\"},{\"line\":14,\"text\":\"  context: { keepToolResults: number; maxResultBytes: number };\"},{\"line\":15,\"text\":\"};\"},{\"line\":16,\"text\":\"\"},{\"line\":17,\"text\":\"// The only place where defaults live; .tours/config.json overrides them section by section.\"},{\"line\":18,\"text\":\"export const DEFAULT_CONFIG: HarnessConfig = {\"},{\"line\":19,\"text\":\"  mistral: { apiKey: '', model: 'mistral-small-latest', apiUrl: 'https://api.mistral.ai/v1/chat/completions', reasoningEffort: 'high', temperature: 0, maxRetries: 3, retryBaseDelayMs: 20000 },\"},{\"line\":20,\"text\":\"  budget: { iterations: 100, calls: 400, tokens: 1000000, durationMs: 900000 },\"},{\"line\":21,\"text\":\"  limits: { scriptTimeoutMs: 5000, maxOutputTokens: 16384, planMaxOutputTokens: 4096, memorySynthesisAttempts: 5 },\"},{\"line\":22,\"text\":\"  citations: { maxReferences: 300 },\"},{\"line\":23,\"text\":\"  memoryOutput: { maxItems: 50, maxBytes: 8000 },\"},{\"line\":24,\"text\":\"  log: { size: '10M', maxFiles: 10 },\"},{\"line\":25,\"text\":\"  search: { exclude: ['.tours/research-reports', '.tours/.log', '.tours/.memory', '.tours/.scratch'] },\"},{\"line\":26,\"text\":\"  context: { keepToolResults: 8, maxResultBytes: 8000 }\"},{\"line\":27,\"text\":\"};\"},{\"line\":28,\"text\":\"\"},{\"line\":29,\"text\":\"const EFFORTS = ['low', 'medium', 'high', 'max'];\"},{\"line\":30,\"text\":\"\"},{\"line\":31,\"text\":\"function merge(defaults: Record<string, any>, overrides: unknown, path: string): any {\"},{\"line\":32,\"text\":\"  if (overrides === undefined) return defaults;\"},{\"line\":33,\"text\":\"  if (!overrides || typeof overrides !== 'object' || Array.isArray(overrides)) throw new Error(`${path} must be an object`);\"}],\"nextLine\":34,\"truncatedLines\":[]},\"returned\":1,\"observed\":null,\"truncated\":false,\"bounds\":{\"maxItems\":50,\"maxBytes\":8000},\"bytes\":2677,\"revision\":\"3e8f2aa7da11dd6d26bbb6e3dffde679471c9780\",\"provenance\":\"primitive-derived\",\"uncertainty\":[\"Primitive matches provide syntactic evidence, not semantic certainty or proof of absence.\"]}"},{"role":"assistant","tool_calls":[{"id":"chatcmpl-tool-a618e620cd123a77","type":"function","function":{"name":"readLines","arguments":"{\"endLine\":54,\"file\":\"config.ts\",\"startLine\":34}"}}]},{"role":"tool","tool_call_id":"chatcmpl-tool-a618e620cd123a77","content":"{\"result\":{\"file\":\"config.ts\",\"start\":34,\"lines\":[{\"line\":34,\"text\":\"  const result: Record<string, any> = { ...defaults };\"},{\"line\":35,\"text\":\"  for (const [key, value] of Object.entries(overrides)) {\"},{\"line\":36,\"text\":\"    if (!(key in defaults)) throw new Error(`Unknown setting ${path}.${key}`);\"},{\"line\":37,\"text\":\"    if (typeof defaults[key] !== typeof value) throw new Error(`${path}.${key} must be a ${typeof defaults[key]}`);\"},{\"line\":38,\"text\":\"    result[key] = value;\"},{\"line\":39,\"text\":\"  }\"},{\"line\":40,\"text\":\"  return result;\"},{\"line\":41,\"text\":\"}\"},{\"line\":42,\"text\":\"\"},{\"line\":43,\"text\":\"export function parseConfig(raw: unknown): HarnessConfig {\"},{\"line\":44,\"text\":\"  if (raw === undefined) return DEFAULT_CONFIG;\"},{\"line\":45,\"text\":\"  if (!raw || typeof raw !== 'object' || Array.isArray(raw)) throw new Error('Configuration must be an object');\"},{\"line\":46,\"text\":\"  for (const key of Object.keys(raw)) if (!(key in DEFAULT_CONFIG)) throw new Error(`Unknown section ${key}`);\"},{\"line\":47,\"text\":\"  const input = raw as Record<string, unknown>;\"},{\"line\":48,\"text\":\"  const config = Object.fromEntries(Object.entries(DEFAULT_CONFIG).map(([section, defaults]) => [section, merge(defaults, input[section], section)])) as HarnessConfig;\"},{\"line\":49,\"text\":\"  for (const [section, values] of Object.entries(config)) {\"},{\"line\":50,\"text\":\"    for (const [key, value] of Object.entries(values)) {\"},{\"line\":51,\"text\":\"      if (typeof value === 'number' && (!Number.isFinite(value) || value <= 0) && !(section === 'mistral' && ['temperature', 'maxRetries'].includes(key) && value >= 0) && !(section === 'context' && key === 'keepToolResults' && value >= 0)) throw new Error(`${section}.${key} must be a positive number`);\"},{\"line\":52,\"text\":\"    }\"},{\"line\":53,\"text\":\"  }\"},{\"line\":54,\"text\":\"  if (config.mistral.temperature > 1) throw new Error('Temperature must be between 0 and 1');\"}],\"nextLine\":null,\"truncatedLines\":[]},\"returned\":1,\"observed\":null,\"truncated\":false,\"bounds\":{\"maxItems\":50,\"maxBytes\":8000},\"bytes\":1947,\"revision\":\"3e8f2aa7da11dd6d26bbb6e3dffde679471c9780\",\"provenance\":\"primitive-derived\",\"uncertainty\":[\"Primitive matches provide syntactic evidence, not semantic certainty or proof of absence.\"]}"}],"options":{"maxOutputTokens":16384,"codeMode":true,"memory":true}}
