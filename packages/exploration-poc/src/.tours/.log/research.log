/ Concrete case in which the output must not be trusted blindly.\"},{\"line\":27,\"text\":\"  case: z.string().min(1).max(200),\"},{\"line\":28,\"text\":\"  // Explicit signal the caller receives in that case.\"},{\"line\":29,\"text\":\"  signal: z.string().min(1).max(200),\"},{\"line\":30,\"text\":\"});\"},{\"line\":31,\"text\":\"\"},{\"line\":32,\"text\":\"const entrySchema = z.object({\"},{\"line\":33,\"text\":\"  id: z.string().min(1),\"},{\"line\":34,\"text\":\"  objective: z.string().max(500),\"},{\"line\":35,\"text\":\"  description: z.string().max(300),\"},{\"line\":36,\"text\":\"  code: z.string().max(32768),\"},{\"line\":37,\"text\":\"  parameters: z.array(z.string()).max(30),\"},{\"line\":38,\"text\":\"  paramsSchema: z.array(paramSchemaShape).max(30).default([]),\"},{\"line\":39,\"text\":\"  outputContract: outputContractShape.optional(),\"},{\"line\":40,\"text\":\"  limits: z.object({ maxItems: z.number().int().positive().default(50), maxBytes: z.number().int().positive().default(8000) }).optional(),\"},{\"line\":41,\"text\":\"  uncertaintyCases: z.array(uncertaintyCaseShape).max(10).default([]),\"},{\"line\":42,\"text\":\"  revision: z.string().max(64).optional(),\"},{\"line\":43,\"text\":\"  successes: z.number().int().nonnegative().optional(),\"},{\"line\":44,\"text\":\"  failures: z.number().int().nonnegative().optional(),\"},{\"line\":45,\"text\":\"  // G0 requirement: NO inactivity tracking or purge\"},{\"line\":46,\"text\":\"  fingerprint: z.string().optional(),\"},{\"line\":47,\"text\":\"  version: z.number().int().nonnegative().optional(),\"},{\"line\":48,\"text\":\"  replacedBy: z.string().optional(),\"},{\"line\":49,\"text\":\"  variantOf: z.string().optional(),\"},{\"line\":50,\"text\":\"  validated: z.boolean().optional(),\"},{\"line\":51,\"text\":\"  executionMode: z.enum(['strict', 'legacy']).optional(),\"},{\"line\":52,\"text\":\"  referenceCases: z.array(z.object({ params: z.record(z.string(), z.unknown()), ok: z.boolean(), at: z.string() })).max(5).optional()\"},{\"line\":53,\"text\":\"}).passthrough();\"},{\"line\":54,\"text\":\"type Entry = z.infer<typeof entrySchema>;\"},{\"line\":55,\"text\":\"\"},{\"line\":56,\"text\":\"/** Outcome of a catalogue comparison. 'indeterminate' is reported honestly instead of inventing equivalence. */\"},{\"line\":57,\"text\":\"export type ComparisonOutcome = 'duplicate' | 'distinct' | 'indeterminate';\"},{\"line\":58,\"text\":\"\"},{\"line\":59,\"text\":\"export interface ReferenceCase { params: Record<string, unknown>; ok: boolean; at: string }\"},{\"line\":60,\"text\":\"\"},{\"line\":61,\"text\":\"/** Deterministic replay evidence (issue #187): the exact same code and params were re-executed and every citation re-checked. */\"},{\"line\":62,\"text\":\"export interface ReplayEvidence {\"},{\"line\":63,\"text\":\"  ok: boolean;\"},{\"line\":64,\"text\":\"  reason?: string;\"},{\"line\":65,\"text\":\"  citations?: 'valid' | 'no_references' | 'validation_failed';\"},{\"line\":66,\"text\":\"}\"},{\"line\":67,\"text\":\"\"},{\"line\":68,\"text\":\"/** Issue #187: per-candidate reconciliation log — proposed / replayed / accepted / rejected with reason. */\"},{\"line\":69,\"text\":\"export interface ReconciliationOutcome {\"},{\"line\":70,\"text\":\"  name: string;\"},{\"line\":71,\"text\":\"  /** True when the model proposed (selected) the candidate for consolidation. */\"},{\"line\":72,\"text\":\"  proposed: boolean;\"},{\"line\":73,\"text\":\"  /** True when the deterministic reconciliation re-executed the exact code and params with all citations re-checked. */\"},{\"line\":74,\"text\":\"  replayed: boolean;\"},{\"line\":75,\"text\":\"  accepted: boolean;\"},{\"line\":76,\"text\":\"  reason?: string;\"},{\"line\":77,\"text\":\"}\"},{\"line\":78,\"text\":\"\"},{\"line\":79,\"text\":\"export interface ConsolidationCandidate {\"},{\"line\":80,\"text\":\"  objective: string;\"},{\"line\":81,\"text\":\"  description: string;\"},{\"line\":82,\"text\":\"  code: string;\"},{\"line\":83,\"text\":\"  parameters: string[];\"},{\"line\":84,\"text\":\"  paramsSchema?: Array<{ name: string; type: string }>;\"},{\"line\":85,\"text\":\"  executionMode?: 'strict' | 'legacy';\"},{\"line\":86,\"text\":\"  /** TypeScript identifier used as the catalogue key. */\"},{\"line\":87,\"text\":\"  name: string;\"},{\"line\":88,\"text\":\"  /** Output contract declared with the candidate. */\"},{\"line\":89,\"text\":\"  returns?: string;\"},{\"line\":90,\"text\":\"  uncertaintyCases?: Array<{ case: string; signal: string }>;\"},{\"line\":91,\"text\":\"  verified: boolean;\"},{\"line\":92,\"text\":\"  /** Concrete operational consolidation signal (correction 3): never a blind benchmark judge. */\"},{\"line\":93,\"text\":\"  consolidationSignal?: { executedSuccessfully: boolean; proofAvailable: boolean; contractRespected: boolean };\"},{\"line\":94,\"text\":\"  /** Deterministic replay evidence (issue #187): required — no replay, no persistence. */\"},{\"line\":95,\"text\":\"  replay?: ReplayEvidence;\"},{\"line\":96,\"text\":\"  version?: number;\"}],\"nextLine\":97,\"truncatedLines\":[]},\"returned\":1,\"observed\":null,\"truncated\":false,\"bounds\":{\"maxItems\":50,\"maxBytes\":8000},\"bytes\":6372,\"revision\":\"3e8f2aa7da11dd6d26bbb6e3dffde679471c9780\",\"provenance\":\"primitive-derived\",\"uncertainty\":[\"Primitive matches provide syntactic evidence, not semantic certainty or proof of absence.\"]}"},{"role":"tool","tool_call_id":"chatcmpl-tool-989c7b726205e90a","content":"{\"result\":{\"file\":\"explore.ts\",\"start\":230,\"lines\":[{\"line\":230,\"text\":\"      metrics.toolCalls++;\"},{\"line\":231,\"text\":\"      const toolStarted = new Date();\"},{\"line\":232,\"text\":\"      let output: unknown;\"},{\"line\":233,\"text\":\"      let scratchRaw: unknown;\"},{\"line\":234,\"text\":\"      let sourceIncomplete = false;\"},{\"line\":235,\"text\":\"      let failed = false;\"},{\"line\":236,\"text\":\"      let attempt: Attempt | undefined;\"},{\"line\":237,\"text\":\"      let scriptCall: { type: 'memory_run' | 'function_try'; name: string } | undefined;\"},{\"line\":238,\"text\":\"      try {\"},{\"line\":239,\"text\":\"        if (call.name === 'readScratch') {\"},{\"line\":240,\"text\":\"          if (typeof call.arguments.resultId !== 'string' || typeof call.arguments.offset !== 'number') throw new Error('resultId and offset are required');\"},{\"line\":241,\"text\":\"          output = scratch.read(call.arguments.resultId, call.arguments.offset);\"},{\"line\":242,\"text\":\"        }\"},{\"line\":243,\"text\":\"        else if (primitiveNames.has(call.name)) {\"},{\"line\":244,\"text\":\"          const { runScript } = await import('codetour-exploration-sandbox');\"},{\"line\":245,\"text\":\"          const args = call.arguments;\"},{\"line\":246,\"text\":\"          const expressions: Record<string, string> = {\"},{\"line\":247,\"text\":\"            listFiles: 'listFiles(params.maxFiles)', searchText: 'searchText(params.query)', searchIdentifiers: 'searchIdentifiers(params.identifier)',\"},{\"line\":248,\"text\":\"            readLines: 'readLines(params.file, params.startLine, params.endLine)', readLineFragment: 'readLineFragment(params.file, params.line, params.offset)', readAround: 'readAround(params.file, params.line, params.contextLines)',\"},{\"line\":249,\"text\":\"            listSymbols: 'listSymbols()', findDefinitions: 'findDefinitions(params.symbol)', findReferences: 'findReferences(params.symbol)',\"},{\"line\":250,\"text\":\"            getImports: 'getImports(params.file)', getGitDiff: 'getGitDiff(params.revision1, params.revision2)'\"},{\"line\":251,\"text\":\"          };\"},{\"line\":252,\"text\":\"          const defaults = { listFiles: { maxFiles: 500 }, readAround: { contextLines: 5 }, getGitDiff: { revision2: 'HEAD' } };\"},{\"line\":253,\"text\":\"          // Models often send start/end instead of startLine/endLine; the\"},{\"line\":254,\"text\":\"          // typed expression would otherwise fail identically on every retry.\"},{\"line\":255,\"text\":\"          if (call.name === 'readLines') {\"},{\"line\":256,\"text\":\"            if (args.startLine === undefined && args.start !== undefined) args.startLine = args.start;\"},{\"line\":257,\"text\":\"            if (args.endLine === undefined && args.end !== undefined) args.endLine = args.end;\"},{\"line\":258,\"text\":\"            delete args.start;\"},{\"line\":259,\"text\":\"            delete args.end;\"},{\"line\":260,\"text\":\"          }\"},{\"line\":261,\"text\":\"          const params = { ...(defaults[call.name as keyof typeof defaults] ?? {}), ...args };\"},{\"line\":262,\"text\":\"          const execution = await runScript({ workspace: root, code: expressions[call.name], params, strict: true, includeTrace: true, timeoutMs: Math.min(scriptTimeoutMs, Math.max(1, limits.durationMs - (Date.now() - startedMs))) });\"},{\"line\":263,\"text\":\"          let value = execution.value;\"},{\"line\":264,\"text\":\"          // Direct model-facing reads show absolute line numbers. The sandbox\"},{\"line\":265,\"text\":\"          // primitive contract used by procedures keeps its original string[].\"},{\"line\":266,\"text\":\"          if ((call.name === 'readLines' || call.name === 'readAround') && value && typeof value === 'object') {\"},{\"line\":267,\"text\":\"            const read = value as { file: string; start: number; lines: string[] };\"},{\"line\":268,\"text\":\"            value = { ...read, lines: read.lines.map((text, index) => ({ line: read.start + index, text })) };\"},{\"line\":269,\"text\":\"          }\"},{\"line\":270,\"text\":\"          const revision = await resolveRevision();\"},{\"line\":271,\"text\":\"          const bounded = () => boundedOutput(value, { maxItems: config.memoryOutput.maxItems, maxBytes: config.memoryOutput.maxBytes, revision, sourceTruncated: execution.trace.truncated, primitiveDerived: true });\"},{\"line\":272,\"text\":\"          if (