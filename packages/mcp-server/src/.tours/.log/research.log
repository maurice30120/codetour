type":"number | undefined"}],"returns":"{ file: string; line: number; text: string; }[]"},"source":"(params: {symbol: string, limit?: number}) => {\n  const limit = params.limit ?? 3;\n  const byId = searchIdentifiers(params.symbol).map(r => ({file: r.file, line: r.line, text: r.text || ''}));\n  const byText = searchText(params.symbol).map(r => ({file: r.file, line: r.line, text: r.text || ''}));\n  const seen = new Set<string>();\n  const out: {file: string, line: number, text: string}[] = [];\n  for (const r of [...byId, ...byText]) {\n    const key = r.file + ':' + r.line;\n    if (seen.has(key)) continue;\n    seen.add(key);\n    out.push(r);\n    if (out.length >= limit) break;\n  }\n  return out;\n}"},"result":{"result":[{"file":".tours/architecture_serveur_mcp.tour","line":30,"text":"      \"description\": \"`writeTourAtomic` vérifie que le répertoire résolu reste dans le workspace, écrit un fichier temporaire dans ce répertoire et synchronise son contenu. Un renommage remplace ensuite la cible ; si le renommage échoue, le temporaire est supprimé.\\n\\nCe code n’établit pas à lui seul la durabilité après tous les types de panne ni la coordination de plusieurs processus.\","},{"file":".tours/architecture_serveur_mcp.tour","line":32,"text":"      \"pattern\": \"export async function writeTourAtomic\\\\(\""},{"file":"persistence.ts","line":13,"text":"export async function writeTourAtomic("}],"returned":3,"observed":3,"truncated":false,"bounds":{"maxItems":50,"maxBytes":8000},"bytes":695,"revision":"3e8f2aa7da11dd6d26bbb6e3dffde679471c9780","provenance":"primitive-derived","uncertainty":["Primitive matches provide syntactic evidence, not semantic certainty or proof of absence."]},"outcome":"returned=3","runId":"d9b626a4-a86e-4424-80af-368b9d9d9b1c","seq":2,"startedAt":"2026-11-17T15:15:08.361Z","endedAt":"2026-11-17T15:15:08.600Z","durationMs":239}}
