1-17T15:22:51.678Z","checks":{"typeChecking":true,"primitiveWhitelist":true,"callTracing":true,"reExecution":false},"notes":["Local technical validation only","No claims of semantic validation","No claims of exhaustiveness"]}},"contract":{"paramsSchema":[{"name":"symbol","type":"string"},{"name":"limit","type":"number | undefined"}],"returns":"{ file: string; line: number; text: string; }[]"},"source":"(params: {symbol: string, limit?: number}) => {\n  const limit = params.limit ?? 3;\n  const byId = searchIdentifiers(params.symbol).map(r => ({file: r.file, line: r.line, text: r.text || ''}));\n  const byText = searchText(params.symbol).map(r => ({file: r.file, line: r.line, text: r.text || ''}));\n  const seen = new Set<string>();\n  const out: {file: string, line: number, text: string}[] = [];\n  for (const r of [...byId, ...byText]) {\n    const key = r.file + ':' + r.line;\n    if (seen.has(key)) continue;\n    seen.add(key);\n    out.push(r);\n    if (out.length >= limit) break;\n  }\n  return out;\n}"},"result":{"result":[{"file":".tours/architecture_serveur_mcp.tour","line":12,"text":"      \"description\": \"Le serveur expose `create_project_tour` avec ses schémas d’entrée et de sortie. Son rappel transmet les arguments à `handleCreateProjectTour` à travers `safeToolCall`, qui transforme une exception inattendue en réponse structurée.\","},{"file":".tours/architecture_serveur_mcp.tour","line":18,"text":"      \"description\": \"`handleCreateProjectTour` commence par demander la validation de la proposition. Un rejet est renvoyé immédiatement ; une proposition acceptée fournit le contexte, les paramètres et les étapes utilisées par la suite.\\n\\nLe contenu détaillé des contrôles de validation n’est pas développé dans ce parcours.\","},{"file":"server.ts","line":699,"text":"    (args) => safeToolCall(args, (input) => handleCreateProjectTour(ctx, input))"},{"file":"server.ts","line":736,"text":"async function handleCreateProjectTour("}],"returned":4,"observed"