esponse(result.rejection);"},{"line":800,"text":"  }"},{"line":801,"text":"  const { ctx, params } = result.proposal;"},{"line":802,"text":""},{"line":803,"text":"  const baseRef = params.baseRef as string;"},{"line":804,"text":"  const headRef = params.headRef as string;"},{"line":805,"text":"  const includeUncommittedChanges = params.includeUncommittedChanges === true;"},{"line":806,"text":""},{"line":807,"text":"  // The Changes Tour depends on Git history and fails outside a repository."},{"line":808,"text":"  if (!(await isGitRepository(ctx))) {"},{"line":809,"text":"    return errorResponse("},{"line":810,"text":"      \"GIT_REPOSITORY_REQUIRED\","},{"line":811,"text":"      `create_changes_tour requires a Git repository, but the configured workspace root (${ctx.root}) is not inside one. ` +"},{"line":812,"text":"        \"Select a repository with workspacePath, or restart codetour-mcp in the repository to analyze (or pass it via --workspace-root), rather than its parent directory.\""},{"line":813,"text":"    );"},{"line":814,"text":"  }"},{"line":815,"text":""},{"line":816,"text":"  // The analyzed SHA must exactly match the current HEAD; otherwise the"},{"line":817,"text":"  // explanation might not correspond to the snapshot read again."},{"line":818,"text":"  const currentHead = await currentHeadSha(ctx);"},{"line":819,"text":"  if (currentHead === null) {"},{"line":820,"text":"    return errorResponse("},{"line":821,"text":"      \"STALE_HEAD\","},{"line":822,"text":"      \"The repository has no commits, so there is no HEAD to analyze.\""},{"line":823,"text":"    );"},{"line":824,"text":"  }"},{"line":825,"text":"  if (headRef !== currentHead) {"},{"line":826,"text":"    return errorResponse("},{"line":827,"text":"      \"STALE_HEAD\","},{"line":828,"text":"      `The provided headRef ${headRef} does not match the current HEAD (${currentHead}). The analysis is stale; re-run it against the current HEAD.`"},{"line":829,"text":"    );"},{"line":830,"text":"  }"},{"line":831,"text":""},{"line":832,"text":"  // Resolve the base reference to a full commit SHA up front: only a verified"},{"line":833,"text":"  // SHA is ever passed as a positional Git argument, so an agent-supplied"},{"line":834,"text":"  // string can never be interpreted as a Git option."},{"line":835,"text":"  const resolvedBaseSha = await resolveCommit(ctx, baseRef);"},{"line":836,"text":"  if (resolvedBaseSha === null) {"},{"line":837,"text":"    return errorResponse("},{"line":838,"text":"      \"INVALID_BASE_REF\","},{"line":839,"text":"      `Unable to resolve the base ref ${baseRef} to a commit in this repository.`"},{"line":840,"text":"    );"},{"line":841,"text":"  }"},{"line":842,"text":""},{"line":843,"text":"  let mergeBaseSha: string;"},{"line":844,"text":"  try {"},{"line":845,"text":"    mergeBaseSha = await mergeBase(ctx, resolvedBaseSha, headRef);"},{"line":846,"text":"  } catch (error) {"},{"line":847,"text":"    return errorResponse("},{"line":848,"text":"      \"INVALID_BASE_REF\","},{"line":849,"text":"      `Unable to compute the merge-base between ${baseRef} and ${headRef}: ${(error as Error).message}`"},{"line":850,"text":"    );"},{"line":851,"text":"  }"},{"line":852,"text":""},{"line":853,"text":"  // Without committed changes (and without included local work), return"},{"line":854,"text":"  // NO_CHANGES and preserve the previous Changes Tour: an empty tour never"},{"line":855,"text":"  // replaces a useful one."},{"line":856,"text":"  const uncommitted = await uncommittedChanges(ctx);"},{"line":857,"text":"  const includesLocalChanges = includeUncommittedChanges && uncommitted.length > 0;"},{"line":858,"text":"  const staged = await stageCommitAnchors(result.proposal, {"},{"line":859,"text":"    mergeBaseSha,"},{"line":860,"text":"    includesLocalChanges,"}],"inputTokens":null,"outputTokens":null,"usageMissing":false,"outcome":"returned=92","runId":"bbfb9188-fd16-47b4-ab07-b22f7b217335","seq":9,"startedAt":"2026-11-17T15:19: