const files = await changedFiles(ctx, mergeBaseSha, headRef);"},{"line":1035,"text":"  const prefix = normalizeSlashes(await workspacePrefix(ctx));"},{"line":1036,"text":"  return files"},{"line":1037,"text":"    .map(normalizeSlashes)"},{"line":1038,"text":"    .filter((file) => file.startsWith(prefix))"},{"line":1039,"text":"    .map((file) => file.slice(prefix.length));"},{"line":1040,"text":"}"},{"line":1041,"text":""},{"line":1042,"text":"// Default Changes Tour title: \"Changes on <branch>\", falling back to the short"},{"line":1043,"text":"// SHA when HEAD is detached."},{"line":1044,"text":"async function defaultChangesTitle("},{"line":1045,"text":"  ctx: WorkspaceContext,"},{"line":1046,"text":"  headRef: string"},{"line":1047,"text":"): Promise<string> {"},{"line":1048,"text":"  const branch = await currentBranchName(ctx);"},{"line":1049,"text":"  if (branch && branch !== \"HEAD\") {"},{"line":1050,"text":"    return `Changes on ${branch}`;"}],"nextLine":1051,"truncatedLines":[]},"returned":1,"observed":null,"truncated":false,"bounds":{"maxItems":50,"maxBytes":8000},"bytes":2673,"revision":"3e8f2aa7da11dd6d26bbb6e3dffde679471c9780","provenance":"primitive-derived","uncertainty":["Primitive matches provide syntactic evidence, not semantic certainty or proof of absence."],"note":"This exact call already returned the same result. Do not repeat it: change the query or parameters, use a different approach, or conclude with what you have and list the gaps as uncertainties."},"inputTokens":null,"outputTokens":null,"usageMissing":false,"outcome":"keys=result,returned,observed,truncated","runId":"b71919ce-02ba-4e90-a7e9-3419110301bb","seq":29,"startedAt":"2026-11-17T15:04:58.646Z","endedAt":"2026-11-17T15:04:58.877Z","durationMs":231}}
