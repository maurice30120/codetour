ise<ToolResponse> {"},{"line":740,"text":"  const result = await validateTourProposal(\"project\", args, defaultContext);"},{"line":741,"text":"  if (!result.ok) {"},{"line":742,"text":"    return errorResponse(result.rejection);"},{"line":743,"text":"  }"},{"line":744,"text":"  const { ctx, params, steps: finalSteps } = result.proposal;"},{"line":745,"text":""},{"line":746,"text":"  const warnings = ["},{"line":747,"text":"    ...stepLimitWarnings(finalSteps),"},{"line":748,"text":"    ...orientationStepWarnings(finalSteps),"},{"line":749,"text":"  ];"},{"line":750,"text":""},{"line":751,"text":"  // The title is computed before the dry-run branch so a rehearsal also"},{"line":752,"text":"  // returns the title that the persisted write would carry."},{"line":753,"text":"  const title = params.title ?? \"Project Overview\";"},{"line":754,"text":""},{"line":755,"text":"  // Rehearsal: the proposal is fully validated but never written, so an"},{"line":756,"text":"  // agent can verify its content before replacing the previous tour."},{"line":757,"text":"  if (params.dryRun === true) {"},{"line":758,"text":"    return validatedResponse("},{"line":759,"text":"      title,"},{"line":760,"text":"      finalSteps.length,"},{"line":761,"text":"      warnings,"},{"line":762,"text":"      `Validated Project Tour proposal with ${finalSteps.length} step(s); nothing was written (dryRun).`"},{"line":763,"text":"    );"},{"line":764,"text":"  }"},{"line":765,"text":""},{"line":766,"text":"  const tour: TourFile = {"},{"line":767,"text":"    $schema: CODETOUR_SCHEMA_URI,"},{"line":768,"text":"    title,"},{"line":769,"text":"    ...(params.description !== undefined ? { description: params.description } : {}),"},{"line":770,"text":"    steps: finalSteps,"},{"line":771,"text":"  };"},{"line":772,"text":""},{"line":773,"text":"  const targetPath = tourTargetPath(PROJECT_TOUR_PATH, params.fileName);"},{"line":774,"text":"  const writeFailure = await persistTour(ctx, targetPath, tour);"},{"line":775,"text":"  if (writeFailure) {"},{"line":776,"text":"    return writeFailure;"},{"line":777,"text":"  }"},{"line":778,"text":""},{"line":779,"text":"  return successResponse("},{"line":780,"text":"    normalizeSlashes(path.relative(defaultContext.root, path.join(ctx.root, targetPath))),"},{"line":781,"text":"    title,"},{"line":782,"text":"    finalSteps.length,"},{"line":783,"text":"    warnings,"},{"line":784,"text":"    `Created Project Tour at ${targetPath} with ${finalSteps.length} step(s).`"},{"line":785,"text":"  );"},{"line":786,"text":"}"},{"line":787,"text":""},{"line":788,"text":"// Create a Changes Tour: analyze committed changes from the merge-base of"},{"line":789,"text":"// `baseRef` to `headRef`. `headRef` must be the full SHA of the current HEAD;"},{"line":790,"text":"// otherwise generation fails with STALE_HEAD to avoid a stale explanation. By"},{"line":791,"text":"// default only committed changes are included; `includeUncommittedChanges`"},{"line":792,"text":"// enables explaining local work."},{"line":793,"text":"async function handleCreateChangesTour("},{"line":794,"text":"  defaultContext: WorkspaceContext,"},{"line":795,"text":"  args: unknown"},{"line":796,"text":"): Promise<ToolResponse> {"},{"line":797,"text":"  const result = await validateTourProposal(\"changes\", args, defaultContext);"},{"line":798,"text":"  if (!result.ok) {"},{"line":799,"text":"    return errorResponse(result.rejection);"},{"line":800,"text":"  }"},{"line":801,"text":"  const { ctx, params } = result.proposal;"},{"line":802,"text":""},{"line":803,"text":"  const baseRef = params.baseRef as string;"},{"line":804,"text":"  const headRef = params.headRef as string;"},{"line":805,"text":"  const includeUncommittedChanges = params.includeUncommittedChanges === true;"},{"line":806,"text":""},{"line":807,"text":"  // The Changes Tour depends on Git history and fails outside a repository."},{"line":808,"text":"  if (!(await isGitRepository(ctx))) {"},{"line":809,"text":"    return errorResponse("},{"line":810,"text":"      \"GIT_REPOSITORY_REQUIRED\","},{"line":811,"text":"      `create_changes_tour requires a Git repository, but the configured workspace root (${ctx.root}) is not inside one. ` +"},{"line":812,"text":"        \"Select a repository with workspacePath, or restart codetour-mcp in the repository to analyze (or pass it via --workspace-root), rather than its parent directory.\""},{"line":813,"text":"    );"},{"line":814,"text":"  }"},{"line":815,"text":""},{"line":816,"text":"  // The analyzed SHA must exactly match the current HEAD; otherwise the"},{"line":817,"text":"  // explanation might not correspond to the snapshot read again."},{"line":818,"text":"  const currentHead = await currentHeadSha(ctx);"},{"line":819,"text":"  if (currentHead === null) {"},{"line":820,"text":"    return errorResponse("}],"inputTokens":null,"outputTokens":null,"usageMissing":false,"outcome":"returned=91","runId":"bbfb9188-fd16-47b4-ab07-b22f7b217335","seq":5,"startedAt":"2026-11-17T15:19:14.220Z","endedAt":"2026-11-17T15:19:14.221Z","durationMs":1},{"type":"model","name":"model","maxOutputTokens":16384,"inputTokens":2469,"outputTokens":27,"usageMissing":false,"runId":"bbfb9188-fd16-47b4-ab07-b22f7b217335","seq":6,"startedAt":"2026-11-17T15:19:14.225Z","endedAt":"2026-11-17T15:19:16.708Z","durationMs":2483},{"type":"tool","name":"read","callId":"chatcmpl-tool-a6144567d3b27a35","parameters":{"endLine":900,"file":"server.ts","startLine":769},"result":{"error":"Invalid line range: 769-900"},"inputTokens":null,"outputTokens":null,"usageMissing":false,"outcome":"error","runId":"bbfb9188-fd16-47b4-ab07-b22f7b217335","seq":7,"startedAt":"2026-11-17T15:19:16.708Z","endedAt":"2026-11-17T15:19:16.708Z","durationMs":0},{"type":"model","name":"model","maxOutputTokens":16384,"inputTokens":2513,"outputTokens":28,"usageMissing":false,"runId":"bbfb9188-fd16-47b4-ab07-b22f7b217335","seq":8,"startedAt":"2026-11-17T15:19:16.711Z","endedAt":"2026-1