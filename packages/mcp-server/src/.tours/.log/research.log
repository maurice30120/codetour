        return { file, startLine, lines, truncated: false };\n      }\n    }\n    next = chunk[chunk.length - 1].line + 1;\n  }\n  return { file, startLine, lines, truncated: true };\n}","params":{"file":"string - path of the source file to read (e.g. \"server.ts\")","startLine":"number - line number of the function declaration to start from (e.g. 736)"}}},"usage":{"inputTokens":2044,"outputTokens":1489}},"model":{"model":"zai-glm-5-3-flash","temperature":0,"maxOutputTokens":16384}}
