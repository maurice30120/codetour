e\":68,\"text\":\"export async function validateTourProposal(\"},{\"line\":69,\"text\":\"  kind: TourProposalKind,\"},{\"line\":70,\"text\":\"  args: unknown,\"},{\"line\":71,\"text\":\"  defaultContext: WorkspaceContext\"},{\"line\":72,\"text\":\"): Promise<ProposalValidation<ProjectParams | ChangesParams>> {\"},{\"line\":73,\"text\":\"  const invalid = (issues: Issue[]): ProposalRejection => ({\"},{\"line\":74,\"text\":\"    status: \\\"error\\\",\"},{\"line\":75,\"text\":\"    code: \\\"INVALID_PROPOSAL\\\",\"},{\"line\":76,\"text\":\"    message: `The create_${kind}_tour arguments are invalid.`,\"},{\"line\":77,\"text\":\"    issues,\"},{\"line\":78,\"text\":\"  });\"},{\"line\":79,\"text\":\"  const { params, issues: paramIssues } =\"},{\"line\":80,\"text\":\"    kind === \\\"project\\\"\"},{\"line\":81,\"text\":\"      ? validateProjectParams(args)\"},{\"line\":82,\"text\":\"      : validateChangesParams(args);\"},{\"line\":83,\"text\":\"  const rawSteps = extractSteps(args);\"},{\"line\":84,\"text\":\"  const mermaidIssues = await validateMermaidDescriptions(args);\"},{\"line\":85,\"text\":\"  const selected = selectContext(defaultContext, params?.workspacePath);\"},{\"line\":86,\"text\":\"  const ctx = selected.context ?? defaultContext;\"}],\"nextLine\":87,\"truncatedLines\":[]},\"returned\":1,\"observed\":null,\"truncated\":false,\"bounds\":{\"maxItems\":50,\"maxBytes\":8000},\"bytes\":2664,\"revision\":\"3e8f2aa7da11dd6d26bbb6e3dffde679471c9780\",\"provenance\":\"primitive-derived\",\"uncertainty\":[\"Primitive matches provide syntactic evidence, not semantic certainty or proof of absence.\"]}"}],"options":{"maxOutputTokens":16384,"codeMode":true,"memory":true}}
