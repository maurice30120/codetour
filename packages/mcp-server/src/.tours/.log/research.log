ine":43,"text":"  try {"},{"line":44,"text":"    await handle.writeFile(content, \"utf8\");"},{"line":45,"text":"    await handle.sync();"},{"line":46,"text":"  } finally {"},{"line":47,"text":"    await handle.close();"},{"line":48,"text":"  }"},{"line":49,"text":"  try {"},{"line":50,"text":"    await fs.promises.rename(tempFile, realTarget);"},{"line":51,"text":"  } catch (error) {"},{"line":52,"text":"    await fs.promises.unlink(tempFile).catch(() => undefined);"},{"line":53,"text":"    throw error;"}],"nextLine":null,"truncatedLines":[]},"returned":1,"observed":null,"truncated":false,"bounds":{"maxItems":50,"maxBytes":8000},"bytes":2217,"revision":"3e8f2aa7da11dd6d26bbb6e3dffde679471c9780","provenance":"primitive-derived","uncertainty":["Primitive matches provide syntactic evidence, not semantic certainty or proof of absence."]},"inputTokens":null,"outputTokens":null,"usageMissing":false,"outcome":"keys=result,returned,observed,truncated","runId":"391d42e6-807a-4ab1-9de6-be9aa740b6b7","seq":2,"startedAt":"2026-11-17T15:08:17.501Z","endedAt":"2026-11-17T15:08:17.734Z","durationMs":233}}
