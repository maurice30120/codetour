{
  "name": "codetour-mcp",
  "version": "0.1.1",
  "description": "Local MCP server that deterministically validates and persists AI-generated CodeTour Project Tours and Changes Tours",
  "license": "MIT",
  "author": {
    "name": "Microsoft Corporation"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/microsoft/codetour",
    "directory": "packages/mcp-server"
  },
  "bin": {
    "codetour-mcp": "dist/src/main.js"
  },
  "main": "dist/src/server.js",
  "files": [
    "dist/src",
    "dist/node_modules/codetour-description-renderer",
    "dist/node_modules/codetour-relation-graph",
    "dist/package.json",
    "dist/schema.json",
    "schema.json",
    "review-skill",
    "README.md",
    "LICENSE.txt"
  ],
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json && node ../../scripts/stage-mcp-renderer.js && node ../../scripts/stage-mcp-relation-graph.js",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "prepack": "node ../../scripts/stage-mcp-renderer.js && node ../../scripts/stage-mcp-relation-graph.js",
    "test": "npm run build && node ../../scripts/run-compiled-tests.js dist/test",
    "start": "node dist/src/main.js"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.30.0",
    "@resvg/resvg-js": "2.6.2",
    "ajv": "^6.12.6",
    "codetour-description-renderer": "file:../description-renderer",
    "codetour-relation-graph": "file:../relation-graph",
    "jsdom": "26.1.0",
    "mermaid": "11.12.2",
    "safe-regex2": "^5.1.1",
    "tree-sitter-wasms": "0.1.13",
    "web-tree-sitter": "~0.25.10",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "typescript": "^5.8.0"
  }
}
