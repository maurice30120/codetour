{
  "name": "codetour-relation-graph",
  "version": "0.1.0",
  "description": "In-process Tree-sitter (WASM) relation graph engine with a pluggable per-language pack registry: pure (sources, language) -> graph, depth-1 BFS packets, extraction cache, explicit unsupported/ambiguous statuses",
  "license": "MIT",
  "author": {
    "name": "Microsoft Corporation"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/microsoft/codetour",
    "directory": "packages/relation-graph"
  },
  "main": "dist/src/index.js",
  "types": "dist/src/index.d.ts",
  "files": [
    "dist/src",
    "README.md",
    "LICENSE.txt"
  ],
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "npm run build && node ../../scripts/run-compiled-tests.js dist/test"
  },
  "dependencies": {
    "tree-sitter-wasms": "0.1.13",
    "web-tree-sitter": "~0.25.10"
  },
  "devDependencies": {
    "@types/node": "24.13.3",
    "typescript": "5.9.3"
  }
}
