#!/usr/bin/env python3
"""Capture des appels modèle que TE fait pour son propre compte (proposeur, juge)."""
import json, os, pathlib, subprocess, sys, time, uuid
p = pathlib.Path(os.environ["CAMPAIGN_DIR"]) / ("sidecall-" + str(uuid.uuid4()))
p.mkdir(mode=0o700)
(p / "args.json").write_text(json.dumps(sys.argv[1:], ensure_ascii=False, indent=2))
t = time.time()
r = subprocess.run(["/Users/dhuyet/.local/bin/pi", *sys.argv[1:]], capture_output=True)
(p / "stdout.jsonl").write_bytes(r.stdout)
(p / "stderr.txt").write_bytes(r.stderr)
(p / "result.json").write_text(json.dumps({"exit_code": r.returncode, "started": t, "seconds": time.time() - t}))
sys.stdout.buffer.write(r.stdout)
sys.stderr.buffer.write(r.stderr)
sys.exit(r.returncode)
