LSearchParams(query);"},{"line":74,"text":"      startTour(params);"},{"line":75,"text":"    } else {"},{"line":76,"text":"      startDefaultTour();"},{"line":77,"text":"    }"},{"line":78,"text":"  }"},{"line":79,"text":"}"},{"line":80,"text":""},{"line":81,"text":"export async function activate(context: vscode.ExtensionContext) {"},{"line":82,"text":"  registerDesktopIntegrations(context);"},{"line":83,"text":"  const notebookProvider = registerNotebookProvider();"},{"line":84,"text":"  if (notebookProvider) {"},{"line":85,"text":"    context.subscriptions.push(notebookProvider);"},{"line":86,"text":"  }"},{"line":87,"text":"  registerPlayerModule(context);"},{"line":88,"text":"  // Tour Step Conversations answer through the ACP session layer, launched"},{"line":89,"text":"  // in priority order with the tour's workspace root. Each session verifies"},{"line":90,"text":"  // its provider's configured mode before the first prompt."},{"line":91,"text":"  const stepChatResponder = createFallbackStepChatResponder();"},{"line":92,"text":"  setStepChatResponder(stepChatResponder);"},{"line":93,"text":"  context.subscriptions.push({"},{"line":94,"text":"    dispose: () => {"},{"line":95,"text":"      void stepChatResponder.dispose?.();"},{"line":96,"text":"    }"},{"line":97,"text":"  });"},{"line":98,"text":"  registerRecorderModule();"}],"nextLine":99,"truncatedLines":[]},"returned":1,"observed":null,"truncated":false,"bounds":{"maxItems":50,"maxBytes":8000},"bytes":2654,"revision":"3e8f2aa7da11dd6d26bbb6e3dffde679471c9780","provenance":"primitive-derived","uncertainty":["Primitive matches provide syntactic evidence, not semantic certainty or proof of absence."]},"inputTokens":null,"outputTokens":null,"usageMissing":false,"outcome":"keys=result,returned,observed,truncated","runId":"9f667f00-9b95-4b74-ac94-27f6c19ca906","seq":11,"startedAt":"2026-11-17T15:03:51.233Z","endedAt":"2026-11-17T15:03:51.443Z","durationMs":210},{"type":"model","name":"model","maxOutputTokens":1