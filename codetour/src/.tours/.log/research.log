\";\"},{\"line\":20,\"text\":\"import { registerDesktopIntegrations } from \\\"./desktopIntegration\\\";\"},{\"line\":21,\"text\":\"\"},{\"line\":22,\"text\":\"/**\"},{\"line\":23,\"text\":\" * Partage la découverte des visites entre l'ouverture normale du projet et\"},{\"line\":24,\"text\":\" * l'ouverture via un lien CodeTour. Une seule lecture des fichiers est ainsi\"},{\"line\":25,\"text\":\" * nécessaire avant d'afficher la visite demandée à l'utilisateur.\"},{\"line\":26,\"text\":\" */\"},{\"line\":27,\"text\":\"let cachedDiscoverTours: Promise<void> | undefined;\"},{\"line\":28,\"text\":\"function discoverTours(): Promise<void> {\"},{\"line\":29,\"text\":\"  return cachedDiscoverTours ?? (cachedDiscoverTours = _discoverTours());\"},{\"line\":30,\"text\":\"}\"},{\"line\":31,\"text\":\"\"},{\"line\":32,\"text\":\"function startTour(params: URLSearchParams) {\"},{\"line\":33,\"text\":\"  let tourPath = params.get(\\\"tour\\\");\"},{\"line\":34,\"text\":\"  const step = params.get(\\\"step\\\");\"},{\"line\":35,\"text\":\"\"},{\"line\":36,\"text\":\"  let stepNumber;\"},{\"line\":37,\"text\":\"  if (step) {\"},{\"line\":38,\"text\":\"    // In public links, the first step is numbered 1; the internal player\"},{\"line\":39,\"text\":\"    // uses a zero-based index.\"},{\"line\":40,\"text\":\"    stepNumber = Number(step) - 1;\"},{\"line\":41,\"text\":\"  }\"},{\"line\":42,\"text\":\"\"},{\"line\":43,\"text\":\"  if (tourPath) {\"},{\"line\":44,\"text\":\"    if (!tourPath.endsWith(\\\".tour\\\")) {\"},{\"line\":45,\"text\":\"      tourPath = `${tourPath}.tour`;\"},{\"line\":46,\"text\":\"    }\"},{\"line\":47,\"text\":\"\"}],\"nextLine\":48,\"truncatedLines\":[]},\"returned\":1,\"observed\":null,\"truncated\":false,\"bounds\":{\"maxItems\":50,\"maxBytes\":8000},\"bytes\":2689,\"revision\":\"3e8f2aa7da11dd6d26bbb6e3dffde679471c9780\",\"provenance\":\"primitive-derived\",\"uncertainty\":[\"Primitive matches provide syntactic evidence, not semantic certainty or proof