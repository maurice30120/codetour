"nextLine":null,"truncatedLines":[]},"returned":1,"observed":null,"truncated":false,"bounds":{"maxItems":50,"maxBytes":8000},"bytes":1712,"revision":"3e8f2aa7da11dd6d26bbb6e3dffde679471c9780","provenance":"primitive-derived","uncertainty":["Primitive matches provide syntactic evidence, not semantic certainty or proof of absence."]},"inputTokens":null,"outputTokens":null,"usageMissing":false,"outcome":"keys=result,returned,observed,truncated","runId":"0ecd75e4-f1e4-41d0-b34e-fec662f41a65","seq":5,"startedAt":"2026-11-17T15:10:37.475Z","endedAt":"2026-11-17T15:10:37.707Z","durationMs":232}}
