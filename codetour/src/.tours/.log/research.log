"text":"      }, customDirectory)"},{"line":47,"text":"    )"},{"line":48,"text":"  );"},{"line":49,"text":""},{"line":50,"text":"  runInAction(() => {"},{"line":51,"text":"    store.tours = visibleTours(tours.flat(), TOUR_CONTEXT);"},{"line":52,"text":""},{"line":53,"text":"    if (store.activeTour) {"},{"line":54,"text":"      const tour = store.tours.find(tour => tour.id === store.activeTour!.tour.id);"},{"line":55,"text":""},{"line":56,"text":"      if (tour) {"},{"line":57,"text":"        if (!comparer.structural(store.activeTour.tour, tour)) {"},{"line":58,"text":"          // Reload without interrupting the current reading session."},{"line":59,"text":"          set(store.activeTour.tour, tour);"},{"line":60,"text":"        }"},{"line":61,"text":"      } else {"},{"line":62,"text":"        endCurrentCodeTour();"},{"line":63,"text":"      }"},{"line":64,"text":"    }"},{"line":65,"text":"  });"},{"line":66,"text":""},{"line":67,"text":"  vscode.commands.executeCommand(\"setContext\", HAS_TOURS_KEY, store.hasTours);"},{"line":68,"text":"  updateMarkerTitles();"}],"nextLine":null,"truncatedLines":[]},"returned":1,"observed":null,"truncated":false,"bounds":{"maxItems":50,"maxBytes":8000},"bytes":2280,"revision":"3e8f2aa7da11dd6d26bbb6e3dffde679471c9780","provenance":"primitive-derived","uncertainty":["Primitive matches provide syntactic evidence, not semantic certainty or proof of absence."]},"inputTokens":null,"outputTokens":null,"usageMissing":false,"outcome":"keys=result,returned,observed,truncated","runId":"e12d9b47-4473-4864-81ee-3570b514bc71","seq":2,"startedAt":"2026-11-17T15:07:29.766Z","endedAt":"2026-11-17T15:07:30.004Z","durationMs":238},{"type":"model","name":"model","maxOutputTokens":16384,"inputTokens":3392,"outputTokens":722,"usageMissing":false,"runId":"e12d9b47-4473-4864-81ee-3570b514bc71","seq":3,"startedAt":"2026-11-17T15:07:30.006Z","endedAt":"2026-11-17T15:07:33.466Z","durationMs":3460},{"type":"model","name":"memory-synthesis","inputTokens":