ct line range and text, the import statements with source modules, and local helper definitions (e.g. discoverTours, URIHandler, startTour) with their line ranges. Limits: syntactic evidence only; it does not follow definitions into other files, does not resolve method calls on objects, and helper search is capped by maxHelpers.\",\"source\":\"async ({ file, functionName, bodyPadding = 5, maxHelpers = 8 }: { file: string; functionName: string; bodyPadding?: number; maxHelpers?: number }) => {\\n  const hits = await searchIdentifiers({ identifier: functionName });\\n  const defHit = (hits.result || []).find(\\n    (h: any) => h.file === file && new RegExp(\\\"(function\\\\\\\\s+|const\\\\\\\\s+)\\\" + functionName + \\\"\\\\\\\\b\\\").test(h.text)\\n  );\\n  if (!defHit) {\\n    return { error: \\\"definition of \\\" + functionName + \\\" not found in \\\" + file, searched: hits.result || [] };\\n  }\\n  const startLine = defHit.line;\\n  const scan = await readLines({ file, startLine, endLine: startLine + 400 });\\n  const lines: any[] = scan.result.lines || [];\\n  let depth = 0;\\n  let seenOpen = false;\\n  let endLine = startLine;\\n  for (const l of lines) {\\n    for (const ch of l.text) {\\n      if (ch === \\\"{\\\") { depth++; seenOpen = true; }\\n      else if (ch === \\\"}\\\") { depth--; }\\n    }\\n    endLine = l.line;\\n    if (seenOpen && depth <= 0) { break; }\\n  }\\n  const body = await readLines({ file, startLine: Math.max(1, startLine - bodyPadding), endLine: endLine + bodyPadding });\\n  const imports = await getImports({ file });\\n  const bodyText = lines.map((l: any) => l.text).join(\\\"\\\\n\\\");\\n  const identifiers = Array.from(\\n    new Set(\\n      (bodyText.match(/[A-Za-z_$][A-Za-z0-9_$]*/g) || []).filter(\\n        (id: string) => id !== functionName && !/^(if|else|for|while|return|const|let|var|new|await|async|function|class|import|export|from|typeof|void|true|false|null|undefined|this|try|catch|throw)$/.test(id)\\n      )\\n    )\\n  );\\n  const localHelpers: any[] = [];\\n  for (const id of identifiers) {\\n    if (localHelpers.length >= maxHelpers) { break; }\\n    const idHits = await searchIdentifiers({ identifier: id });\\n    const localDefs = (idHits.result || []).filter(\\n      (h: any) => h.file === file && h.line < startLine && new RegExp(\\\"(function\\\\\\\\s+|class\\\\\\\\s+|const\\\\\\\\s+)\\\" + id + \\\"\\\\\\\\b\\\").test(h.text)\\n    );\\n    if (localDefs.length === 0) { continue; }\\n    const defLine = localDefs[0].line;\\n    const helperScan = await readLines({ file, startLine: defLine, endLine: defLine + 60 });\\n    const helperLines: any[] = helperScan.result.lines || [];\\n    let hDepth = 0;\\n    let hOpen = false;\\n    let hEnd = defLine;\\n    for (const l of helperLines) {\\n      for (const ch of l.text) {\\n        if (ch === \\\"{\\\") { hDepth++; hOpen = true; }\\n        else if (ch === \\\"}\\\") { hDepth--; }\\n      }\\n      hEnd = l.line;\\n      if (hOpen && hDepth <= 0) { break; }\\n    }\\n    localHelpers.push({ name: id, startLine: defLine, endLine: hEnd, definitionText: helperLines.map((l: any) => l.text).join(\\\"\\\\n\\\") });\\n  }\\n  return {\\n    file,\\n    functionName,\\n    definition: { startLine, endLine, text: lines.map((l: any) => l.line + \\\": \\\" + l.text).join(\\\"\\\\n\\\") },\\n    contextWithPadding: body.result,\\n    imports: imports.result,\\n    localHelpers\\n  };\\n}\",\"params\":{\"file\":\"string — target source file, e.g. extension.ts\",\"functionName\":\"string — exported function to trace, e.g. activate\",\"bodyPadding\":\"optional number — extra context lines read before/after the body (default 5)\",\"maxHelpers\":\"optional number — cap on local helper definitions resolved (default 8)\"}},\"error\":\"Description is too long: 770 characters; at most 300 are allowed.\"}]}"}],"options":{"maxOutputTokens":16384,"codeMode":false,"memory":false,"toolsEnabled":false}}
