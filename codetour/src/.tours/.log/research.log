Tours: Promise<void> | undefined;"},{"line":28,"text":"function discoverTours(): Promise<void> {"},{"line":29,"text":"  return cachedDiscoverTours ?? (cachedDiscoverTours = _discoverTours());"},{"line":30,"text":"}"},{"line":31,"text":""},{"line":32,"text":"function startTour(params: URLSearchParams) {"},{"line":33,"text":"  let tourPath = params.get(\"tour\");"},{"line":34,"text":"  const step = params.get(\"step\");"},{"line":35,"text":""},{"line":36,"text":"  let stepNumber;"},{"line":37,"text":"  if (step) {"},{"line":38,"text":"    // In public links, the first step is numbered 1; the internal player"},{"line":39,"text":"    // uses a zero-based index."},{"line":40,"text":"    stepNumber = Number(step) - 1;"},{"line":41,"text":"  }"},{"line":42,"text":""},{"line":43,"text":"  if (tourPath) {"},{"line":44,"text":"    if (!tourPath.endsWith(\".tour\")) {"},{"line":45,"text":"      tourPath = `${tourPath}.tour`;"},{"line":46,"text":"    }"},{"line":47,"text":""}],"nextLine":48,"truncatedLines":[]},"returned":1,"observed":null,"truncated":false,"bounds":{"maxItems":50,"maxBytes":8000},"bytes":2689,"revision":"3e8f2aa7da11dd6d26bbb6e3dffde679471c9780","provenance":"primitive-derived","uncertainty":["Primitive matches provide syntactic evidence, not semantic certainty or proof of absence."]},"inputTokens":null,"outputTokens":null,"usageMissing":false,"outcome":"keys=result,returned,observed,truncated","runId":"9f667f00-9b95-4b74-ac94-27f6c19ca906","seq":9,"startedAt":"2026-11-17T15:03:49.610Z","endedAt":"2026-11-17T15:03:49.832Z","durationMs":222}}
